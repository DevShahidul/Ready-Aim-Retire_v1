---
const { blog, serial, blogPage } = Astro.props;
---

<div class="blog-card-wrapper">
    <div class={`blog-card ${serial === 1 ? "active" : ""}`}>
        <div class="blog-card-main">
            <div class="blog-card-image-wrapper">
                <img
                    src={blogPage ? blog.blogImg : blog.img}
                    alt={blog.title}
                    class="blog-card-image"
                />
                <div class="blog-card-overlay">
                    <h3 class="blog-card-title-overlay">
                        {blog.title?.slice(0, 37)}
                    </h3>
                </div>
            </div>

            <div class="blog-card-content">
                <h3 class="blog-card-title">{blog.title}</h3>
                <p class="blog-card-description">{blog.description}</p>
            </div>
        </div>

        <div class="blog-card-footer">
            <a href="#" class="blog-card-link">Read More</a>
            <span class="blog-card-date">{blog.date}</span>
        </div>
    </div>
</div>
<style>
    .blog-card-wrapper {
        position: relative;
    }

    .blog-card-wrapper::after {
        content: "";
        display: block;
        width: 1px;
        height: 100%;
        background-color: #d1d1d1;
        position: absolute;
        right: -2rem;
        top: 0;
    }

    .blog-card-wrapper:nth-child(4n)::after {
        display: none;
    }

    .blog-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        display: flex;
        flex-direction: column;
        height: 100%;
        transition: all 0.3s ease;
        min-height: 31.25rem;
    }

    .blog-card:hover {
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        transform: translateY(-0.25rem);
    }

    .blog-card:hover,
    .blog-card.active {
        .blog-card-footer {
            display: none;
        }
    }

    .blog-card-main {
        position: relative;
        flex: 1;
        min-height: 18.75rem;
    }

    /* Image wrapper - hidden by default */
    .blog-card-image-wrapper {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        opacity: 0;
        transition: opacity 0.4s ease;
        z-index: 1;
    }

    .blog-card:hover .blog-card-image-wrapper,
    .blog-card.active .blog-card-image-wrapper {
        opacity: 1;
    }

    .blog-card-image {
        width: 100%;
        height: 50%;
        object-fit: cover;
        display: block;
        transition: transform 0.4s ease;
        position: absolute;
        bottom: 0;
    }

    .blog-card:hover .blog-card-image {
        transform: scale(1.05);
    }

    /* Overlay on image */
    .blog-card-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        background: rgba(74, 95, 127);
        padding: 1.5rem;
        z-index: 2;
        min-height: 50%;
    }

    .blog-card-title-overlay {
        color: white;
        max-width: 18.75rem;
        font-size: 1.526rem;
        font-weight: 500;
        margin: 0;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Text content - visible by default */
    .blog-card-content {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        opacity: 1;
        transition: opacity 0.4s ease;
        position: relative;
        z-index: 0;
    }

    .blog-card:hover .blog-card-content {
        opacity: 0;
    }

    .blog-card-title {
        font-size: 1.526rem;
        font-weight: 500;
        max-width: 18.75rem;
        color: #0e3f4a;
        margin: 0;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .blog-card-description {
        font-size: 0.9375rem;
        color: #0e3f4a;
        line-height: 1.6;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 6;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-top: 1.25rem;
    }

    /* Footer */
    .blog-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem;
        background: white;
        position: relative;
        z-index: 3;
    }

    .blog-card-link {
        color: #0e3f4a;
        text-decoration: underline;
        text-underline-offset: 0.3125rem;
        text-decoration-color: #d1d1d1;
        font-weight: 400;
        font-size: 0.9375rem;
        transition: color 0.3s ease;
    }

    .blog-card-date {
        color: #95a5a6;
        font-size: 0.875rem;
    }

    @media (max-width: 1024px) {
        .blog-card-wrapper:nth-child(2n)::after {
            display: none;
        }
    }

    @media (max-width: 768px) {
        .blog-card-wrapper::after {
            right: -0.7rem;
        }
        .blog-card-main {
            min-height: 15.625rem;
        }

        .blog-card {
            min-height: auto;
        }

        .blog-card-title,
        .blog-card-title-overlay {
            font-size: 1rem;
        }

        .blog-card-description {
            font-size: 0.875rem;
            -webkit-line-clamp: 4;
        }

        .blog-card-overlay,
        .blog-card-content,
        .blog-card-footer {
            padding: 1.25rem;
        }
    }

    /*@media (max-width: 475px) {
        .blog-card-wrapper::before {
            content: "";
            position: absolute;
            display: block;
            width: 100%;
            height: 1px;
            background-color: #d1d1d1;
            right: 0;
            bottom: -0.625rem;
        }
        .blog-card-wrapper:last-of-type::before {
            display: none;
        }
    }*/
</style>
