<script>
    // Self-contained animation player
    document.querySelectorAll('.animation-player').forEach(player => {
        const config = JSON.parse(player.dataset.animationConfig);
        const canvas = player.querySelector('.animation-canvas');
        const ctx = canvas.getContext('2d');
        const overlay = player.querySelector('.slider-overlay');
        const slider = player.querySelector('.slider-control');
        const valueInput = player.querySelector('.slider-value');
        const handIcon = player.querySelector('.hand-icon');

        let images = [];
        let index = 0;
        let direction = 1;
        let playing = true;
        let userControlling = false;
        let lastTime = 0;

        // Format value for display
        function formatValue(value) {
            if (config.isMonetary && Math.abs(value) >= 1000) {
                return '$' + value.toLocaleString('en-US');
            }
            return value.toString();
        }

        // Update hand icon position
        function updateHandPosition() {
            const sliderRect = slider.getBoundingClientRect();
            const overlayRect = overlay.getBoundingClientRect();
            const min = parseFloat(slider.min);
            const max = parseFloat(slider.max);
            const val = parseFloat(slider.value);
            const percent = (val - min) / (max - min);
            const thumbWidth = 14;
            const trackWidth = sliderRect.width - thumbWidth;
            const thumbX = thumbWidth / 2 + percent * trackWidth;
            const sliderLeft = sliderRect.left - overlayRect.left;
            handIcon.style.left = (sliderLeft + thumbX) + 'px';
            handIcon.style.top = (sliderRect.top - overlayRect.top + 25) + 'px';
        }

        // Draw current frame
        function drawFrame() {
            if (images.length === 0) return;
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.drawImage(images[index], 0, 0);
        }

        // Update slider to match frame
        function updateSlider() {
            const value = config.frameValues[index];
            slider.value = value;
            valueInput.value = formatValue(value);
            updateHandPosition();
        }

        // Find frame for value
        function findFrameForValue(value) {
            let closestIdx = 0;
            let closestDiff = Math.abs(config.frameValues[0] - value);
            for (let i = 1; i < config.frameValues.length; i++) {
                const diff = Math.abs(config.frameValues[i] - value);
                if (diff < closestDiff) {
                    closestDiff = diff;
                    closestIdx = i;
                }
            }
            return closestIdx;
        }

        // Animation loop
        function loop(time) {
            if (playing && images.length > 0 && !userControlling) {
                const interval = 1000 / config.fps;
                if (time - lastTime >= interval) {
                    lastTime = time;
                    drawFrame();
                    updateSlider();
                    index += direction;
                    if (index >= images.length - 1) direction = -1;
                    if (index <= 0) direction = 1;
                }
            }
            requestAnimationFrame(loop);
        }

        // Slider interaction
        slider.addEventListener('mousedown', () => {
            userControlling = true;
            playing = false;
        });

        slider.addEventListener('input', () => {
            const value = parseFloat(slider.value);
            index = findFrameForValue(value);
            drawFrame();
            valueInput.value = formatValue(value);
            updateHandPosition();
        });

        // Load images
        let loaded = 0;
        config.imageUrls.forEach((url, i) => {
            const img = new Image();
            img.onload = () => {
                loaded++;
                if (loaded === config.imageUrls.length) {
                    // All loaded - set canvas size and start
                    canvas.width = images[0].naturalWidth;
                    canvas.height = images[0].naturalHeight;
                    drawFrame();
                    updateSlider();
                    requestAnimationFrame(loop);
                }
            };
            img.src = url;
            images[i] = img;
        });
    });
</script>
