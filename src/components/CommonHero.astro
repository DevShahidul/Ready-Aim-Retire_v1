---
type Props = {
    title: string;
    isLarge?: boolean;
};
const { title, isLarge }: Props = Astro.props;
---

<section class={`common-hero container`}>
    <h2 class={`${!isLarge ? "limited-width" : ""}`}>{title}</h2>
</section>

<style>
    .common-hero {
        margin-top: 15.125rem;
        h2 {
            font-size: 4.6rem;
            line-height: 5.3215rem;
            font-family: var(--font-playfair);
            font-weight: 400;
            margin-bottom: 1.8rem;
            color: #2e2e2e;
        }
    }

    .limited-width {
        max-width: 57rem;
    }

    @media (max-width: 1024px) {
        .common-hero {
            margin-top: 12rem;
            h2 {
                font-size: 4rem;
                line-height: 4.25rem;
            }
        }
    }

    @media (min-width: 768px) and (max-width: 1024px) {
        .common-hero {
            margin-top: 11rem;
            h2 {
                font-size: 3.75rem;
                line-height: 4rem;
                margin-bottom: 0;
            }
        }
    }

    @media (max-width: 768px) {
        .common-hero {
            margin-top: 8rem;
            h2 {
                font-size: 3rem;
                line-height: 3.2rem;
            }
        }
    }

    @media (max-width: 480px) {
        .common-hero {
            margin-top: 6rem;
            h2 {
                font-size: 2.5rem;
                line-height: 2.75rem;
            }
        }
    }

    @media (max-width: 390px) {
        .common-hero {
            margin-top: 5rem;
            h2 {
                font-size: 2rem;
                line-height: 2.25rem;
            }
        }
    }

    @media (max-width: 320px) {
        .common-hero {
            margin-top: 5rem;
            h2 {
                font-size: 1.75rem;
                line-height: 2rem;
            }
        }
    }
</style>
