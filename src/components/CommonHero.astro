</section>

<style>
    .common-hero {
        margin-top: 15.125rem;
        h2 {
            font-size: 5rem;
            line-height: 5.3215rem;
            font-family: "Tobias", sans-serif;
            margin-bottom: 1.5rem;
        }
    }
</style>
