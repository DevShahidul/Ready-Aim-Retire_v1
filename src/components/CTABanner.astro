---
// CTA Banner - "Take aim at your retirement with OnTarget™"
// Appears above the footer on most pages

interface Props {
    headline?: string;
    description?: string;
    buttonText?: string;
    buttonLink?: string;
}

const {
    headline = "Take aim at your retirement with OnTarget™",
    description = "Sign up today and start building the financial plan you deserve. It's free to get started!",
    buttonText = "Get Started",
    buttonLink = `${import.meta.env.PUBLIC_APP_URL}/signup`,
} = Astro.props;
---

<section class="cta-banner">
    <div class="cta-container">
        <h2 set:html={headline.replace("OnTarget™", "OnTarget<sup>™</sup>")} />
        <div class="cta-right">
            <p>{description}</p>
            <a href={buttonLink} class="cta-button">
                {buttonText}
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </a>
        </div>
    </div>
</section>

<style>
    .cta-banner {
        background-color: var(--color-secondary);
        padding: 3rem 0;
    }

    .cta-container {
        max-width: 1836px;
        padding: 0 20px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 3rem;
    }

    .cta-banner h2 {
        margin: 0;
        font-family: "Tobias", Georgia, serif;
        font-size: clamp(2rem, 4vw, 3.75rem);
        font-weight: 400;
        color: #ffffff;
        line-height: 1.2;
        max-width: 750px;
    }

    .cta-banner h2 :global(sup) {
        font-size: 0.5em;
        vertical-align: super;
    }

    .cta-right {
        text-align: left;
        max-width: 320px;
    }

    .cta-right p {
        margin: 0 0 1.25rem 0;
        color: #94a3b8;
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .cta-button {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background-color: var(--color-primary);
        color: var(--color-text-light);
        padding: 0.5rem 1.5rem;
        font-size: 0.9rem;
        font-weight: 500;
        border-radius: 6px;
        text-decoration: none;
        transition:
            background-color 0.2s ease,
            transform 0.2s ease;
        white-space: nowrap;
    }

    .cta-button:hover {
        background-color: var(--color-primary-hover);
        transform: translateY(-1px);
    }

    .cta-button svg {
        transition: transform 0.2s ease;
    }

    .cta-button:hover svg {
        transform: translateX(3px);
    }

    @media (max-width: 768px) {
        .cta-banner {
            padding: 3rem 1.5rem;
        }

        .cta-container {
            flex-direction: column;
            gap: 2rem;
        }

        .cta-right {
            text-align: left;
            max-width: none;
        }
    }
</style>
