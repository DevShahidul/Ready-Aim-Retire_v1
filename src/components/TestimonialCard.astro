---
interface Props {
    id: number;
    name: string;
    date: string;
    quote: string;
    sourceImage?: string;
    sourceType?: "email" | "reddit" | "review" | "other";
}

const {
    id,
    name,
    date,
    quote,
    sourceImage,
    sourceType = "email",
} = Astro.props;

// Generate initials for avatar
const initials = name.charAt(0).toUpperCase();

// Generate a consistent color based on the name
const colors = [
    "#3b7eff",
    "#14b8a6",
    "#8b5cf6",
    "#f59e0b",
    "#ef4444",
    "#10b981",
    "#6366f1",
    "#ec4899",
];
const colorIndex =
    name.split("").reduce((acc, char) => acc + char.charCodeAt(0), 0) %
    colors.length;
const avatarColor = colors[colorIndex];
---

<div
    class="testimonial-card-v2"
    data-testimonial-id={id}
    data-aos="fade-up"
    data-original-aos="fade-up"
>
    <p class="quote">{quote}</p>
    <div class="card-footer">
        <div class="author">
            <div
                class="avatar-initials"
                style={`background-color: ${avatarColor}`}
            >
                {initials}
            </div>
            <div class="author-info">
                <div class="name">{name}</div>
                <div class="date">{date}</div>
            </div>
        </div>
        <!-- {sourceImage && (
            <button
                class="view-source-btn"
                data-source-image={`/images/reviews/${sourceImage}`}
                data-source-type={sourceType}
                data-testimonial-name={name}
                aria-label="View original testimonial"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
                View Source
            </button>
        )} -->
    </div>
</div>

<style>
    .testimonial-card .testimonial-card-v2 {
        background: #ffffff;
        border-radius: 12px;
        padding: 2.375rem;
        margin-bottom: 1.5rem;
        break-inside: avoid;
        display: flex;
        flex-direction: column;
    }

    .testimonial-card-v2 .quote {
        font-size: 1.0625rem;
        line-height: 24px;
        color: #0e3f4a;
        margin: 0 0 1.25rem 0;
    }

    .card-footer {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1rem;
        margin-top: auto;
    }

    .testimonial-card-v2 .author {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .avatar-initials {
        width: 3.875rem;
        height: 3.875rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        font-weight: 600;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .testimonial-card-v2 .author-info .name {
        font-weight: 500;
        font-size: 1.0625rem;
        color: #0e3f4a;
    }

    .testimonial-card-v2 .author-info .date {
        font-size: 0.75rem;
        color: #898d8e;
    }

    .view-source-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: none;
        border: 1px solid #e0e0e0;
        border-radius: 6px;
        padding: 0.4rem 0.75rem;
        font-size: 0.75rem;
        color: #666;
        cursor: pointer;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .view-source-btn:hover {
        background: #f5f5f5;
        border-color: #ccc;
        color: #333;
    }

    .view-source-btn svg {
        flex-shrink: 0;
    }

    @media (max-width: 480px) {
        .card-footer {
            flex-direction: column;
            align-items: center;
        }

        .view-source-btn {
            margin-top: 0.75rem;
        }
        .load-more-container {
            margin-top: 0.5rem;
        }
    }
</style>
