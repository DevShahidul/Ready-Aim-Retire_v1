---
import TestimonialCard from "./TestimonialCard.astro";
import SourceModal from "./SourceModal.astro";
import testimonialData from "../data/testimonials.json";

interface Props {
    /** Number of testimonials to display. Defaults to all. */
    limit?: number;
    /** Number to show initially before "Load more". Defaults to all rendered. */
    initialShow?: number;
    /** Show the section header */
    showHeader?: boolean;
    /** Custom heading text */
    heading?: string;
    /** Layout style: 'masonry' or 'grid' */
    layout?: "masonry" | "grid";
}

const {
    limit,
    initialShow,
    showHeader = true,
    heading = "Success stories from our users and see how OnTarget transforms their planning.",
    layout = "masonry",
} = Astro.props;

// Get testimonials, optionally limiting the count
const testimonials = limit
    ? testimonialData.testimonials.slice(0, limit)
    : testimonialData.testimonials;

const hasLoadMore = initialShow && initialShow < testimonials.length;
---

<section class="testimonials-section">
    <div class="container">
        {
            showHeader && (
                <div class="testimonials-header" data-aos="fade-up">
                    <h2>{heading}</h2>
                    <a
                        href={`${import.meta.env.PUBLIC_APP_URL}/signup`}
                        class="btn btn-dark"
                    >
                        Try for free{" "}
                        <span class="arrow">
                            <i class="fa-solid fa-arrow-right" />
                        </span>
                    </a>
                </div>
            )
        }
        <div
            class={`testimonials-${layout}`}
            data-aos="fade-up"
            data-aos-delay="100"
            data-initial-show={initialShow}
        >
            {
                testimonials.map((testimonial, i) => (
                    <div
                        class:list={[
                            "testimonial-wrapper",
                            {
                                "testimonial-hidden":
                                    hasLoadMore && i >= initialShow,
                            },
                        ]}
                    >
                        <TestimonialCard
                            id={testimonial.id}
                            name={testimonial.name}
                            date={testimonial.date}
                            quote={testimonial.quote}
                            sourceImage={testimonial.sourceImage}
                            sourceType={
                                testimonial.sourceType as
                                    | "email"
                                    | "reddit"
                                    | "review"
                                    | "other"
                            }
                        />
                    </div>
                ))
            }
        </div>
        {
            hasLoadMore && (
                <div class="load-more-container">
                    <a
                        href="#"
                        class="load-more-link"
                        id="load-more-testimonials"
                    >
                        Load more
                    </a>
                </div>
            )
        }
    </div>
</section>

<!-- Modal for viewing source images - included once -->
<SourceModal />

<style>
    .testimonials-section {
        background: #f6f6f4;
        padding: 5rem 0;
        border-bottom: 1px solid #d1d1d1;
    }

    .testimonials-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 2.5rem;
        gap: 2rem;
        flex-wrap: wrap;
    }

    .testimonials-header h2 {
        font-size: clamp(1.75rem, 4vw, 2.8125rem);
        font-weight: 500;
        color: #1a1a2e;
        margin: 0;
        max-width: 650px;
        line-height: 1.3;
    }

    /* Masonry layout - 3 columns */
    .testimonials-masonry {
        column-count: 3;
        column-gap: 1.5rem;
    }

    /* Grid layout - uniform cards */
    .testimonials-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }

    /* Responsive: Tablet */
    @media (max-width: 1024px) {
        .testimonials-masonry {
            column-count: 2;
        }

        .testimonials-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .testimonial-wrapper {
        break-inside: avoid;
    }

    .testimonial-hidden {
        display: none;
    }

    .load-more-container {
        text-align: center;
        margin-top: 2.5rem;
    }

    .load-more-link {
        color: #1a1a2e;
        font-weight: 600;
        font-size: 1rem;
        text-decoration: none;
        border-bottom: 2px solid #1a1a2e;
        padding-bottom: 2px;
        transition: opacity 0.2s;
    }

    .load-more-link:hover {
        opacity: 0.7;
    }

    @media (max-width: 1024px) {
        .testimonials-section {
            padding: 3rem 0;
        }
    }

    /* Responsive: Mobile */
    @media (max-width: 600px) {
        .testimonials-section {
            padding: 2rem 0;
        }

        .testimonials-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .testimonials-masonry {
            column-count: 1;
        }

        .testimonials-grid {
            grid-template-columns: 1fr;
        }
        .load-more-container {
            margin-top: 0.5rem;
        }
    }
</style>

<script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
        var btn = document.getElementById("load-more-testimonials");
        if (!btn) return;
        btn.addEventListener("click", function (e) {
            e.preventDefault();
            var hidden = document.querySelectorAll(".testimonial-hidden");
            hidden.forEach(function (el) {
                el.classList.remove("testimonial-hidden");
            });
            btn.parentElement.remove();
        });
    });
</script>
