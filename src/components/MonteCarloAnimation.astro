<script>
    // Self-contained animation player
    document.querySelectorAll('.animation-player').forEach(player => {
        const config = JSON.parse(player.dataset.animationConfig);
        const canvas = player.querySelector('.animation-canvas');
        const ctx = canvas.getContext('2d');
        const overlay = player.querySelector('.slider-overlay');
        const slider = player.querySelector('.slider-control');
        const valueInput = player.querySelector('.slider-value');
        const handIcon = player.querySelector('.hand-icon');
        const trySliderPrompt = player.querySelector('.try-slider-prompt');
        const arrowPath = player.querySelector('.arrow-path');
        const promptArrow = player.querySelector('.prompt-arrow');

        let images = [];
        let index = 0;
        let direction = 1;
        let playing = true;
        let userControlling = false;
        let lastTime = 0;
        let restartTimer = null;

        // Format value for display
        function formatValue(value) {
            if (config.isMonetary && Math.abs(value) >= 1000) {
                return '$' + value.toLocaleString('en-US');
            }
            return value.toString();
        }

        // Update hand icon position
        function updateHandPosition() {
            const sliderRect = slider.getBoundingClientRect();
            const overlayRect = overlay.getBoundingClientRect();
            const min = parseFloat(slider.min);
            const max = parseFloat(slider.max);
            const val = parseFloat(slider.value);
            const percent = (val - min) / (max - min);
            const thumbWidth = 14;
            const trackWidth = sliderRect.width - thumbWidth;
            const thumbX = thumbWidth / 2 + percent * trackWidth;
            const sliderLeft = sliderRect.left - overlayRect.left;
            handIcon.style.left = (sliderLeft + thumbX) + 'px';
            handIcon.style.top = (sliderRect.top - overlayRect.top + 25) + 'px';

            // Update prompt arrow if enabled
            if (config.showPrompt && trySliderPrompt) {
                updatePromptArrow(sliderLeft + thumbX, sliderRect.top - overlayRect.top);
            }
        }

        // Update prompt arrow position
        function updatePromptArrow(thumbX, thumbY) {
            if (!trySliderPrompt || !arrowPath) return;
            const overlayRect = overlay.getBoundingClientRect();
            const promptTop = 60;
            const textOffset = 20;
            const promptLeft = overlayRect.width / 2 - 70;
            trySliderPrompt.style.left = promptLeft + 'px';
            trySliderPrompt.style.top = promptTop + 'px';
            const arrowStartX = 70;
            const arrowStartY = textOffset + 1;
            const targetX = thumbX - promptLeft;
            const targetY = thumbY - promptTop + 25;
            const pathD = 'M ' + arrowStartX + ' ' + arrowStartY + ' L ' + targetX + ' ' + targetY;
            arrowPath.setAttribute('d', pathD);
            const minX = Math.min(arrowStartX, targetX) - 15;
            const minY = Math.min(arrowStartY, targetY) - 15;
            const maxX = Math.max(arrowStartX, targetX) + 15;
            const maxY = Math.max(arrowStartY, targetY) + 15;
            promptArrow.setAttribute('viewBox', minX + ' ' + minY + ' ' + (maxX - minX) + ' ' + (maxY - minY));
            promptArrow.style.width = (maxX - minX) + 'px';
            promptArrow.style.height = (maxY - minY) + 'px';
            promptArrow.style.left = minX + 'px';
            promptArrow.style.top = minY + 'px';
        }

        // Hide interaction hints
        function hideHints() {
            handIcon.style.display = 'none';
            if (trySliderPrompt) trySliderPrompt.style.display = 'none';
        }

        // Show interaction hints
        function showHints() {
            handIcon.style.display = 'block';
            if (config.showPrompt && trySliderPrompt) trySliderPrompt.style.display = 'block';
        }

        // Start restart timer
        function startRestartTimer() {
            if (restartTimer) clearTimeout(restartTimer);
            restartTimer = setTimeout(() => {
                userControlling = false;
                playing = true;
                showHints();
            }, 5000);
        }

        // Draw current frame
        function drawFrame() {
            if (images.length === 0) return;
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.drawImage(images[index], 0, 0);
        }

        // Update slider to match frame
        function updateSlider() {
            const value = config.frameValues[index];
            slider.value = value;
            valueInput.value = formatValue(value);
            updateHandPosition();
        }

        // Find frame for value
        function findFrameForValue(value) {
            let closestIdx = 0;
            let closestDiff = Math.abs(config.frameValues[0] - value);
            for (let i = 1; i < config.frameValues.length; i++) {
                const diff = Math.abs(config.frameValues[i] - value);
                if (diff < closestDiff) {
                    closestDiff = diff;
                    closestIdx = i;
                }
            }
            return closestIdx;
        }

        // Animation loop
        function loop(time) {
            if (playing && images.length > 0 && !userControlling) {
                const interval = 1000 / config.fps;
                if (time - lastTime >= interval) {
                    lastTime = time;
                    drawFrame();
                    updateSlider();
                    index += direction;
                    if (index >= images.length - 1) direction = -1;
                    if (index <= 0) direction = 1;
                }
            }
            requestAnimationFrame(loop);
        }

        // Slider interaction
        slider.addEventListener('mousedown', () => {
            userControlling = true;
            playing = false;
            hideHints();
            if (restartTimer) clearTimeout(restartTimer);
        });

        slider.addEventListener('input', () => {
            const value = parseFloat(slider.value);
            index = findFrameForValue(value);
            drawFrame();
            valueInput.value = formatValue(value);
        });

        slider.addEventListener('mouseup', () => {
            startRestartTimer();
        });

        slider.addEventListener('mouseleave', () => {
            if (userControlling) startRestartTimer();
        });

        // Load images
        let loaded = 0;
        config.imageUrls.forEach((url, i) => {
            const img = new Image();
            img.onload = () => {
                loaded++;
                if (loaded === config.imageUrls.length) {
                    // All loaded - set canvas size and start
                    canvas.width = images[0].naturalWidth;
                    canvas.height = images[0].naturalHeight;
                    drawFrame();
                    updateSlider();
                    requestAnimationFrame(loop);
                }
            };
            img.src = url;
            images[i] = img;
        });
    });
</script>
