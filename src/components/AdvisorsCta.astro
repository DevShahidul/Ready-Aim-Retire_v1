---
const { ctaData } = Astro.props;
---

<section class="advisors-cta">
    <div class="container">
        <div class="advisors-cta-wrapper">
            <div>
                <div class="advisors-cta-heading">
                    <img src="/images/icons/round-arrow.png" alt="" />
                    <h2>{ctaData.title}</h2>
                </div>
                <div class="advisors-cta-description">
                    <div>
                        <h4>{ctaData.subtitle}</h4>
                        <p>{ctaData.description}</p>
                    </div>
                    <a href="#" class="btn btn-dark"
                        >{ctaData.btnText}
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .advisors-cta {
        color: #fff;
    }
    .advisors-cta-wrapper {
        padding: 4.0625rem 0rem;
        border-radius: 0.625rem;
        background-color: var(--color-primary);
        > div {
            max-width: 83.625rem;
            padding: 0 1rem;
            margin: 0 auto;
        }
    }
    .advisors-cta-heading {
        display: flex;
        align-items: center;
        gap: 1.125rem;

        h2 {
            font-size: clamp(1.875rem, 1.65rem + 1.125vw, 3rem);
            font-weight: 400;
            line-height: 1;
        }
    }
    .advisors-cta-description {
        display: flex;
        align-items: end;
        gap: 4rem;
        justify-content: space-between;
        h4 {
            font-size: 1.0625rem;
            font-weight: 500;
            max-width: 38.75rem;
            margin-top: 2.1875rem;
        }
        p {
            margin-top: 2rem;
        }
    }

    @media (max-width: 1024px) {
        .advisors-cta-description {
            gap: 2rem;
        }
    }

    @media (max-width: 768px) {
        .advisors-cta-wrapper {
            padding: 3rem 1.5rem;
            > div {
                padding: 0;
            }
        }
        .advisors-cta-description {
            flex-direction: column;
            align-items: flex-start;
            gap: 1.5rem;
        }
        .advisors-cta-description h4 {
            margin-top: 1.5rem;
            max-width: 100%;
        }
        .advisors-cta-description p {
            max-width: 100%;
            margin-top: 1rem;
        }
    }

    @media (max-width: 576px) {
        .advisors-cta-wrapper {
            padding: 2rem 1.25rem;
        }
        .advisors-cta-heading {
            gap: 0.75rem;
        }
        .advisors-cta-heading img {
            width: 2rem;
            height: auto;
        }
        .advisors-cta-heading h2 {
            font-size: 1.5rem;
        }
        .advisors-cta-description h4 {
            font-size: 0.9375rem;
            margin-top: 1.25rem;
        }
    }
</style>
