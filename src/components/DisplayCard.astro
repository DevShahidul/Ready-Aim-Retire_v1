---
const { displayData } = Astro.props;
---

<div class="container display-card-container">
    <div class="display-card">
        <div class="display-card-text">
            <h2>{displayData.title}</h2>
            {displayData.subtitle && <p>{displayData.subtitle}</p>}
            {
                displayData.time && (
                    <p class="time-text">
                        <span>2 min read</span>
                        <span>19 Dec 25</span>
                    </p>
                )
            }
        </div>
        <div class="blog-split-content-thumb">
            <img
                src="/images/blog/blog-content.png"
                alt="People with a retirement plan feel more confident about their future"
            />
        </div>
    </div>
</div>

<style></style>
