---
const { displayData } = Astro.props;
---

<div class="container display-card-container">
    <div class="display-card">
        <div
            class={`display-card-text ${displayData.textRight ? "text-right" : ""}`}
        >
            <h2 set:html={displayData.title} />
            {displayData.subtitle && <p set:html={displayData.subtitle} />}
            {
                displayData.time && (
                    <p class="time-text">
                        <span>2 min read</span>
                        <span>19 Dec 25</span>
                    </p>
                )
            }
            {
                displayData.description && (
                    <p set:html={displayData.description} />
                )
            }
            {
                displayData?.list?.listItems && (
                    <ul class="display-card-list bullet-list">
                        {displayData.list.title && (
                            <h4>{displayData.list.title}</h4>
                        )}
                        {displayData.list.listItems.map((item: string) => (
                            <li>{item}</li>
                        ))}
                    </ul>
                )
            }
            {
                displayData.btnText && (
                    <a href="#" class="btn btn-dark">
                        {displayData.btnText}
                    </a>
                )
            }
            {displayData.bottomText && <p set:html={displayData.bottomText} />}
        </div>
        <div class="display-card-thumb">
            <img
                class={`${displayData.textRight ? "rounded-left" : "rounded-right"}`}
                src={displayData.image}
                alt="People with a retirement plan feel more confident about their future"
            />
            {
                displayData.absoluteContent && (
                    <div class="display-card-text-overlay">
                        <h3 class="stat-number">
                            {displayData.absoluteContent.stats}
                        </h3>
                        <p class="stat-headline">
                            {displayData.absoluteContent.title}
                        </p>
                        <p class="stat-subtext">
                            {displayData.absoluteContent.subtitle}
                        </p>
                    </div>
                )
            }
        </div>
    </div>
</div>

<style>
    .display-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 2.3125rem; /* 5px */
        background-color: var(--color-bg-light);
        border: 1.25rem solid #ffffff; /* 20px */
        border-radius: 1.875rem; /* 30px */
        color: #2e2e2e;
    }

    .display-card-text {
        /*margin-top: 3.8rem;*/
        padding-left: 2.625rem; /* 58px */
        max-width: 42rem;
        h2 {
            /*max-width: 29.1875rem;*/
            margin-bottom: 3rem;
            font-size: 2.8125rem;
            font-weight: 400;
            line-height: 3rem;
        }
        p {
            max-width: 38.1875rem;
            font-size: var(--text-xl);
            margin-top: 1.8rem;
            line-height: 1.75rem;
        }
    }

    .display-card-list {
        margin-top: 1.8rem;
        margin-bottom: 0;
        h4 {
            font-size: 1.25rem;
            margin-bottom: 1.8rem;
        }
        li {
            font-size: 1.25rem;
        }
    }

    .rounded-left {
        border-radius: 1.25rem 0px 0px 1.25rem;
    }

    .rounded-right {
        border-radius: 0px 1.25rem 1.25rem 0px;
    }

    .text-right {
        order: 2;
        padding-left: 0rem;
        padding-right: 2.625rem;
    }

    @media (min-width: 90rem) {
        .display-card {
            align-items: start;
        }
        .display-card-text {
            padding: 5.25rem 0rem 3.25rem 2.625rem;
        }

        .text-right {
            order: 2;
            padding-left: 0rem;
            padding-right: 2.625rem; /* 58px */
        }

        .display-card-thumb {
            img {
                min-height: 38.625rem;
            }
        }
    }

    .display-card-thumb {
        position: relative;
        img {
            width: 100%;
            max-width: 54.25rem; /* 772px */
        }
        .display-card-text-overlay {
            position: absolute;
            right: 3rem; /* 60px */
            bottom: 3.4375rem; /* 55px */
            text-align: right;
            color: #ffffff;
            .stat-number {
                font-size: 5.625rem;
                font-weight: 400;
                line-height: 6.875rem;
            }
            .stat-headline {
                font-size: 1.875rem;
                max-width: 40rem;
                line-height: 2.1875rem;
                font-weight: 400;
                margin-top: 0.6rem;
            }
            .stat-subtext {
                font-size: 1.375rem;
                font-weight: 400;
                margin-top: 0.5rem;
            }
        }
    }

    @media (max-width: 1024px) {
        .display-card {
            flex-direction: column;
            gap: 1.5rem;
            border-width: 1rem;
            border-radius: 1.25rem;
        }

        .display-card-text {
            padding-left: 1.5rem;
            padding-right: 1.5rem;
            max-width: 100%;
            order: 1;
            h2 {
                font-size: 2rem;
                line-height: 2.25rem;
                margin-bottom: 1.5rem;
            }
            p {
                max-width: 100%;
                font-size: 1rem;
                margin-top: 1rem;
            }
        }

        .display-card-list {
            margin-top: 1rem;
            h4 {
                font-size: 1.125rem;
                margin-bottom: 1rem;
            }
            li {
                font-size: 1rem;
            }
        }

        .text-right {
            order: 3;
            padding-left: 1.5rem;
            padding-right: 1.5rem;
        }

        .display-card-thumb {
            width: 100%;
            order: 0;
            img {
                max-width: 100%;
                min-height: auto;
            }
            .display-card-text-overlay {
                right: 1.5rem;
                bottom: 1.5rem;
                .stat-number {
                    font-size: 3rem;
                    line-height: 3.5rem;
                }
                .stat-headline {
                    font-size: 1.25rem;
                    max-width: 20rem;
                    line-height: 1.5rem;
                }
                .stat-subtext {
                    font-size: 1rem;
                }
            }
        }

        .rounded-left,
        .rounded-right {
            border-radius: 1.25rem 1.25rem 0 0;
        }
    }

    @media (max-width: 768px) {
        .display-card {
            border-width: 0.75rem;
            border-radius: 1rem;
            gap: 1rem;
        }

        .display-card-text {
            padding: 1rem;
            h2 {
                font-size: 1.5rem;
                line-height: 1.75rem;
                margin-bottom: 1rem;
            }
            p {
                font-size: 0.9375rem;
                line-height: 1.5rem;
                margin-top: 0.75rem;
            }
        }

        .text-right {
            padding-left: 1rem;
            padding-right: 1rem;
        }

        .display-card-list {
            margin-top: 0.75rem;
            padding-left: 1.25rem;
            h4 {
                font-size: 1rem;
                margin-bottom: 0.75rem;
            }
            li {
                font-size: 0.9375rem;
                margin-bottom: 0.5rem;
            }
        }

        .display-card-thumb {
            .display-card-text-overlay {
                right: 1rem;
                bottom: 1rem;
                padding: 0.75rem;
                .stat-number {
                    font-size: 2rem;
                    line-height: 2.5rem;
                }
                .stat-headline {
                    font-size: 1rem;
                    max-width: 14rem;
                    line-height: 1.25rem;
                }
                .stat-subtext {
                    font-size: 0.875rem;
                    margin-top: 0.25rem;
                }
            }
        }

        .rounded-left,
        .rounded-right {
            border-radius: 1rem 1rem 0 0;
        }

        .time-text {
            font-size: 0.8125rem;
            gap: 0.75rem;
        }
    }

    @media (max-width: 480px) {
        .display-card-text {
            padding: 0.75rem;
            h2 {
                font-size: 1.25rem;
                line-height: 1.5rem;
            }
            p {
                font-size: 0.875rem;
            }
        }

        .text-right {
            padding-left: 0.75rem;
            padding-right: 0.75rem;
        }

        .display-card-thumb {
            .display-card-text-overlay {
                right: 0.75rem;
                bottom: 0.75rem;
                .stat-number {
                    font-size: 1.5rem;
                    line-height: 2rem;
                }
                .stat-headline {
                    font-size: 0.875rem;
                    max-width: 10rem;
                    line-height: 1.125rem;
                }
                .stat-subtext {
                    font-size: 0.75rem;
                }
            }
        }

        .btn {
            width: 100%;
            text-align: center;
        }
    }
</style>
