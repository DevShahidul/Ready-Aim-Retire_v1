---
import type { ColumnCard } from "../types/component_types";

const { data } = Astro.props;
---

<section class="info-columns-section">
    <div class="container info-card-wrapper">
        {
            data?.map((item: ColumnCard) => (
                <div class="info-card">
                    <h2>{item?.title}</h2>
                    {item?.subtitle && <p>{item?.subtitle}</p>}
                    {item?.dotList && (
                        <div class="info-card-list">
                            {item.dotList.title && <p>{item.dotList.title}</p>}
                            <ul class="bullet-list ">
                                {item.dotList.items?.map((text) => (
                                    <li>{text}</li>
                                ))}
                            </ul>
                        </div>
                    )}
                    {item.btnText && (
                        <a href="#" class="btn btn-dark">
                            {item.btnText}
                            <i class="fa-solid fa-arrow-right" />
                        </a>
                    )}
                    {item.bottomText && <p>{item.bottomText}</p>}
                    {item.email && (
                        <a
                            href={`mailto:${item.email}`}
                            class="info-card-email"
                        >
                            <img src="/images/icons/option3.png" />
                            {item.email}
                        </a>
                    )}
                </div>
            ))
        }
    </div>
</section>
<style>
    .info-columns-section {
        padding: 4.5rem 0 5.25rem;
        background-color: #fff;
    }

    .info-card-wrapper {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        row-gap: 6rem;
        justify-content: space-between;
    }
    .info-card {
        position: relative;
        width: 26.25rem;
        color: #2e2e2e;
        h2 {
            font-size: 1.75rem;
            font-weight: 400;
        }
        p {
            margin-top: 1.25rem;
        }
        ul {
            margin-top: 1.3rem;
        }
        ul li {
            color: #2e2e2e;
        }
        .btn-dark {
            margin-top: 1rem;
            margin-bottom: 2rem;
        }
    }
    .info-card-email {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1.875rem;
        img {
            width: 1.375rem;
            border-radius: 0.25rem;
        }
    }
    .info-card::after {
        content: "";
        display: block;
        width: 1px;
        height: 100%;
        background-color: #707070;
        position: absolute;
        right: -3.5rem;
        top: 0;
    }
    .info-card:nth-child(3n)::after {
        display: none;
    }

    @media (min-width: 769px) and (max-width: 1024px) {
        .info-columns-section {
            padding: 3.5rem 0 4rem;
        }
        .info-card-wrapper {
            flex-wrap: wrap;
            gap: 1.5rem;
        }
        .info-card {
            width: calc(50% - 0.75rem);
        }
        .info-card:nth-child(2n)::after {
            display: none;
        }
        .info-card h2 {
            font-size: 1.5rem;
        }
    }

    @media (min-width: 481px) and (max-width: 768px) {
        .info-columns-section {
            padding: 2.5rem 0 3rem;
        }
        .info-card-wrapper {
            flex-direction: column;
            gap: 2rem;
        }
        .info-card {
            width: 100%;
            .btn-dark {
                margin-bottom: 1rem;
            }
        }
        .info-card::after {
            display: none;
        }
        .info-card h2 {
            font-size: 1.375rem;
        }
        .info-card p {
            margin-top: 0.75rem;
        }
        .info-card ul {
            margin-top: 1rem;
        }
        .info-card .btn-dark {
            margin-top: 0.75rem;
        }
        .info-card-email {
            margin-top: 1.5rem;
        }
    }

    @media (max-width: 480px) {
        .info-columns-section {
            padding: 2rem 0 2.5rem;
        }
        .info-card-wrapper {
            flex-direction: column;
            gap: 1.5rem;
        }
        .info-card {
            width: 100%;
        }
        .info-card::after {
            display: none;
        }
        .info-card h2 {
            font-size: 1.25rem;
        }
        .info-card p {
            margin-top: 0.625rem;
            font-size: 0.9375rem;
        }
        .info-card ul {
            margin-top: 0.875rem;
        }
        .info-card ul li {
            font-size: 0.875rem;
        }
        .info-card .btn-dark {
            margin-top: 0.75rem;
        }
        .info-card-email {
            margin-top: 1.25rem;
            font-size: 0.875rem;
        }
    }
</style>
