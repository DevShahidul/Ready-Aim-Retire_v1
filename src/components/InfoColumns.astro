---
const { data } = Astro.props;
---

<section class="container info-columns">
    {
        data?.map((item) => (
            <div>
                <h2>{item?.title}</h2>
            </div>
        ))
    }
</section>
<style>
    .info-columns {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
    }
</style>
