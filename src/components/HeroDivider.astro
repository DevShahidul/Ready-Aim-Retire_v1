---
const { text } = Astro.props;
---

<section class="hero-divider">
    <h4 class="container">
        {text}
    </h4>
</section>

<style>
    .hero-divider {
        margin-bottom: 7.1875rem;
        padding: 1.5rem 0;
        border-bottom: 1px solid #707070;
        border-top: 1px solid #707070;

        h4 {
            font-size: 1.0625rem;
            font-weight: 400;
        }
    }

    @media (max-width: 1024px) {
        .hero-divider {
            padding: 0.8rem 0;
        }
        .container {
            padding: 0 2rem;
        }
        .container h4 {
            font-size: 1.0625rem;
        }
    }

    @media (max-width: 768px) {
        .container h4 {
            font-size: 1rem;
        }
    }
</style>
