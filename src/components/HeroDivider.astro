---
const { text } = Astro.props;
---

<section class="hero-divider">
    <h4 class="container">
        {text}
    </h4>
</section>

<style>
    .hero-divider {
        padding: 1.625rem 0;
        border-bottom: 1px solid #707070;
        border-top: 1px solid #707070;

        h4 {
            font-size: 1.0625rem;
            font-weight: 400;
        }
    }
</style>
