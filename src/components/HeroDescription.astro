---
import { render } from "astro:content";

const { description } = Astro.props;
const { Content } = await render(description);
---

<section class="container hero-description">
    <div class="description-title">
        <h3>
            {description?.data.title}
        </h3>
        {
            description?.data.btnText && (
                <a href="#" class="btn btn-dark">
                    {description?.data.btnText}
                    <i class="fa-solid fa-arrow-right" />
                </a>
            )
        }
    </div>
    <div>
        <div
            class={`description-details ${description?.data.largeContent ? "more-space" : ""}`}
        >
            <Content />
        </div>
        {
            description.data.checkList && (
                <ul class="description-points">
                    {description?.data.checkList.map(
                        (item: { point: string }) =>
                            item?.point && (
                                <li class="benefit-pill">
                                    <img src="/images/icons/clearer-way-check.svg" />
                                    <span>{item.point}</span>
                                </li>
                            ),
                    )}
                </ul>
            )
        }
    </div>
</section>

<style>
    .hero-description {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-gap: 4.6rem;
        margin-top: 2.625rem;
    }
    .description-title {
        h3 {
            font-size: 1.75rem;
            font-weight: 400;
            max-width: 32rem;
            line-height: 2.25rem;
        }

        .btn {
            margin-top: 3.625rem;
        }
    }
    .description-details {
        max-width: 36rem;
        p {
            font-size: 1.0625rem;
            line-height: 1.75rem;
            font-weight: 300;
            /*max-width: 36rem;*/
        }
        p:not(:last-child) {
            margin-bottom: 1.25rem;
        }
    }

    .description-points {
        display: flex;
        flex-direction: column;
        gap: 2.0625rem;
        margin-top: 3.5rem;
        max-width: 21.875rem;
    }

    .more-space {
        max-width: 41.5rem;
    }

    @media (min-width: 769px) and (max-width: 1024px) {
        .hero-description {
            grid-gap: 1.5rem;
            margin-top: 2rem;
        }
        .description-title {
            h3 {
                font-size: 1.625rem;
                line-height: 2.125rem;
                max-width: 26rem;
            }
        }
        .description-details {
            max-width: 36rem;
            p {
                font-size: 1.125rem;
                line-height: 1.625rem;
                max-width: 32rem;
            }
        }
    }

    @media (max-width: 768px) {
        .hero-description {
            grid-template-columns: 1fr;
            grid-gap: 1.5rem;
            margin-top: 1.5rem;
        }
        .description-title {
            h3 {
                font-size: 1.5rem;
                line-height: 2rem;
                max-width: 100%;
            }
        }
        .description-details {
            max-width: 100%;
            p {
                font-size: 1.125rem;
                line-height: 1.625rem;
                max-width: 100%;
            }
        }
    }

    @media (max-width: 480px) {
        .hero-description {
            grid-gap: 1.25rem;
            margin-top: 1.25rem;
        }
        .description-title h3 {
            font-size: 1.25rem;
            line-height: 1.75rem;
        }
        .description-details p {
            font-size: 1rem;
            line-height: 1.5rem;
        }
    }

    @media (min-width: 481px) and (max-width: 768px) {
        .hero-description {
            grid-template-columns: 1fr;
            grid-gap: 1.25rem;
            margin-top: 1.25rem;
        }
        .description-title {
            h3 {
                font-size: 1.375rem;
                line-height: 1.875rem;
                max-width: 100%;
            }
        }
        .description-details {
            max-width: 100%;
            p {
                font-size: 1rem;
                line-height: 1.5rem;
                max-width: 100%;
            }
        }
    }
</style>
