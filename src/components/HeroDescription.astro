---
import { render } from "astro:content";

const { description } = Astro.props;
const { Content } = await render(description);
---

<section class="container hero-description">
    <div class="description-title">
        <h3>
            {description?.data.title}
        </h3>
        {
            description?.data.btnText && (
                <a href="btn btn-dark">{description?.data.btnText}</a>
            )
        }
    </div>
    <div>
        <div class="description-details">
            <Content />
        </div>
        <div>
            {
                description?.data.checkList.map(
                    (item: { point: string }) =>
                        item?.point && (
                            <div class="benefit-pill">
                                <img src="/images/icons/clearer-way-check.svg" />
                                <span>{item}</span>
                            </div>
                        ),
                )
            }
        </div>
    </div>
</section>

<style>
    .hero-description {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-gap: 2rem;
        margin-top: 7.1875rem;
    }
    .description-title {
        h3 {
            font-size: 1.75rem;
            font-weight: 400;
            max-width: 27.5rem;
            line-height: 2.25rem;
        }
    }
    .description-details {
        max-width: 41.875rem;
        p {
            font-size: 1.25rem;
            line-height: 1.75rem;
            font-weight: 300;
        }
    }
</style>
