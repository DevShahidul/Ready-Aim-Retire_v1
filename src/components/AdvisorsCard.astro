---
const { cardData } = Astro.props;
---

<div
    class="advisors-card"
    style={`background-color: ${cardData.secondary ? "#BBE0D3" : "#fff"} ;`}
>
    <h3 set:html={cardData.title} />
    <p><strong>{cardData.subtitle}</strong></p>
    <h4 set:html={cardData.list.title} />
    <ul class="checklist">
        {
            cardData?.list.items.map((item: string) => (
                <li>
                    <img src="/images/icons/check-icon.png" />
                    {item}
                </li>
            ))
        }
    </ul>
    <p set:html={cardData.bottomText} />
</div>

<style>
    .advisors-card {
        padding: 3.625rem 3rem 2.625rem;
        border-radius: 0.625rem;
        color: #2e2e2e;
        font-size: 1.0625rem;
        h3 {
            font-size: 1.5625rem;
            font-weight: 500;
            margin-bottom: 1.875rem;
        }
        p {
            margin-bottom: 2rem;
        }
        p,
        li {
            font-size: 1.0625rem;
            color: #2e2e2e;
        }
        ul {
            margin-top: 1.8rem;
        }
    }

    .checklist li {
        align-items: center;
    }

    @media (max-width: 1024px) {
        .advisors-card {
            padding: 2.5rem 2rem 2rem;
        }
    }

    @media (max-width: 768px) {
        .advisors-card {
            padding: 1.75rem 1.5rem 1.5rem;
        }
        .advisors-card h3 {
            font-size: 1.375rem;
            margin-bottom: 1.25rem;
        }
        .advisors-card p {
            margin-bottom: 1.25rem;
        }
        .advisors-card ul {
            margin-top: 1.25rem;
        }
        .advisors-card p,
        .advisors-card li {
            font-size: 0.9375rem;
        }
    }

    @media (max-width: 480px) {
        .advisors-card {
            padding: 1.5rem 1.25rem 1.25rem;
        }
        .advisors-card h3 {
            font-size: 1.125rem;
            margin-bottom: 1rem;
        }
        .advisors-card p {
            margin-bottom: 1rem;
        }
        .advisors-card ul {
            margin-top: 1rem;
        }
        .checklist li {
            align-items: flex-start;
        }
    }
</style>
