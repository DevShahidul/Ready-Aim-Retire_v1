---
const { info } = Astro.props;
---

<div class="question-card">
    {info.tag && <span class="tag">{info.tag}</span>}
    <div class="question-card-body">
        <div>
            <h3 set:html={info.title} />
            <p>{info.subtitle}</p>
            <ul>
                {info.checkList.title && <h4>{info.checkList.title}</h4>}
                {
                    info.checkList.items.map((item: string) => (
                        <li>
                            <img src="/images/icons/check-icon.png" alt="" />
                            {item}
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
    <div class="text-bottom" style="--height: 4.875rem">
        <p>{info.bottomText}</p>
    </div>
</div>

<style>
    .question-card {
        background-color: #fff;
        border-radius: 0.625rem;
        padding-bottom: 2.75rem;
        display: flex;
        flex-direction: column;
        --padding-s: 2.5rem;
        --padding-e: 1.5rem;
    }

    .question-card .tag {
        text-align: left;
        border-radius: 10px 50px 50px 0px;
        max-width: 11.25rem;
        color: #fff;
        background-color: #41bab4;
        padding: 0.5rem 2rem;
        font-size: 1.875rem;
        font-weight: 500;
    }
    .question-card-body {
        flex-grow: 1;
        padding-left: var(--padding-s);
        padding-right: var(--padding-e);
        h3 {
            font-size: 1.75rem;
            font-weight: 400;
            margin-top: 2.5rem;
        }
        p {
            font-size: 1.125rem;
            font-weight: 500;
        }
        ul {
            margin-bottom: 2rem;
        }
        ul h4 {
            margin-top: 1.25rem;
        }
        ul li {
            display: flex;
            font-size: 1.0625rem;
            align-items: center;
            gap: 0.75rem;
            margin-top: 1rem;
        }
    }

    .text-bottom {
        width: 100%;
        padding-left: var(--padding-s);
        padding-right: var(--padding-e);
        min-height: var(--height);
    }

    .text-bottom p {
        max-width: 35.625rem;
        border-top: 1px solid #707070;
        padding-top: 1.625rem;
    }

    @media (min-width: 769px) and (max-width: 1024px) {
        .question-card-body {
            h3 {
                font-size: 1.5rem;
                margin-top: 2rem;
            }
            p {
                font-size: 1rem;
            }
            ul li {
                font-size: 0.9375rem;
            }
        }
        .question-card .tag {
            font-size: 1.5rem;
            max-width: 9rem;
            padding: 0.375rem 1.5rem;
        }
    }

    @media (min-width: 481px) and (max-width: 768px) {
        .question-card {
            --padding-s: 1.5rem;
            --padding-e: 1rem;
        }
        .question-card-body {
            h3 {
                font-size: 1.375rem;
                margin-top: 1.75rem;
            }
            p {
                font-size: 0.9375rem;
            }
            ul {
                margin-bottom: 1.5rem;
            }
            ul li {
                font-size: 0.875rem;
                gap: 0.5rem;
                margin-top: 0.75rem;
            }
        }
        .question-card .tag {
            font-size: 1.25rem;
            max-width: 8rem;
            padding: 0.375rem 1.25rem;
        }
        .text-bottom {
            max-width: 100%;
            padding-top: 1.25rem;
        }
    }

    @media (max-width: 480px) {
        .question-card {
            padding-bottom: 2rem;
            --padding-s: 1.5rem;
            --padding-e: 1rem;
        }
        .question-card-body {
            padding-left: 1.25rem;
            padding-right: 0.875rem;
            h3 {
                font-size: 1.25rem;
                margin-top: 1.5rem;
            }
            p {
                font-size: 0.875rem;
            }
            ul {
                margin-bottom: 1.25rem;
            }
            ul h4 {
                margin-top: 1rem;
            }
            ul li {
                font-size: 0.8125rem;
                gap: 0.5rem;
                margin-top: 0.625rem;
            }
        }
        .question-card .tag {
            font-size: 1.125rem;
            max-width: 7rem;
            padding: 0.25rem 1rem;
        }
        .text-bottom {
            max-width: 100%;
            padding-top: 1rem;
            font-size: 0.875rem;
        }
    }
</style>

<script>
    import { syncHeight } from "../lib/utils.ts";

    document.addEventListener("DOMContentLoaded", () =>
        syncHeight("text-bottom"),
    );

    window.addEventListener("resize", () => syncHeight("text-bottom"));
</script>
