---
const { info } = Astro.props;
---

<div class="question-card">
    {info.tag && <h2 class="tag">{info.tag}</h2>}
    <div class="question-card-body">
        <h3>{info.title}</h3>
        <p>{info.subtitle}</p>
        <ul>
            {info.checkList.title && <h4>{info.checkList.title}</h4>}
            {
                info.checkList.items.map((item: string) => (
                    <li>
                        <img src="/images/icons/check-icon.png" alt="" />
                        {item}
                    </li>
                ))
            }
        </ul>
        <p class="text-bottom">{info.bottomText}</p>
    </div>
</div>

<style>
    .question-card {
        background-color: #fff;
        border-radius: 0.625rem;
        padding-bottom: 2.75rem;
    }

    .question-card .tag {
        text-align: left;
        border-radius: 10px 50px 50px 10px;
        max-width: 11.25rem;
        color: #fff;
        background-color: #41bab4;
        padding: 0.5rem 2rem;
        font-size: 1.875rem;
        font-weight: 500;
    }
    .question-card-body {
        padding-left: 2.5rem;
        padding-right: 1.5rem;
        display: flex;
        height: 80%;
        flex-direction: column;
        h3 {
            font-size: 1.75rem;
            font-weight: 400;
            margin-top: 2.5rem;
        }
        p {
            font-size: 1.125rem;
            font-weight: 500;
        }
        ul {
            margin-bottom: 2rem;
        }
        ul h4 {
            margin-top: 1.25rem;
        }
        ul li {
            display: flex;
            font-size: 1.0625rem;
            align-items: center;
            gap: 0.75rem;
            margin-top: 1rem;
        }
    }
    .question-card-body:last-of-type {
        height: 86%;
    }
    .text-bottom {
        max-width: 35.625rem;
        padding-top: 1.625rem;
        margin-top: auto;
        border-top: 1px solid #707070;
    }

    @media (min-width: 769px) and (max-width: 1024px) {
        .question-card-body {
            padding-left: 2rem;
            padding-right: 1.25rem;
            h3 {
                font-size: 1.5rem;
                margin-top: 2rem;
            }
            p {
                font-size: 1rem;
            }
            ul li {
                font-size: 0.9375rem;
            }
        }
        .question-card .tag {
            font-size: 1.5rem;
            max-width: 9rem;
            padding: 0.375rem 1.5rem;
        }
    }

    @media (min-width: 481px) and (max-width: 768px) {
        .question-card-body {
            padding-left: 1.5rem;
            padding-right: 1rem;
            h3 {
                font-size: 1.375rem;
                margin-top: 1.75rem;
            }
            p {
                font-size: 0.9375rem;
            }
            ul {
                margin-bottom: 1.5rem;
            }
            ul li {
                font-size: 0.875rem;
                gap: 0.5rem;
                margin-top: 0.75rem;
            }
        }
        .question-card .tag {
            font-size: 1.25rem;
            max-width: 8rem;
            padding: 0.375rem 1.25rem;
        }
        .text-bottom {
            max-width: 100%;
            padding-top: 1.25rem;
        }
    }

    @media (max-width: 480px) {
        .question-card {
            padding-bottom: 2rem;
        }
        .question-card-body {
            padding-left: 1.25rem;
            padding-right: 0.875rem;
            h3 {
                font-size: 1.25rem;
                margin-top: 1.5rem;
            }
            p {
                font-size: 0.875rem;
            }
            ul {
                margin-bottom: 1.25rem;
            }
            ul h4 {
                margin-top: 1rem;
            }
            ul li {
                font-size: 0.8125rem;
                gap: 0.5rem;
                margin-top: 0.625rem;
            }
        }
        .question-card .tag {
            font-size: 1.125rem;
            max-width: 7rem;
            padding: 0.25rem 1rem;
        }
        .text-bottom {
            max-width: 100%;
            padding-top: 1rem;
            font-size: 0.875rem;
        }
    }
</style>
