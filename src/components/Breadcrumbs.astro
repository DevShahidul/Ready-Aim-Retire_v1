---
interface BreadcrumbItem {
    label: string;
    href?: string;
}

interface Props {
    items: BreadcrumbItem[];
    theme?: 'light' | 'dark';
}

const { items, theme = 'light' } = Astro.props;
---

<nav class={`breadcrumbs breadcrumbs-${theme}`} aria-label="Breadcrumb">
    <ol>
        <li>
            <a href="/">Home</a>
        </li>
        {items.map((item, index) => (
            <li>
                {item.href && index < items.length - 1 ? (
                    <a href={item.href}>{item.label}</a>
                ) : (
                    <span aria-current="page">{item.label}</span>
                )}
            </li>
        ))}
    </ol>
</nav>

<style>
    .breadcrumbs {
        padding: 1rem 0;
        font-size: 0.875rem;
    }

    .breadcrumbs ol {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .breadcrumbs li {
        display: flex;
        align-items: center;
    }

    .breadcrumbs li:not(:last-child)::after {
        content: '/';
        margin-left: 0.5rem;
    }

    /* Light theme (default) */
    .breadcrumbs-light li:not(:last-child)::after {
        color: #94a3b8;
    }

    .breadcrumbs-light a {
        color: #14b8a6;
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .breadcrumbs-light a:hover {
        color: #0d9488;
        text-decoration: underline;
    }

    .breadcrumbs-light span {
        color: #64748b;
    }

    /* Dark theme */
    .breadcrumbs-dark li:not(:last-child)::after {
        color: rgba(255, 255, 255, 0.5);
    }

    .breadcrumbs-dark a {
        color: rgba(255, 255, 255, 0.9);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .breadcrumbs-dark a:hover {
        color: #ffffff;
        text-decoration: underline;
    }

    .breadcrumbs-dark span {
        color: rgba(255, 255, 255, 0.7);
    }

    @media (max-width: 480px) {
        .breadcrumbs {
            font-size: 0.8rem;
        }
    }
</style>
