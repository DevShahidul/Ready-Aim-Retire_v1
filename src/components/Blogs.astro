interface Props {
    limit?: number;
    blogPage?: boolean;
}

const { limit, blogPage } = Astro.props;
const blogs = limit ? allBlogs.slice(0, limit) : allBlogs;
---

<section class="blogs-section">
    <div class="blog-inner">
        <h2 class="blogs-title">Latest Content</h2>

        <div class="blogs-container">
            {
                blogs.map((item, idx) => (
                    <BlogCard
                        blog={item}
                        serial={idx + 1}
                        blogPage={blogPage}
                    />
                ))
            }
        </div>
    </div>
</section>

<style>
    .blogs-section {
        padding: 4rem 0 5rem;
        background-color: #f5f5f5;
    }

    .blog-inner {
        max-width: 1836px;
        margin: 0 auto;
        padding: 0 2.25rem;
    }

    .blogs-title {
        font-size: 1.25rem;
        font-weight: 500;
        color: #2c3e50;
        margin: 0 0 2.2rem 0;
    }

    .blogs-container {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 3.875rem;
    }

    /* Tablet breakpoint */
    @media (max-width: 1200px) {
        .blogs-container {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 1024px) {
        .blogs-section {
            padding: 2rem 0;
        }
        .blogs-title {
            font-size: 1.75rem;
        }
    }

    /* Mobile breakpoint */
    @media (max-width: 768px) {
        .blogs-section {
            padding: 2rem 0;
        }
        .blog-inner {
            padding: 0 1.25rem;
        }

        .container {
            padding: 0 1rem;
        }

        .blogs-title {
            font-size: 1.5rem;
            margin-bottom: 2rem;
        }

        .blogs-container {
            gap: 1.25rem;
        }
    }

    @media (max-width: 576px) {
        .blogs-container {
            grid-template-columns: 1fr;
        }

        .blogs-section {
            padding: 1.5rem 0;
        }

        .blogs-title {
            font-size: 1.375rem;
            margin-bottom: 1.5rem;
        }
    }
</style>
