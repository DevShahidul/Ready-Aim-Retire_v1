<section class="newsletter-section">
    <div class="newsletter">
        <div class="container">
            <div class="newsletter-content">
                <h2 class="newsletter-title">
                    Get the latest news in your inbox
                </h2>
                <p class="newsletter-description">
                    Sign up to receive all the latest updates. We'll be sure to
                    pass along what's happening at Ready Aim Retire, straight to
                    your inbox.
                </p>
            </div>

            <form class="newsletter-form">
                <div class="newsletter-inputs">
                    <div class="newsletter-field">
                        <input
                            type="text"
                            id="firstName"
                            name="firstName"
                            placeholder="First Name"
                            class="newsletter-input"
                            required
                        />
                    </div>

                    <div class="newsletter-field">
                        <input
                            type="text"
                            id="lastName"
                            name="lastName"
                            placeholder="Last Name"
                            class="newsletter-input"
                            required
                        />
                    </div>

                    <div class="newsletter-field">
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="Email"
                            class="newsletter-input"
                            required
                        />
                    </div>
                </div>

                <button type="submit" class="btn btn-dark">Subscribe</button>
            </form>
        </div>
    </div>
</section>

<style>
    .newsletter-section {
        max-width: 1836px;
        margin: 0 auto;
        padding: 0 1.25rem;
    }
    .newsletter {
        background-color: #bbe0d3;
        padding: 2rem 0px;
        border-radius: 10px;
    }

    .newsletter-content {
        margin-bottom: 2rem;
    }

    .newsletter-title {
        font-size: 1.5625rem;
        color: #0e3f4a;
        font-weight: 600;
        margin: 0 0 0.5rem 0;
    }

    .newsletter-description {
        font-size: 1rem;
        margin: 0;
        line-height: 1.5;
        color: #0c2350;
    }

    .newsletter-form {
        display: flex;
        gap: 1rem;
        align-items: flex-end;
        flex-wrap: wrap;
    }

    .newsletter-inputs {
        display: flex;
        gap: 1.5rem;
        flex: 1;
        flex-wrap: wrap;
        min-width: 0;
    }

    .newsletter-field {
        flex: 1;
        min-width: 200px;
        display: flex;
        flex-direction: column;
    }

    .newsletter-input {
        width: 100%;
        padding: 0.75rem 0 0.5rem 0;
        background: transparent;
        border: none;
        border-bottom: 2px solid #2d4a4a;
        font-size: 1rem;
        outline: none;
        transition: border-color 0.3s ease;
    }

    .newsletter-input::placeholder {
        color: #2d4a4a;
        font-size: 1rem;
        opacity: 0.8;
    }

    .newsletter-input:focus {
        border-bottom-color: #1a3a3a;
    }

    /* Tablet breakpoint */
    @media (max-width: 1024px) {
        .newsletter-title {
            font-size: 1.5rem;
        }

        .newsletter-inputs {
            gap: 1rem;
        }

        .newsletter-field {
            min-width: 180px;
        }
    }

    /* Mobile breakpoint */
    @media (max-width: 768px) {
        .newsletter-section {
            margin: 2rem 0;
        }
        .newsletter {
            padding: 2rem 1rem;
        }

        .newsletter-title {
            font-size: 1.375rem;
        }

        .newsletter-description {
            font-size: 0.9375rem;
        }

        .newsletter-form {
            flex-direction: column;
            align-items: stretch;
        }

        .newsletter-inputs {
            flex-direction: column;
            gap: 1.25rem;
        }

        .newsletter-field {
            min-width: 100%;
        }

        .newsletter-button {
            width: 100%;
            padding: 1rem;
        }
    }

    /* Small mobile breakpoint */
    @media (max-width: 480px) {
        .newsletter {
            padding: 1.5rem 0rem;
        }

        .newsletter-title {
            font-size: 1.25rem;
        }

        .newsletter-description {
            font-size: 0.875rem;
        }
    }
</style>
