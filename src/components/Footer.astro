                    >
                    <a
                        href="https://x.com/readyaimretire"
                        target="_blank"
                        rel="noopener noreferrer">Instagram</a
                    >
                    <a
                        href="https://facebook.com/readyaimretire"
                        target="_blank"
                        rel="noopener noreferrer">Youtube</a
                    >
                    <a
                        href="https://youtube.com/@readyaimretire"
                        target="_blank"
                        rel="noopener noreferrer">X</a
                    >
                    <a
                        href="https://instagram.com/readyaimretire"
                        target="_blank"
                        rel="noopener noreferrer">Facebook</a
                    >
                    <a href="mailto:support@readyaimretire.com"
                        >Affiliate Program</a
                    >
                    <a href="/contact">Final Literacy and Community Impact</a>
                    <a
                        href="https://linkedin.com/company/readyaimretire"
                        target="_blank"
                        rel="noopener noreferrer">Refer Friends</a
                    >
                </nav>
            </div>

            <!-- Right Column: Company -->
            <div class="footer-column">
                <h4>Quick Links</h4>
                <nav>
                    <a href="/features">Features</a>
                    <a href="/pricing">Pricing</a>
                    <a href="/faq">FAQs</a>
                    <a href="/aboutus">About us</a>
                    <a href="/latest-update">Latest updates</a>
                    <a href="/advisors">Advisors</a>
                </nav>
            </div>
        </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
        <div class="footer-container">
            <p class="copyright">
                © <span id="copyright-year"></span> ReadyAimRetire LLC
            </p>
            <p class="disclaimer">
                Disclaimer: The content, tools, and resources on
                ReadyAimRetire.com are intended for educational purposes only
                and should not be construed as professional financial or
                investment advice. You should consult a professional advisor to
                determine what may be best for your individual needs.
            </p>
            <div class="footer-legal">
                <a href="/terms">Terms of Service</a>
                <a href="/privacy">Policy</a>
                <a href="/cookies">Cookie Policy</a>
            </div>
        </div>
    </div>
</footer>

<script>
    // Set dynamic copyright year
    document.getElementById("copyright-year")!.textContent = new Date()
        .getFullYear()
        .toString();
</script>

<style>
    .site-footer {
        background-color: var(--color-secondary);
        color: var(--color-text-light);
    }

    .footer-container {
        max-width: 1836px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    /* Main Footer Content */
    .footer-main {
        border-top: 1px solid rgba(255, 255, 255, 0.15);
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    }

    .footer-main .footer-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        position: relative;
    }

    /* Left Column - Brand & Contact Links */
    .footer-brand {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        padding: 4rem 0;
    }

    /* Middle & Right Columns - Product & Company */
    .footer-column {
        display: flex;
        flex-direction: column;
        padding: 4rem 0;
        border-left: 1px solid #ffffff40;
        padding-left: 1.875rem;
    }

    .footer-logo {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        text-decoration: none;
    }

    .footer-logo img {
        width: 7.8125rem;
        height: auto;
    }

    .logo-text {
        font-size: 1rem;
        font-weight: 600;
        color: #ffffff;
        line-height: 1.2;
    }

    /* Footer Links List */
    .footer-links-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .footer-links-list a {
        color: #f6f7f9;
        text-decoration: none;
        font-size: 0.85rem;
        transition: color 0.2s ease;
    }

    .footer-links-list a:hover {
        color: #14b8a6;
    }

    .footer-column h4 {
        font-size: 0.75rem;
        font-weight: 400;
        letter-spacing: 0.1em;
        color: #41bab4;
        margin: 0 0 1.5rem 0;
        text-transform: uppercase;
    }

    .footer-column nav {
        display: flex;
        flex-direction: column;
    }

    .footer-column nav a {
        color: #f6f7f9;
        text-decoration: none;
        font-size: 2.6rem;
        font-weight: 300;
        transition: color 0.2s ease;
        line-height: 1.2;
    }

    .footer-column nav a:hover {
        color: #41bab4;
    }

    /* Bottom Bar */
    .footer-bottom {
        padding: 2.25rem 0;
    }

    .footer-bottom .footer-container {
        display: flex;
        /*justify-content: space-between;*/
        align-items: flex-start;
        gap: 4rem;
        flex-wrap: wrap;
    }

    .copyright {
        margin: 0;
        color: #f6f7f9;
        font-size: 0.8rem;
        white-space: nowrap;
    }

    .disclaimer {
        margin: 0;
        color: #f6f7f9;
        font-size: 0.7rem;
        line-height: 1.5;
        flex: 1;
        max-width: 48.5rem;
    }

    .footer-legal {
        display: flex;
        gap: 1.5rem;
        white-space: nowrap;
        margin-left: auto;
    }

    .footer-legal a {
        color: var(--color-text-soft);
        color: #;
        text-decoration: none;
        font-size: 0.8rem;
        transition: color 0.2s ease;
    }

    .footer-legal a:hover {
        color: #14b8a6;
    }

    /* Responsive */
    @media (max-width: 900px) {
        .footer-main .footer-container {
            gap: 3rem;
        }

        .footer-brand,
        .footer-column {
            padding: 1.5rem 0;
        }
        .footer-column {
            border-left: none;
        }
    }

    @media (max-width: 767) {
        .footer-main .footer-container {
            grid-template-columns: repeat(1, 1fr);
            gap: 1rem;
        }
    }

    @media (max-width: 820px) {
        .footer-main {
            padding: 2rem 0;
        }

        .footer-main .footer-container {
            grid-template-columns: 1fr;
            gap: 0;
            align-items: center;
        }

        .footer-brand,
        .footer-column {
            padding: 0;
        }

        .footer-column nav a {
            font-size: 1.5rem;
            line-height: 1.4;
        }
        .footer-column h4 {
            margin: 2rem 0 0.5rem 0;
        }

        .footer-bottom .footer-container {
            flex-direction: column;
            gap: 1rem;
        }

        .disclaimer {
            max-width: none;
        }

        .footer-legal {
            flex-wrap: wrap;
            gap: 1rem;
            margin-left: 0;
        }
    }
</style>
