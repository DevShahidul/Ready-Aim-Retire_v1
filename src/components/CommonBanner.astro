---
const { banner } = Astro.props;
---

<section class="banner-section">
    <div class="banner-thumb">
        <img src={banner.image} />
    </div>

    <div class="banner-info">
        <img src={banner.logo} alt="" class="banner-logo" />

        <div class="banner-heading">
            <img src="/images/icons/round-arrow.png" />
            <p>{banner.title}</p>
        </div>
        <h3>{banner.subtitle}</h3>
        <button class="btn btn-outline-dark"
            >{banner.buttonText}
            <i class="fa-solid fa-arrow-right fa-lg"></i>
        </button>
    </div>
</section>

<style>
    .banner-section {
        display: grid;
        grid-template-columns: 1fr 1fr;
        margin-bottom: -6rem;
        position: relative;
    }
    .banner-thumb img {
        width: 100%;
        height: 100%;
    }
    .banner-logo {
        max-width: 190px;
        position: absolute;
        right: 2rem;
        top: 2rem;
    }
    .banner-info {
        background-image: url("/images/banner/arrow_background.png");
        background-repeat: no-repeat;
        background-size: cover;
        display: flex;
        flex-direction: column;
        justify-content: end;
        gap: 4.735rem;
        padding: 1rem 1.25rem 6.25rem 4.25rem;
    }
    .banner-heading {
        display: flex;
        align-items: center;
        gap: 1rem;
        p {
            font-size: 1.5625rem;
            font-weight: 500;
            max-width: 20rem;
            line-height: 1.875rem;
            color: #f6f7f9;
        }
    }
    .banner-info h3 {
        font-size: 3rem;
        font-weight: 500;
        max-width: 46.25rem;
        line-height: 3.3125rem;
        color: #f6f7f9;
    }
    .banner-info button {
        max-width: 9.75rem;
        border: none;
    }
    .banner-info button: {
        i {
            color: #fff;
        }
    }

    @media (min-width: 768px) and (max-width: 1024px) {
        .banner-section {
            grid-template-columns: 1fr 1fr;
            margin-bottom: -5rem;
        }
        .banner-info {
            padding: 0 1.75rem 5rem 3.5rem;
            gap: 4rem;
        }
        .banner-logo {
            max-width: 170px;
            right: 1.75rem;
            top: 1.75rem;
        }
        .banner-heading p {
            font-size: 1.375rem;
            line-height: 1.625rem;
            max-width: 18rem;
        }
        .banner-info h3 {
            font-size: 2.625rem;
            line-height: 2.875rem;
            max-width: 40rem;
        }
        .banner-info button {
            max-width: 9rem;
        }
    }

    @media (max-width: 1024px) {
        .banner-section {
            grid-template-columns: 1fr;
            margin-bottom: -4rem;
        }
        .banner-info {
            padding: 2rem 1.5rem 4rem 1.5rem;
            gap: 3rem;
        }
        .banner-logo {
            max-width: 150px;
            right: 1.5rem;
            top: 1.5rem;
        }
    }

    @media (max-width: 768px) {
        .banner-section {
            margin-bottom: -3rem;
        }
        .banner-info {
            padding: 2rem 1rem 3rem 1rem;
            gap: 2rem;
        }
        .banner-logo {
            max-width: 120px;
            right: 1rem;
            top: 1rem;
        }
        .banner-heading p {
            font-size: 1.25rem;
            line-height: 1.5rem;
            max-width: 15rem;
        }
        .banner-info h3 {
            font-size: 2.25rem;
            line-height: 2.5rem;
            max-width: 100%;
        }
    }

    @media (max-width: 480px) {
        .banner-section {
            margin-bottom: -2rem;
        }
        .banner-info {
            padding: 2rem 0.75rem 2rem 0.75rem;
            gap: 1.5rem;
        }
        .banner-logo {
            max-width: 100px;
            right: 0.75rem;
            top: 0.75rem;
        }
        .banner-heading {
            gap: 0.75rem;
            p {
                font-size: 1rem;
                line-height: 1.25rem;
                max-width: 12rem;
            }
        }
        .banner-info h3 {
            font-size: 1.75rem;
            line-height: 2rem;
        }
        .banner-info button {
            max-width: 9rem;
            padding: 0.75rem 1rem;
            font-size: 0.875rem;
        }
    }

    @media (max-width: 390px) {
        .banner-section {
            margin-bottom: -3.5rem;
        }
        .banner-info {
            padding: 2rem 0.5rem 1.5rem 0.5rem;
            gap: 1rem;
        }
        .banner-logo {
            max-width: 80px;
            right: 0.5rem;
            top: 0.5rem;
        }
        .banner-heading {
            gap: 0.5rem;
            p {
                font-size: 0.875rem;
                line-height: 1.125rem;
                max-width: 10rem;
            }
        }
        .banner-info h3 {
            font-size: 1.5rem;
            line-height: 1.75rem;
        }
        .banner-info button {
            max-width: 9rem;
            padding: 0.625rem 0.875rem;
            font-size: 0.75rem;
        }
    }

    @media (max-width: 320px) {
        .banner-section {
            margin-bottom: -1rem;
        }
        .banner-info {
            padding: 2rem 0.25rem 1rem 0.25rem;
            gap: 0.75rem;
        }
        .banner-logo {
            max-width: 60px;
            right: 0.25rem;
            top: 0.25rem;
        }
        .banner-heading {
            gap: 0.375rem;
            p {
                font-size: 0.75rem;
                line-height: 1rem;
                max-width: 8rem;
            }
        }
        .banner-info h3 {
            font-size: 1.25rem;
            line-height: 1.5rem;
        }
        .banner-info button {
            max-width: 6rem;
            padding: 0.5rem 0.75rem;
            font-size: 0.625rem;
        }
    }
</style>
