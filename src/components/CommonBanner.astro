---
const { banner } = Astro.props;
---

<section class="banner-section">
    <div class="banner-thumb">
        <img src={banner.image} />
    </div>

    <div class="banner-info">
        <img src={banner.logo} alt="" class="banner-logo" />

        <div class="banner-heading">
            <img src="/images/icons/round-arrow.png" />
            <p>{banner.title}</p>
        </div>
        <h3>{banner.subtitle}</h3>
        <button class="btn btn-outline-dark"
            >{banner.buttonText}

            <svg
                width="17"
                height="17"
                viewBox="0 0 17 17"
                xmlns="http://www.w3.org/2000/svg"
            >
                <mask
                    id="mask0_1_1674"
                    style="mask-type:alpha"
                    maskUnits="userSpaceOnUse"
                    x="-1"
                    y="-1"
                    width="19"
                    height="19"
                >
                    <path d="M0 0H17V17H0V0Z" fill="black" stroke="#2E2E2E"
                    ></path>
                </mask>
                <g mask="url(#mask0_1_1674)">
                    <path
                        d="M15.2071 8.09542L9.29637 1.81532C9.15303 1.66607 8.90885 1.66496 8.77106 1.79795C8.63068 1.93279 8.6207 2.18141 8.75369 2.32327L14.0755 7.98016H2.36942C2.1655 7.97979 2 8.14529 2 8.34958C2 8.55349 2.1655 8.71899 2.36942 8.71899H14.0755L8.75369 14.3755C8.62033 14.5174 8.62883 14.7678 8.77106 14.9008C8.91291 15.0342 9.14158 15.0371 9.29637 14.8835L15.2071 8.60337C15.3474 8.43048 15.3105 8.2188 15.2071 8.09542Z"
                        fill="#2E2E2E"
                        stroke="#2E2E2E"></path>
                </g>
            </svg>
        </button>
    </div>
</section>

<style>
    .banner-section {
        display: grid;
        grid-template-columns: 1fr 1fr;
        margin-bottom: -6rem;
        position: relative;
    }
    .banner-thumb img {
        width: 100%;
    }
    .banner-logo {
        max-width: 190px;
        position: absolute;
        right: 2rem;
        top: 2rem;
    }
    .banner-info {
        background-image: url("/images/banner/arrow_background.png");
        background-repeat: no-repeat;
        background-size: cover;
        display: flex;
        flex-direction: column;
        justify-content: end;
        gap: 4.735rem;
        padding: 0 1.25rem 6.25rem 4.25rem;
    }
    .banner-heading {
        display: flex;
        align-items: center;
        gap: 1rem;
        p {
            font-size: 1.5625rem;
            font-weight: 500;
            max-width: 20rem;
            line-height: 1.875rem;
            color: #f6f7f9;
        }
    }
    .banner-info h3 {
        font-size: 3rem;
        font-weight: 500;
        max-width: 46.25rem;
        line-height: 3.3125rem;
        color: #f6f7f9;
    }
    .banner-info button {
        max-width: 9.75rem;
        border: none;
    }
</style>
