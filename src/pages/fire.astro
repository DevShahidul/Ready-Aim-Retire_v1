---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTABanner from "../components/CTABanner.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

const pageTitle = "FIRE Planning – ReadyAimRetire";
const pageDescription =
    "Retire early with confidence. ReadyAimRetire helps FIRE seekers plan their path to financial independence.";
---

<BaseLayout title={pageTitle} description={pageDescription} solidHeader={true}>
    <!-- Hero Section -->
    <section class="fire-hero">
        <div class="container">
            <Breadcrumbs items={[{ label: "FIRE Planning" }]} />
            <div class="fire-hero-content" data-aos="fade-up">
                <h1>Retire Early with Confidence</h1>
                <p class="fire-hero-subheadline">
                    ReadyAimRetire gives FIRE seekers the tools to plan, test,
                    and optimize their path to financial independence.
                </p>
                <a
                    href={`${import.meta.env.PUBLIC_APP_URL}/signup`}
                    class="cta-button primary-cta"
                >
                    Start Your FIRE Journey
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </section>

    <!-- FIRE-Specific Benefits Section -->
    <section class="fire-benefits">
        <div class="container">
            <h2 data-aos="fade-up">Built for FIRE Seekers</h2>
            <p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
                Everything you need to plan and execute your early retirement
                strategy
            </p>

            <div class="benefits-grid">
                <div
                    class="benefit-card"
                    data-aos="fade-up"
                    data-aos-delay="100"
                >
                    <div class="benefit-icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <h3>Coast FIRE Calculator</h3>
                    <p>
                        See exactly when you can stop contributing and let
                        compound growth do the rest.
                    </p>
                </div>

                <div
                    class="benefit-card"
                    data-aos="fade-up"
                    data-aos-delay="150"
                >
                    <div class="benefit-icon">
                        <i class="fas fa-balance-scale"></i>
                    </div>
                    <h3>Lean vs Fat FIRE</h3>
                    <p>
                        Model different lifestyle scenarios to find your perfect
                        balance of frugality and comfort.
                    </p>
                </div>

                <div
                    class="benefit-card"
                    data-aos="fade-up"
                    data-aos-delay="200"
                >
                    <div class="benefit-icon">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <h3>Early Retirement Modeling</h3>
                    <p>
                        Test retirement at 40, 45, 50—see exactly how each
                        choice affects your plan.
                    </p>
                </div>

                <div
                    class="benefit-card"
                    data-aos="fade-up"
                    data-aos-delay="250"
                >
                    <div class="benefit-icon">
                        <i class="fas fa-heartbeat"></i>
                    </div>
                    <h3>Healthcare Cost Projections</h3>
                    <p>
                        Plan for the gap before Medicare with detailed
                        healthcare cost modeling.
                    </p>
                </div>

                <div
                    class="benefit-card"
                    data-aos="fade-up"
                    data-aos-delay="300"
                >
                    <div class="benefit-icon">
                        <i class="fas fa-piggy-bank"></i>
                    </div>
                    <h3>Tax Optimization</h3>
                    <p>
                        Minimize early withdrawal penalties with smart Roth
                        conversion and withdrawal strategies.
                    </p>
                </div>

                <div
                    class="benefit-card"
                    data-aos="fade-up"
                    data-aos-delay="350"
                >
                    <div class="benefit-icon">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <h3>Sequence of Returns Risk</h3>
                    <p>
                        Stress-test your plan against the worst market
                        conditions in history.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- How It Works Section -->
    <section class="how-it-works">
        <div class="container">
            <h2 data-aos="fade-up">Your Path to FIRE in 3 Steps</h2>

            <div class="steps-container">
                <div
                    class="step-card"
                    data-aos="fade-right"
                    data-aos-delay="100"
                >
                    <div class="step-number">1</div>
                    <div class="step-icon">
                        <i class="fas fa-bullseye"></i>
                    </div>
                    <h3>Set Your Target</h3>
                    <p>
                        Enter your current finances and FIRE target. Define your
                        retirement age, spending needs, and savings rate.
                    </p>
                </div>

                <div
                    class="step-card"
                    data-aos="fade-right"
                    data-aos-delay="200"
                >
                    <div class="step-number">2</div>
                    <div class="step-icon">
                        <i class="fas fa-flask"></i>
                    </div>
                    <h3>Model Scenarios</h3>
                    <p>
                        Test different scenarios and assumptions. Compare Coast
                        FIRE, Lean FIRE, and Fat FIRE paths side by side.
                    </p>
                </div>

                <div
                    class="step-card"
                    data-aos="fade-right"
                    data-aos-delay="300"
                >
                    <div class="step-number">3</div>
                    <div class="step-icon">
                        <i class="fas fa-rocket"></i>
                    </div>
                    <h3>Optimize & Track</h3>
                    <p>
                        Fine-tune your path and track your progress. Adjust as
                        life changes and stay on course to independence.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- FIRE Success Stories Section -->
    <section class="fire-testimonials">
        <div class="container">
            <h2 data-aos="fade-up">FIRE Success Stories</h2>
            <p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
                Real people who used ReadyAimRetire to achieve financial
                independence
            </p>

            <div class="testimonials-grid">
                <div
                    class="testimonial-card"
                    data-aos="zoom-in"
                    data-aos-delay="100"
                >
                    <div class="testimonial-content">
                        <i class="fas fa-quote-left quote-icon"></i>
                        <p>
                            "After using ReadyAimRetire, I confidently retired
                            at 47. The Monte Carlo simulations gave me the peace
                            of mind I needed to make the leap. I knew exactly
                            how my portfolio would hold up in different market
                            conditions."
                        </p>
                    </div>
                    <div class="testimonial-author">
                        <div class="author-info">
                            <h4>Sarah M.</h4>
                            <p>Coast FIRE at 47</p>
                        </div>
                    </div>
                </div>

                <div
                    class="testimonial-card"
                    data-aos="zoom-in"
                    data-aos-delay="200"
                >
                    <div class="testimonial-content">
                        <i class="fas fa-quote-left quote-icon"></i>
                        <p>
                            "The Monte Carlo simulations showed me my plan was
                            solid even in worst-case scenarios. I was able to
                            retire at 52 with a comfortable lifestyle. The tax
                            optimization features saved me thousands in
                            unnecessary penalties."
                        </p>
                    </div>
                    <div class="testimonial-author">
                        <div class="author-info">
                            <h4>Michael T.</h4>
                            <p>Fat FIRE at 52</p>
                        </div>
                    </div>
                </div>

                <div
                    class="testimonial-card"
                    data-aos="zoom-in"
                    data-aos-delay="300"
                >
                    <div class="testimonial-content">
                        <i class="fas fa-quote-left quote-icon"></i>
                        <p>
                            "I was able to optimize my Roth conversion ladder
                            and see exactly when I could access my funds
                            penalty-free. The healthcare cost modeling helped me
                            budget for the pre-Medicare years with confidence."
                        </p>
                    </div>
                    <div class="testimonial-author">
                        <div class="author-info">
                            <h4>Jennifer L.</h4>
                            <p>Lean FIRE at 44</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Screenshot/Feature Preview Section -->
    <section class="feature-preview">
        <div class="container">
            <h2 data-aos="fade-up">See Your FIRE Plan Come to Life</h2>
            <p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
                Visualize your path to early retirement with powerful charts and
                projections
            </p>

            <div
                class="screenshot-container"
                data-aos="fade-up"
                data-aos-delay="200"
            >
                <div class="screenshot-placeholder">
                    <i class="fas fa-chart-area"></i>
                    <p>Interactive retirement scenario modeling</p>
                    <ul class="feature-highlights">
                        <li>
                            <i class="fas fa-check"></i> Compare multiple FIRE strategies
                            side by side
                        </li>
                        <li>
                            <i class="fas fa-check"></i> Adjust retirement age and
                            see instant results
                        </li>
                        <li>
                            <i class="fas fa-check"></i> Model Roth conversion ladders
                            and tax strategies
                        </li>
                        <li>
                            <i class="fas fa-check"></i> Test different withdrawal
                            rates and sequences
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- FIRE-Specific FAQ Section -->
    <section class="fire-faq">
        <div class="container">
            <h2 data-aos="fade-up">Frequently Asked Questions</h2>

            <div class="faq-container">
                <div class="faq-item" data-aos="fade-up" data-aos-delay="100">
                    <h3>
                        <i class="fas fa-question-circle"></i>
                        How is ReadyAimRetire different from other FIRE calculators?
                    </h3>
                    <p>
                        Unlike basic FIRE calculators that give you a single
                        number, ReadyAimRetire provides comprehensive scenario
                        modeling with Monte Carlo simulations, tax optimization,
                        healthcare cost projections, and the ability to test
                        multiple FIRE strategies. You can model Coast FIRE,
                        Barista FIRE, Lean FIRE, and Fat FIRE all in one
                        platform, and see how each choice impacts your timeline
                        and financial security.
                    </p>
                </div>

                <div class="faq-item" data-aos="fade-up" data-aos-delay="150">
                    <h3>
                        <i class="fas fa-question-circle"></i>
                        Can I model the 4% rule and other withdrawal strategies?
                    </h3>
                    <p>
                        Absolutely. ReadyAimRetire supports the classic 4% rule,
                        dynamic withdrawal strategies, variable percentage
                        withdrawals, and custom withdrawal schedules. You can
                        test each strategy against historical market data and
                        see how they perform in different economic conditions.
                        The platform also models the impact of sequence of
                        returns risk on your chosen strategy.
                    </p>
                </div>

                <div class="faq-item" data-aos="fade-up" data-aos-delay="200">
                    <h3>
                        <i class="fas fa-question-circle"></i>
                        How do you handle healthcare costs before Medicare?
                    </h3>
                    <p>
                        Healthcare is often the biggest unknown for early
                        retirees. ReadyAimRetire includes detailed healthcare
                        cost modeling for the pre-Medicare years, including ACA
                        marketplace plans, COBRA options, and health sharing
                        ministries. You can model different scenarios based on
                        your state, family size, and income to get accurate
                        projections for this critical expense.
                    </p>
                </div>

                <div class="faq-item" data-aos="fade-up" data-aos-delay="250">
                    <h3>
                        <i class="fas fa-question-circle"></i>
                        Can I plan for Coast FIRE or Barista FIRE?
                    </h3>
                    <p>
                        Yes! ReadyAimRetire excels at modeling partial FIRE
                        strategies. You can set up Coast FIRE scenarios to see
                        when you can stop saving and let your portfolio grow, or
                        model Barista FIRE with part-time income covering basic
                        expenses. The platform shows you exactly how much you
                        need saved, when you can make the transition, and how
                        different income levels affect your timeline.
                    </p>
                </div>

                <div class="faq-item" data-aos="fade-up" data-aos-delay="300">
                    <h3>
                        <i class="fas fa-question-circle"></i>
                        Is ReadyAimRetire suitable for international FIRE seekers?
                    </h3>
                    <p>
                        While ReadyAimRetire is optimized for U.S. tax laws and
                        retirement accounts, many international FIRE seekers use
                        the platform for general retirement planning and
                        portfolio modeling. The Monte Carlo simulations,
                        withdrawal strategies, and basic planning features work
                        regardless of location. However, specific tax
                        optimization features are currently U.S.-focused.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Final CTA Section -->
    <section class="final-cta">
        <div class="container">
            <div class="cta-content" data-aos="zoom-in">
                <h2>
                    Join Thousands of FIRE Seekers Planning Their Early
                    Retirement
                </h2>
                <p>
                    Start modeling your path to financial independence today. No
                    credit card required.
                </p>
                <a
                    href={`${import.meta.env.PUBLIC_APP_URL}/signup`}
                    class="cta-button primary-cta large"
                >
                    Start Your FIRE Journey
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </section>

    <!-- CTABanner Component -->
    <CTABanner />
</BaseLayout>
