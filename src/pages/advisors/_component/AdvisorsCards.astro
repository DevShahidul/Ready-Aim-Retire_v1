---
import AdvisorsCard from "../../../components/AdvisorsCard.astro";

const { cards } = Astro.props;
type Card = {
    id: number;
    secondary: boolean;
    title: string;
    subtitle: string;
    list: {
        title: string;
        items: string[];
    };
    bottomText: string;
};
---

<section class="container advisors-cards-wrapper">
    {cards.map((card: Card) => <AdvisorsCard cardData={card} />)}
</section>

<style>
    .advisors-cards-wrapper {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: clamp(1rem, 0.225rem + 3.875vw, 4.875rem);
    }

    @media (max-width: 768px) {
        .advisors-cards-wrapper {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }
    }
</style>
