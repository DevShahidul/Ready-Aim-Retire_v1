---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTABanner from "../components/CTABanner.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
---

<BaseLayout
    title="Our Commitment to Financial Literacy – ReadyAimRetire"
    description="At Ready Aim Retire, we believe financial clarity should be accessible to everyone. Learn about our commitment to financial literacy and community support."
    solidHeader={true}
>
    <!-- Hero Section -->
    <section class="fl-hero">
        <div class="container">
            <Breadcrumbs items={[{ label: "Financial Literacy" }]} />
            <h1 data-aos="fade-up">Our Commitment to Financial Literacy</h1>
            <div class="fl-hero-grid" data-aos="fade-up" data-aos-delay="100">
                <div class="fl-hero-left">
                    <p class="fl-hero-tagline">
                        Building confidence through<br />understanding - for
                        everyone.
                    </p>
                </div>
                <div class="fl-hero-right">
                    <p>
                        At Ready Aim Retire, we believe financial clarity should
                        be accessible to everyone.
                    </p>
                    <p>
                        Understanding how money works - especially over a
                        lifetime — is one of the most powerful tools a person
                        can have. It builds confidence, expands opportunity, and
                        gives people greater control over their future.
                    </p>
                    <p>That belief guides us and how we build our products.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Why Financial Literacy Matters Section -->
    <section class="fl-matters-section">
        <div class="container">
            <div class="fl-matters-grid" data-aos="fade-up">
                <div class="fl-matters-content">
                    <h2>
                        Why Financial Literacy <span class="text-teal"
                            >Matters</span
                        >
                    </h2>
                    <h3>Knowledge changes outcomes</h3>
                    <p>
                        Financial decisions made early - and revisited often -
                        can have an outsized impact over a lifetime. Yet many
                        people are forced to make those decisions without the
                        tools or education they deserve.
                    </p>
                    <p class="fl-subheading">We believe:</p>
                    <ul>
                        <li>
                            Financial literacy is a foundation for independence
                        </li>
                        <li>
                            Clear tools help turn uncertainty into confidence
                        </li>
                        <li>
                            Understanding leads to better long-term outcomes
                        </li>
                        <li>
                            Everyone deserves access to quality planning
                            resources
                        </li>
                    </ul>
                    <p class="fl-mission">
                        Ready Aim Retire exists to help people see their
                        financial future - and make informed choices along the
                        way.
                    </p>
                </div>
                <div class="fl-matters-image">
                    <img
                        src="/images/landing/soccer.png"
                        alt="Grandparent playing soccer with grandchildren in a sunny park"
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- Supporting Organizations Section -->
    <section class="fl-cards-section">
        <div class="container">
            <div class="fl-cards-grid" data-aos="fade-up">
                <!-- Supporting Operation HOPE -->
                <div class="fl-card">
                    <div class="fl-card-header">
                        <h3>Supporting Operation HOPE</h3>
                    </div>
                    <div class="fl-card-body">
                        <h4>
                            Partnering with organizations making a real
                            difference.
                        </h4>
                        <p>
                            We are proud to support Operation HOPE, a nonprofit
                            organization dedicated to advancing financial
                            dignity and economic opportunity through education,
                            coaching, and empowerment.
                        </p>
                        <p>Operation HOPE works to:</p>
                        <ul>
                            <li>
                                Promote financial literacy and credit education
                            </li>
                            <li>Support underserved communities</li>
                            <li>
                                Help individuals build long-term financial
                                confidence
                            </li>
                            <li>Expand access to economic opportunity</li>
                        </ul>
                        <p>
                            Their mission closely aligns with our own belief
                            that understanding money is a form of empowerment.
                        </p>
                        <p class="fl-highlight">
                            Supporting organizations like Operation HOPE is one
                            way we extend our commitment beyond software and
                            into the broader community.
                        </p>
                    </div>
                </div>

                <!-- Free Pro Access for Students -->
                <div class="fl-card">
                    <div class="fl-card-header">
                        <h3>Free Pro Access for Students</h3>
                    </div>
                    <div class="fl-card-body">
                        <h4>Investing in the next generation of planners</h4>
                        <p>
                            We believe students should have access to the same
                            planning tools as anyone else - without cost being a
                            barrier.
                        </p>
                        <p>
                            That's why we offer <strong
                                >free Pro accounts to students.</strong
                            >
                        </p>
                        <p>How it works:</p>
                        <ul>
                            <li>
                                Email us from your <strong
                                    >.edu email address</strong
                                >
                            </li>
                            <li>
                                We'll set up a <strong>free Pro account</strong> for
                                you
                            </li>
                            <li>No credit card required</li>
                        </ul>
                        <p>
                            This gives students full access to advanced planning
                            tools- including scenario modeling, stress testing,
                            budgeting, and long-term projections - so they can
                            start building confidence early.
                        </p>
                        <p>Email us at:</p>
                        <p class="fl-email">
                            <i class="fas fa-envelope"></i> support@readyaimretire.com
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Responsibility and Looking Ahead Section -->
    <section class="fl-cards-section fl-cards-section-alt">
        <div class="container">
            <div class="fl-cards-grid" data-aos="fade-up">
                <!-- Built with Respect -->
                <div class="fl-card">
                    <div class="fl-card-header">
                        <h3>Built with Respect - and Responsibility</h3>
                    </div>
                    <div class="fl-card-body">
                        <h4>We take our role seriously</h4>
                        <ul>
                            <li>We don't sell user data</li>
                            <li>We don't push financial products</li>
                            <li>We don't profit from specific outcomes</li>
                        </ul>
                        <p>
                            Our success depends on helping people understand
                            their finances better — not steering them toward
                            decisions that benefit us.
                        </p>
                    </div>
                </div>

                <!-- Looking Ahead -->
                <div class="fl-card">
                    <div class="fl-card-header">
                        <h3>Looking Ahead</h3>
                    </div>
                    <div class="fl-card-body">
                        <h4>
                            Our commitment to financial literacy is ongoing.
                        </h4>
                        <p>As Ready Aim Retire grows, we plan to:</p>
                        <ul>
                            <li>Expand educational resources</li>
                            <li>
                                Support organizations aligned with financial
                                empowerment
                            </li>
                            <li>
                                Continue improving access to high-quality
                                planning tools
                            </li>
                        </ul>
                        <p class="fl-highlight">
                            Because financial confidence should be something
                            people build - not something they're so.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Join Us Section -->
    <section class="fl-join-section">
        <div class="container">
            <div class="fl-join-wrapper" data-aos="fade-up">
                <div class="fl-join-header">
                    <div class="fl-join-icon">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="8" y1="12" x2="16" y2="12"></line>
                            <polyline points="12 8 16 12 12 16"></polyline>
                        </svg>
                    </div>
                    <h2>Join Us</h2>
                </div>
                <div class="fl-join-grid">
                    <div class="fl-join-text">
                        <p>
                            Whether you're planning for retirement, pursuing
                            financial independence, advising clients, or just
                            starting out — we're glad you're here.
                        </p>
                        <p>
                            If you believe in clarity, education, and
                            empowerment, you're already aligned with our
                            mission.
                        </p>
                    </div>
                    <div class="fl-join-cta">
                        <a
                            href={`${import.meta.env.PUBLIC_APP_URL}/signup`}
                            class="btn-start-planning"
                        >
                            Start Planning for Free
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Banner -->
    <CTABanner />
</BaseLayout>
