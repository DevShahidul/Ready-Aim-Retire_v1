---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTABanner from "../components/CTABanner.astro";
import CommonHero from "../components/CommonHero.astro";
import HeroDescription from "../components/HeroDescription.astro";
import { getEntry } from "astro:content";
import Questions from "./affiliates/_components/Questions.astro";

const decriptionCollection = await getEntry(
    "heroDescription",
    "financial-literacy_description",
);
const infoCards = await getEntry("infoCard", "financial-literacy_cards");
---

<BaseLayout
    title="Our Commitment to Financial Literacy – ReadyAimRetire"
    description="At Ready Aim Retire, we believe financial clarity should be accessible to everyone. Learn about our commitment to financial literacy and community support."
    solidHeader={true}
>
    <CommonHero title="Gift Financial Literacy" />
    <HeroDescription description={decriptionCollection} />
    <Questions infoCards={infoCards} />
    <CTABanner />
</BaseLayout>
