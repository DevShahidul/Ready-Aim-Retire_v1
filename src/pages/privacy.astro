---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTABanner from "../components/CTABanner.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
---

<BaseLayout
    title="Privacy Policy – ReadyAimRetire"
    description="Read ReadyAimRetire's privacy policy. Learn how we protect your personal and financial information."
    solidHeader={true}
>
    <!-- Privacy Policy Hero Section -->
    <section class="privacy-hero">
        <div class="container">
            <Breadcrumbs items={[{ label: "Privacy Policy" }]} />
            <h1 class="privacy-hero-title">Privacy Policy</h1>
            <p class="privacy-hero-subtitle">Last Updated: January 1, 2026</p>
        </div>
    </section>

    <!-- Main Privacy Policy Content -->
    <section class="privacy-content">
        <div class="container">
            <div class="policy-document">
                <!-- Privacy at a Glance -->
                <div class="policy-section">
                    <h2>Privacy at a Glance</h2>
                    <ul>
                        <li>
                            We collect only the information needed to operate
                            and improve Ready Aim Retire
                        </li>
                        <li>
                            Your financial inputs are used solely to generate
                            your retirement plans and projections
                        </li>
                        <li>We do not sell your personal or financial data</li>
                        <li>
                            We share data only with service providers necessary
                            for our operations
                        </li>
                        <li>
                            You can access, update, or delete your data at any
                            time
                        </li>
                        <li>
                            We use industry-standard safeguards to protect your
                            information
                        </li>
                    </ul>
                </div>

                <!-- Section 1 -->
                <div class="policy-section">
                    <h2>
                        <span class="section-number">1.</span> Information We Collect
                    </h2>

                    <h3>a. Information You Provide</h3>
                    <p>
                        We may collect information you voluntarily provide,
                        including:
                    </p>
                    <ul>
                        <li>Name and email address</li>
                        <li>Account login credentials</li>
                        <li>
                            Financial data used for retirement planning (e.g.,
                            income, assets, expenses, assumptions)
                        </li>
                        <li>
                            Payment and billing information (processed by
                            third-party payment processors)
                        </li>
                        <li>
                            Communications with us (emails, support requests,
                            feedback)
                        </li>
                    </ul>

                    <h3>b. Automatically Collected Information</h3>
                    <p>
                        When you use the Services, we may automatically collect:
                    </p>
                    <ul>
                        <li>IP address and device identifiers</li>
                        <li>Browser type, operating system, and usage data</li>
                        <li>
                            Pages viewed, features used, and interaction data
                        </li>
                        <li>Cookies and similar tracking technologies</li>
                    </ul>
                </div>

                <!-- Section 2 -->
                <div class="policy-section">
                    <h2>
                        <span class="section-number">2.</span> How We Use Your Information
                    </h2>
                    <p>We use your information to:</p>
                    <ul>
                        <li>Provide, operate, and improve the Services</li>
                        <li>Create and maintain your account</li>
                        <li>
                            Generate projections and retirement planning outputs
                        </li>
                        <li>Process subscriptions and payments</li>
                        <li>
                            Communicate with you about updates, features, and
                            support
                        </li>
                        <li>
                            Analyze usage trends and improve user experience
                        </li>
                        <li>Maintain security and prevent fraud</li>
                        <li>Comply with legal obligations</li>
                    </ul>
                </div>

                <!-- Section 3 -->
                <div class="policy-section">
                    <h2>
                        <span class="section-number">3.</span> Financial Data & Projections
                    </h2>
                    <p>
                        Financial information you enter into Ready Aim Retire is
                        used solely to generate planning scenarios and
                        projections within your account.
                    </p>
                    <ul>
                        <li>
                            We do not sell or rent your personal or financial
                            data
                        </li>
                        <li>
                            We do not use your financial inputs for advertising
                            purposes
                        </li>
                        <li>
                            Projections are hypothetical and depend on
                            user-provided assumptions
                        </li>
                    </ul>
                </div>

                <!-- Section 4 -->
                <div class="policy-section">
                    <h2>
                        <span class="section-number">4.</span> Cookies & Tracking
                        Technologies
                    </h2>
                    <p>We use cookies and similar technologies to:</p>
                    <ul>
                        <li>Enable core functionality</li>
                        <li>Remember preferences</li>
                        <li>Understand usage patterns</li>
                        <li>Improve performance and reliability</li>
                    </ul>
                    <p>
                        You may control cookies through your browser settings,
                        though disabling cookies may affect functionality.
                    </p>
                </div>

                <!-- Section 5 -->
                <div class="policy-section">
                    <h2>
                        <span class="section-number">5.</span> How We Share Information
                    </h2>
                    <p>
                        We may share information only in the following
                        circumstances:
                    </p>

                    <h3>a. Service Providers</h3>
                    <p>
                        We may share information with trusted third-party
                        vendors who help us operate the Services, such as:
                    </p>
                    <ul>
                        <li>Hosting and infrastructure providers</li>
                        <li>Analytics services</li>
                        <li>Payment processors</li>
                        <li>Customer support tools</li>
                    </ul>
                    <p>
                        These providers are authorized to use information only
                        as necessary to provide services to us.
                    </p>

                    <h3>b. Legal Requirements</h3>
                    <p>
                        We may disclose information if required to do so by law
                        or in response to valid legal requests.
                    </p>

                    <h3>c. Business Transfers</h3>
                    <p>
                        If Ready Aim Retire is involved in a merger,
                        acquisition, or asset sale, your information may be
                        transferred as part of that transaction.
                    </p>
                </div>

                <!-- Section 6 -->
                <div class="policy-section">
                    <h2>
                        <span class="section-number">6.</span> Data Retention
                    </h2>
                    <p>
                        We retain personal information only as long as necessary
                        to:
                    </p>
                    <ul>
                        <li>Provide the Services</li>
                        <li>Fulfill legal and accounting obligations</li>
                        <li>Enforce our agreements</li>
                    </ul>
                    <p>
                        You may request deletion of your account and associated
                        data, subject to legal retention requirements.
                    </p>
                </div>

                <!-- Section 7 -->
                <div class="policy-section">
                    <h2>
                        <span class="section-number">7.</span> Data Security
                    </h2>
                    <p>
                        We implement reasonable administrative, technical, and
                        physical safeguards to protect your information.
                    </p>
                    <p>
                        However, no method of transmission or storage is 100%
                        secure, and we cannot guarantee absolute security.
                    </p>
                </div>

                <!-- Section 8 -->
                <div class="policy-section">
                    <h2>
                        <span class="section-number">8.</span> Your Rights & Choices
                    </h2>
                    <p>Depending on your location, you may have rights to:</p>
                    <ul>
                        <li>
                            Access, update, or correct your personal information
                        </li>
                        <li>Request deletion of your data</li>
                        <li>Restrict or object to certain processing</li>
                        <li>Receive your data in a portable format</li>
                    </ul>
                    <p>
                        To exercise these rights, contact us using the
                        information below.
                    </p>
                </div>

                <!-- Section 9 -->
                <div class="policy-section">
                    <h2>
                        <span class="section-number">9.</span> GDPR Rights (European
                        Economic Area & UK)
                    </h2>
                    <p>
                        If you are located in the European Economic Area (EEA)
                        or the United Kingdom, you have the right to:
                    </p>
                    <ul>
                        <li>Access your personal data</li>
                        <li>Rectify inaccurate or incomplete data</li>
                        <li>Request erasure ("right to be forgotten")</li>
                        <li>Restrict or object to processing</li>
                        <li>Request data portability</li>
                        <li>Withdraw consent at any time</li>
                    </ul>
                    <p>
                        We process personal data under the following lawful
                        bases:
                    </p>
                    <ul>
                        <li>Your consent</li>
                        <li>
                            Performance of a contract (providing the Services)
                        </li>
                        <li>Compliance with legal obligations</li>
                        <li>Legitimate business interests</li>
                    </ul>
                    <p>
                        If you believe your rights have been violated, you may
                        lodge a complaint with your local data protection
                        authority.
                    </p>
                </div>

                <!-- Section 10 -->
                <div class="policy-section">
                    <h2>
                        <span class="section-number">10.</span> CCPA / CPRA Rights
                        (California Residents)
                    </h2>
                    <p>
                        If you are a California resident, you have the right to:
                    </p>
                    <ul>
                        <li>
                            Know what personal information we collect, use, and
                            disclose
                        </li>
                        <li>Request deletion of your personal information</li>
                        <li>Correct inaccurate personal information</li>
                        <li>
                            Opt out of the sale or sharing of personal
                            information
                        </li>
                        <li>
                            Not be discriminated against for exercising your
                            rights
                        </li>
                    </ul>
                    <p>
                        Ready Aim Retire does not sell or share personal
                        information as defined by the CCPA/CPRA.
                    </p>
                    <p>
                        You may submit a verifiable consumer request by
                        contacting us at the email address below.
                    </p>
                </div>

                <!-- Section 11 -->
                <div class="policy-section">
                    <h2>
                        <span class="section-number">11.</span> Children's Privacy
                    </h2>
                    <p>
                        The Services are not directed to individuals under the
                        age of 18. We do not knowingly collect personal
                        information from children.
                    </p>
                    <p>
                        If we become aware that we have collected such
                        information, we will delete it.
                    </p>
                </div>

                <!-- Section 12 -->
                <div class="policy-section">
                    <h2>
                        <span class="section-number">12.</span> International Users
                    </h2>
                    <p>
                        Ready Aim Retire is based in the United States. If you
                        access the Services from outside the U.S., you consent
                        to the transfer and processing of your information in
                        the United States.
                    </p>
                </div>

                <!-- Section 13 -->
                <div class="policy-section">
                    <h2>
                        <span class="section-number">13.</span> Third-Party Links
                    </h2>
                    <p>
                        The Services may contain links to third-party websites
                        or services. We are not responsible for the privacy
                        practices of those third parties.
                    </p>
                </div>

                <!-- Section 14 -->
                <div class="policy-section">
                    <h2>
                        <span class="section-number">14.</span> Changes to This Privacy
                        Policy
                    </h2>
                    <p>
                        We may update this Privacy Policy from time to time. We
                        will post the updated version on this page and update
                        the "Last updated" date.
                    </p>
                    <p>
                        Continued use of the Services after changes constitutes
                        acceptance of the revised policy.
                    </p>
                </div>

                <!-- Section 15 -->
                <div class="policy-section">
                    <h2><span class="section-number">15.</span> Contact Us</h2>
                    <p>
                        If you have questions or concerns about this Privacy
                        Policy or our data practices, contact us:
                    </p>

                    <div class="contact-details">
                        <p>
                            Ready Aim Retire<br />
                            1062 15th St Unit 70441<br />
                            Denver, CO 80202<br />
                            United States
                        </p>
                        <p>
                            Email: <a href="mailto:privacy@readyaimretire.co"
                                >privacy@readyaimretire.co</a
                            >
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Banner -->
    <CTABanner />
</BaseLayout>
