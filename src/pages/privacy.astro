---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { render } from "astro:content";
import CommonHero from "../components/CommonHero.astro";
import HeroDivider from "../components/HeroDivider.astro";
import CTABanner from "../components/CTABanner.astro";
const privacyData = await getEntry("privacyPage", "privacy-policy");
if (!privacyData) {
    throw new Error("privacy policy page not found");
}
const { Content } = await render(privacyData);
---

<BaseLayout
    title="Privacy Policy – ReadyAimRetire"
    description="Learn about how ReadyAimRetire uses privacy policy to improve your experience on our website."
    solidHeader={true}
>
    <CommonHero title={privacyData?.data.title} />
    <HeroDivider text={privacyData?.data.lastUpdated} />
    <section class="container">
        <Content />
    </section>
    <CTABanner />
</BaseLayout>
