---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---

<BaseLayout
    title="Cookie Policy – ReadyAimRetire"
    description="Learn about how ReadyAimRetire uses cookies to improve your experience on our website."
    solidHeader={true}
>
    <!-- Cookie Policy Hero Section -->
    <section class="cookies-hero">
        <div class="container">
            <Breadcrumbs theme="dark" items={[{ label: "Cookie Policy" }]} />
            <h1 class="cookies-hero-title">Cookie Policy</h1>
            <p class="cookies-hero-subtitle">Last Updated: January 1, 2026</p>
        </div>
    </section>

    <!-- Cookies at a Glance Section -->
    <section class="cookies-intro">
        <div class="container">
            <div class="intro-content">
                <h2>Cookies at a Glance</h2>
                <p>ReadyAimRetire uses cookies and similar tracking technologies to provide you with the best possible experience when using our website and OnTarget™ platform. This Cookie Policy explains what cookies are, how we use them, and how you can manage your cookie preferences.</p>
                <p>By continuing to use our website, you consent to our use of cookies as described in this policy. You can withdraw your consent at any time by adjusting your browser settings or using our cookie management tools.</p>
            </div>
        </div>
    </section>

    <!-- Section 1: What Are Cookies? -->
    <section class="cookie-section">
        <div class="container">
            <div class="section-content">
                <h2 class="section-number">1. What Are Cookies?</h2>
                <p>Cookies are small text files that are placed on your computer or mobile device when you visit a website. They are widely used to make websites work more efficiently, improve user experience, and provide information to website owners.</p>
                <p>Cookies typically contain the following information:</p>
                <ul>
                    <li>The name of the website that placed the cookie</li>
                    <li>A unique identifier for your device or browser</li>
                    <li>The expiration date of the cookie</li>
                    <li>Small amounts of data related to your interaction with the website</li>
                </ul>
                <p>Cookies can be "persistent" (remaining on your device until they expire or you delete them) or "session" cookies (deleted automatically when you close your browser).</p>
            </div>
        </div>
    </section>

    <!-- Section 2: Types of Cookies We Use -->
    <section class="cookie-section alternate">
        <div class="container">
            <div class="section-content">
                <h2 class="section-number">2. Types of Cookies We Use</h2>
                <p>We use several categories of cookies on our website and OnTarget™ platform. Below is a detailed breakdown of each type:</p>

                <div class="cookie-type-card">
                    <div class="cookie-type-header">
                        <h3>Essential Cookies</h3>
                        <span class="cookie-badge required">Required</span>
                    </div>
                    <p>These cookies are strictly necessary for the operation of our website and platform. They enable core functionality such as user authentication, session management, and security features. Without these cookies, we cannot provide our services.</p>
                    <div class="cookie-examples">
                        <h4>Examples:</h4>
                        <table class="cookie-table">
                            <thead>
                                <tr>
                                    <th>Cookie Name</th>
                                    <th>Purpose</th>
                                    <th>Duration</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><code>session_id</code></td>
                                    <td>Maintains your logged-in state</td>
                                    <td>Session</td>
                                </tr>
                                <tr>
                                    <td><code>csrf_token</code></td>
                                    <td>Protects against cross-site request forgery attacks</td>
                                    <td>Session</td>
                                </tr>
                                <tr>
                                    <td><code>auth_token</code></td>
                                    <td>Authenticates your identity</td>
                                    <td>30 days</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="cookie-type-card">
                    <div class="cookie-type-header">
                        <h3>Performance Cookies</h3>
                        <span class="cookie-badge optional">Optional</span>
                    </div>
                    <p>These cookies collect information about how visitors use our website, such as which pages are visited most often and whether users receive error messages. This information helps us improve our website's performance and user experience.</p>
                    <div class="cookie-examples">
                        <h4>Examples:</h4>
                        <table class="cookie-table">
                            <thead>
                                <tr>
                                    <th>Cookie Name</th>
                                    <th>Purpose</th>
                                    <th>Duration</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><code>_ga</code></td>
                                    <td>Google Analytics - distinguishes users</td>
                                    <td>2 years</td>
                                </tr>
                                <tr>
                                    <td><code>_gid</code></td>
                                    <td>Google Analytics - distinguishes users</td>
                                    <td>24 hours</td>
                                </tr>
                                <tr>
                                    <td><code>_gat</code></td>
                                    <td>Google Analytics - throttles request rate</td>
                                    <td>1 minute</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="cookie-type-card">
                    <div class="cookie-type-header">
                        <h3>Functional Cookies</h3>
                        <span class="cookie-badge optional">Optional</span>
                    </div>
                    <p>These cookies allow our website to remember choices you make (such as your preferred language, region, or display settings) and provide enhanced, personalized features. They may also be used to provide services you have requested, such as watching a video or commenting on a blog.</p>
                    <div class="cookie-examples">
                        <h4>Examples:</h4>
                        <table class="cookie-table">
                            <thead>
                                <tr>
                                    <th>Cookie Name</th>
                                    <th>Purpose</th>
                                    <th>Duration</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><code>user_preferences</code></td>
                                    <td>Stores your display and accessibility preferences</td>
                                    <td>1 year</td>
                                </tr>
                                <tr>
                                    <td><code>language</code></td>
                                    <td>Remembers your preferred language</td>
                                    <td>1 year</td>
                                </tr>
                                <tr>
                                    <td><code>theme</code></td>
                                    <td>Remembers your theme preference (light/dark mode)</td>
                                    <td>1 year</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="cookie-type-card">
                    <div class="cookie-type-header">
                        <h3>Advertising Cookies</h3>
                        <span class="cookie-badge optional">Optional</span>
                    </div>
                    <p>These cookies are used to deliver advertisements that are relevant to you and your interests. They may also be used to limit the number of times you see an advertisement and help measure the effectiveness of advertising campaigns. We work with trusted third-party advertising partners who may place these cookies.</p>
                    <div class="cookie-examples">
                        <h4>Examples:</h4>
                        <table class="cookie-table">
                            <thead>
                                <tr>
                                    <th>Cookie Name</th>
                                    <th>Purpose</th>
                                    <th>Duration</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><code>_fbp</code></td>
                                    <td>Facebook Pixel - tracks conversions from ads</td>
                                    <td>90 days</td>
                                </tr>
                                <tr>
                                    <td><code>IDE</code></td>
                                    <td>Google DoubleClick - serves targeted ads</td>
                                    <td>1 year</td>
                                </tr>
                                <tr>
                                    <td><code>fr</code></td>
                                    <td>Facebook - delivers and measures ads</td>
                                    <td>90 days</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 3: Third-Party Cookies -->
    <section class="cookie-section">
        <div class="container">
            <div class="section-content">
                <h2 class="section-number">3. Third-Party Cookies</h2>
                <p>In addition to our own cookies, we use various third-party services that may set cookies on your device. These third parties include:</p>

                <div class="third-party-list">
                    <div class="third-party-item">
                        <h4>Google Analytics</h4>
                        <p>We use Google Analytics to understand how users interact with our website. Google Analytics uses cookies to collect information about your usage in an anonymous form. For more information, see <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Google's Privacy Policy</a>.</p>
                    </div>

                    <div class="third-party-item">
                        <h4>Google Ads & DoubleClick</h4>
                        <p>We use Google Ads and DoubleClick to display targeted advertisements and measure campaign effectiveness. These services use cookies to track your browsing activity across websites. Learn more at <a href="https://policies.google.com/technologies/ads" target="_blank" rel="noopener noreferrer">Google's Ad Settings</a>.</p>
                    </div>

                    <div class="third-party-item">
                        <h4>Facebook Pixel</h4>
                        <p>We use Facebook Pixel to measure the effectiveness of our advertising on Facebook and Instagram. This tool uses cookies to track conversions and build targeted audiences. Visit <a href="https://www.facebook.com/privacy/policy" target="_blank" rel="noopener noreferrer">Facebook's Privacy Policy</a> for more information.</p>
                    </div>

                    <div class="third-party-item">
                        <h4>Content Delivery Networks (CDNs)</h4>
                        <p>We use CDNs such as Cloudflare to deliver website content efficiently. These services may set cookies to optimize content delivery and protect against malicious activity.</p>
                    </div>
                </div>

                <p class="important-note"><strong>Important:</strong> We do not control third-party cookies. These cookies are governed by the privacy policies of the respective third parties. We recommend reviewing their privacy policies to understand how they collect and use your information.</p>
            </div>
        </div>
    </section>

    <!-- Section 4: Managing Cookies -->
    <section class="cookie-section alternate">
        <div class="container">
            <div class="section-content">
                <h2 class="section-number">4. Managing Cookies</h2>
                <p>You have the right to decide whether to accept or reject cookies. You can exercise your cookie preferences through the following methods:</p>

                <h3>Browser Settings</h3>
                <p>Most web browsers allow you to control cookies through their settings. You can set your browser to refuse cookies or delete certain cookies. The following links provide instructions for managing cookies in popular browsers:</p>

                <ul class="browser-links">
                    <li><a href="https://support.google.com/chrome/answer/95647" target="_blank" rel="noopener noreferrer">Google Chrome</a></li>
                    <li><a href="https://support.mozilla.org/en-US/kb/enhanced-tracking-protection-firefox-desktop" target="_blank" rel="noopener noreferrer">Mozilla Firefox</a></li>
                    <li><a href="https://support.apple.com/guide/safari/manage-cookies-sfri11471/mac" target="_blank" rel="noopener noreferrer">Safari</a></li>
                    <li><a href="https://support.microsoft.com/en-us/microsoft-edge/delete-cookies-in-microsoft-edge-63947406-40ac-c3b8-57b9-2a946a29ae09" target="_blank" rel="noopener noreferrer">Microsoft Edge</a></li>
                    <li><a href="https://help.opera.com/en/latest/web-preferences/#cookies" target="_blank" rel="noopener noreferrer">Opera</a></li>
                </ul>

                <h3>Opt-Out Tools</h3>
                <p>You can opt out of certain third-party advertising cookies using the following industry tools:</p>
                <ul>
                    <li><a href="http://optout.networkadvertising.org/" target="_blank" rel="noopener noreferrer">Network Advertising Initiative (NAI)</a></li>
                    <li><a href="http://optout.aboutads.info/" target="_blank" rel="noopener noreferrer">Digital Advertising Alliance (DAA)</a></li>
                    <li><a href="https://youronlinechoices.eu/" target="_blank" rel="noopener noreferrer">Your Online Choices (EU)</a></li>
                </ul>

                <h3>Google Analytics Opt-Out</h3>
                <p>You can prevent Google Analytics from recognizing you on return visits by downloading and installing the <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer">Google Analytics Opt-out Browser Add-on</a>.</p>

                <div class="warning-box">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <div>
                        <h4>Impact of Disabling Cookies</h4>
                        <p>Please note that if you choose to block or delete essential cookies, certain features of our website and OnTarget™ platform may not function properly. You may not be able to log in, save your preferences, or access certain areas of the site. Functional and performance cookies are optional, but disabling them may result in a less personalized experience.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 5: GDPR Cookie Rights -->
    <section class="cookie-section">
        <div class="container">
            <div class="section-content">
                <h2 class="section-number">5. GDPR Cookie Rights (EU & UK Residents)</h2>
                <p>If you are a resident of the European Union (EU) or United Kingdom (UK), you have specific rights under the General Data Protection Regulation (GDPR) regarding cookies and personal data:</p>

                <div class="rights-grid">
                    <div class="right-card">
                        <div class="right-icon">
                            <i class="fa-solid fa-circle-info"></i>
                        </div>
                        <h4>Right to Information</h4>
                        <p>You have the right to be informed about how cookies are used to collect and process your personal data.</p>
                    </div>

                    <div class="right-card">
                        <div class="right-icon">
                            <i class="fa-solid fa-hand"></i>
                        </div>
                        <h4>Right to Consent</h4>
                        <p>We must obtain your explicit consent before placing non-essential cookies on your device. You can withdraw consent at any time.</p>
                    </div>

                    <div class="right-card">
                        <div class="right-icon">
                            <i class="fa-solid fa-file-export"></i>
                        </div>
                        <h4>Right to Access</h4>
                        <p>You can request a copy of the personal data we have collected about you through cookies.</p>
                    </div>

                    <div class="right-card">
                        <div class="right-icon">
                            <i class="fa-solid fa-trash"></i>
                        </div>
                        <h4>Right to Erasure</h4>
                        <p>You have the right to request deletion of your personal data collected through cookies, subject to certain exceptions.</p>
                    </div>
                </div>

                <p>To exercise any of these rights, please contact us at <a href="mailto:privacy@readyaimretire.com">privacy@readyaimretire.com</a>. We will respond to your request within 30 days as required by GDPR.</p>
            </div>
        </div>
    </section>

    <!-- Section 6: CCPA / CPRA Cookie Rights -->
    <section class="cookie-section alternate">
        <div class="container">
            <div class="section-content">
                <h2 class="section-number">6. CCPA / CPRA Cookie Rights (California Residents)</h2>
                <p>If you are a California resident, you have specific rights under the California Consumer Privacy Act (CCPA) and California Privacy Rights Act (CPRA) regarding cookies and personal information:</p>

                <ul class="california-rights">
                    <li>
                        <strong>Right to Know:</strong> You have the right to know what personal information we collect through cookies, how it is used, and whether it is sold or shared.
                    </li>
                    <li>
                        <strong>Right to Delete:</strong> You can request deletion of personal information collected through cookies, subject to certain exceptions.
                    </li>
                    <li>
                        <strong>Right to Opt-Out:</strong> You have the right to opt out of the "sale" or "sharing" of your personal information, which may include certain cookie-based tracking. Click the "Do Not Sell or Share My Personal Information" link in our website footer to exercise this right.
                    </li>
                    <li>
                        <strong>Right to Limit:</strong> You can limit the use of your sensitive personal information collected through cookies.
                    </li>
                    <li>
                        <strong>Right to Non-Discrimination:</strong> We will not discriminate against you for exercising your privacy rights.
                    </li>
                </ul>

                <div class="do-not-sell-box">
                    <i class="fa-solid fa-shield-halved"></i>
                    <div>
                        <h4>Do Not Sell or Share My Personal Information</h4>
                        <p>We do not sell your personal information in the traditional sense. However, the use of certain advertising cookies may be considered a "sale" or "sharing" under California law. To opt out of this activity, adjust your cookie preferences using the tools described in Section 4 or contact us at <a href="mailto:privacy@readyaimretire.com">privacy@readyaimretire.com</a>.</p>
                    </div>
                </div>

                <p>For more information about your California privacy rights, please see our <a href="/privacy">Privacy Policy</a> or contact us at <a href="mailto:privacy@readyaimretire.com">privacy@readyaimretire.com</a>.</p>
            </div>
        </div>
    </section>

    <!-- Section 7: Changes to This Cookie Policy -->
    <section class="cookie-section">
        <div class="container">
            <div class="section-content">
                <h2 class="section-number">7. Changes to This Cookie Policy</h2>
                <p>We may update this Cookie Policy from time to time to reflect changes in our practices, technologies, legal requirements, or other factors. When we make changes, we will:</p>
                <ul>
                    <li>Update the "Last Updated" date at the top of this policy</li>
                    <li>Notify you of material changes through a prominent notice on our website</li>
                    <li>In some cases, send you an email notification (if we have your email address)</li>
                </ul>
                <p>We encourage you to review this Cookie Policy periodically to stay informed about how we use cookies. Your continued use of our website after changes are posted constitutes your acceptance of the updated policy.</p>
            </div>
        </div>
    </section>

    <!-- Section 8: Contact Us -->
    <section class="cookie-section alternate">
        <div class="container">
            <div class="section-content">
                <h2 class="section-number">8. Contact Us</h2>
                <p>If you have any questions, concerns, or requests regarding this Cookie Policy or our use of cookies, please don't hesitate to contact us:</p>

                <div class="contact-details">
                    <div class="contact-method">
                        <i class="fa-solid fa-envelope"></i>
                        <div>
                            <h4>Email</h4>
                            <p><a href="mailto:privacy@readyaimretire.com">privacy@readyaimretire.com</a></p>
                        </div>
                    </div>

                    <div class="contact-method">
                        <i class="fa-solid fa-location-dot"></i>
                        <div>
                            <h4>Mailing Address</h4>
                            <p>
                                ReadyAimRetire, LLC<br>
                                Attn: Privacy Team<br>
                                123 Financial Way, Suite 400<br>
                                San Francisco, CA 94104<br>
                                United States
                            </p>
                        </div>
                    </div>

                    <div class="contact-method">
                        <i class="fa-solid fa-phone"></i>
                        <div>
                            <h4>Phone</h4>
                            <p>(555) 123-4567<br>Monday - Friday, 9:00 AM - 5:00 PM PT</p>
                        </div>
                    </div>
                </div>

                <p>We are committed to resolving any concerns you may have about our use of cookies and protecting your privacy. We will respond to all inquiries within 30 days.</p>
            </div>
        </div>
    </section>

    <!-- CTA Banner -->
    <CTABanner />
</BaseLayout>

<style>
    /* Cookies Hero Section */
    .cookies-hero {
        background: linear-gradient(135deg, #415776 0%, #2a3f5f 100%);
        padding: 8rem 0 3rem 0;
        text-align: center;
    }

    .cookies-hero-title {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: clamp(2.5rem, 5vw, 3.5rem);
        font-weight: 400;
        color: #ffffff;
        margin: 0 0 0.75rem 0;
        line-height: 1.2;
    }

    .cookies-hero-subtitle {
        font-size: 1.1rem;
        color: rgba(255, 255, 255, 0.75);
        margin: 0;
        font-style: italic;
    }

    /* Intro Section */
    .cookies-intro {
        background: #ffffff;
        padding: 4rem 0;
        border-bottom: 1px solid #e2e8f0;
    }

    .intro-content {
        max-width: 800px;
        margin: 0 auto;
    }

    .intro-content h2 {
        font-family: 'Inter', sans-serif;
        font-size: 1.75rem;
        font-weight: 600;
        color: #1a1a2e;
        margin: 0 0 1.25rem 0;
    }

    .intro-content p {
        font-size: 1rem;
        line-height: 1.8;
        color: #4a5568;
        margin: 0 0 1rem 0;
    }

    .intro-content p:last-child {
        margin-bottom: 0;
    }

    /* Cookie Sections */
    .cookie-section {
        background: #f8fafc;
        padding: 4rem 0;
    }

    .cookie-section.alternate {
        background: #ffffff;
    }

    .section-content {
        max-width: 900px;
        margin: 0 auto;
    }

    .section-number {
        font-family: 'Inter', sans-serif;
        font-size: 1.85rem;
        font-weight: 700;
        color: #1a1a2e;
        margin: 0 0 1.5rem 0;
        padding-bottom: 0.75rem;
        border-bottom: 3px solid var(--color-primary);
    }

    .section-content h3 {
        font-family: 'Inter', sans-serif;
        font-size: 1.35rem;
        font-weight: 600;
        color: #1a1a2e;
        margin: 2rem 0 1rem 0;
    }

    .section-content h4 {
        font-family: 'Inter', sans-serif;
        font-size: 1.1rem;
        font-weight: 600;
        color: #1a1a2e;
        margin: 1.5rem 0 0.75rem 0;
    }

    .section-content p {
        font-size: 1rem;
        line-height: 1.8;
        color: #4a5568;
        margin: 0 0 1.25rem 0;
    }

    .section-content ul {
        margin: 1rem 0 1.5rem 0;
        padding-left: 1.5rem;
        color: #4a5568;
    }

    .section-content ul li {
        margin-bottom: 0.75rem;
        line-height: 1.7;
    }

    .section-content a {
        color: var(--color-primary);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.2s ease;
    }

    .section-content a:hover {
        color: var(--color-primary-hover);
        text-decoration: underline;
    }

    /* Cookie Type Cards */
    .cookie-type-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    }

    .cookie-section.alternate .cookie-type-card {
        background: #f8fafc;
    }

    .cookie-type-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .cookie-type-header h3 {
        margin: 0;
        font-size: 1.35rem;
    }

    .cookie-badge {
        padding: 0.35rem 0.85rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .cookie-badge.required {
        background: #fef2f2;
        color: #dc2626;
    }

    .cookie-badge.optional {
        background: #f0fdf4;
        color: #16a34a;
    }

    .cookie-type-card > p {
        margin: 0 0 1.5rem 0;
    }

    .cookie-examples h4 {
        font-size: 0.95rem;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: 0 0 1rem 0;
    }

    /* Cookie Table */
    .cookie-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
        margin-top: 0.5rem;
    }

    .cookie-table thead {
        background: #f1f5f9;
    }

    .cookie-table th {
        text-align: left;
        padding: 0.85rem 1rem;
        font-weight: 600;
        color: #1a1a2e;
        border-bottom: 2px solid #e2e8f0;
    }

    .cookie-table td {
        padding: 0.85rem 1rem;
        color: #4a5568;
        border-bottom: 1px solid #e2e8f0;
    }

    .cookie-table tbody tr:last-child td {
        border-bottom: none;
    }

    .cookie-table code {
        background: #f1f5f9;
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        font-family: 'Courier New', monospace;
        font-size: 0.85rem;
        color: #0f172a;
    }

    /* Third-Party List */
    .third-party-list {
        margin: 2rem 0;
    }

    .third-party-item {
        margin-bottom: 2rem;
        padding-left: 1.5rem;
        border-left: 3px solid var(--color-primary);
    }

    .third-party-item h4 {
        margin-top: 0;
        color: #1a1a2e;
    }

    .third-party-item p {
        margin-bottom: 0;
    }

    .important-note {
        background: #fef3c7;
        border-left: 4px solid #f59e0b;
        padding: 1.25rem 1.5rem;
        margin: 2rem 0 0 0;
        border-radius: 6px;
        font-size: 0.95rem;
    }

    /* Browser Links */
    .browser-links {
        list-style: none;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 0.75rem;
