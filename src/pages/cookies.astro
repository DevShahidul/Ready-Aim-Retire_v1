---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { render } from "astro:content";
import CommonHero from "../components/CommonHero.astro";
import HeroDivider from "../components/HeroDivider.astro";
import CTABanner from "../components/CTABanner.astro";
const cookieData = await getEntry("cookiePage", "cookie-policy");
if (!cookieData) {
    throw new Error("cookie policy page not found");
}
const { Content } = await render(cookieData);
---

<BaseLayout
    title="Cookie Policy – ReadyAimRetire"
    description="Learn about how ReadyAimRetire uses cookies to improve your experience on our website."
    solidHeader={true}
>
    <CommonHero title={cookieData?.data.title} />
    <HeroDivider text={cookieData?.data.lastUpdated} />
    <section class="container">
        <Content />
    </section>
    <CTABanner />
</BaseLayout>
