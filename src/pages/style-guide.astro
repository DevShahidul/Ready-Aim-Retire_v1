                        <div class="typography-group">
                            <h3>Heading Styles</h3>
                            <div class="type-scale">
                                <div class="type-item">
                                    <span class="type-label"
                                        >Hero / Display</span
                                    >
                                    <p class="type-demo heading-hero">
                                        Ready Aim Retire
                                    </p>
