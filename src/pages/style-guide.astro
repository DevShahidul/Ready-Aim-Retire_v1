                                    <div class="color-info">
                                        <span class="color-name">Border</span>
                                        <code>#D1D1D1</code>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="color-group">
                            <h3>Text Colors</h3>
                            <div class="color-grid">
                                <div class="color-swatch">
                                    <div
                                        class="color-preview"
                                        style="background-color: #2E2E2E;"
