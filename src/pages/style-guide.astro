                                </div>
                            </div>
                        </div>

                        <div class="typography-group">
                            <h3>Font Sizes Scale</h3>
                            <div class="type-scale">
                                <div class="type-item">
                                    <span class="type-label">text-xs</span>
                                    <p
                                        class="type-demo"
                                        style="font-size: var(--text-xs);"
                                    >
                                        The quick brown fox
                                    </p>
                                    <code>0.75rem / 12px</code>
                                </div>
                                <div class="type-item">
                                    <span class="type-label">text-sm</span>
                                    <p
