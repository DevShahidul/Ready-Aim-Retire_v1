                                </div>
                                <div class="type-item">
                                    <span class="type-label">Heading 5</span>
                                    <p class="type-demo heading-5">
                                        Income & Spending
                                    </p>
                                    <code>1.125rem / 18px - Semibold</code>
                                </div>
                                <div class="type-item">
                                    <span class="type-label">Heading 6</span>
                                    <p class="type-demo heading-6">
                                        Financial Planning
                                    </p>
                                    <code>1.0625rem / 17px - Semibold</code>
                                </div>
                                <div class="type-item">
                                    <span class="type-label"
                                        >Heading 7 (100px)</span
