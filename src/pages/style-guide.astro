                                </div>
                            </div>
                        </div>

                        <div class="color-group">
                            <h3>Secondary Colors</h3>
                            <div class="color-grid">
                                <div class="color-swatch">
                                    <div
                                        class="color-preview"
                                        style="background-color: #415776;"
                                    >
                                    </div>
                                    <div class="color-info">
