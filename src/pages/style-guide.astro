                <div class="style-grid-2col">
                    <!-- Buttons Section -->
                    <section class="style-section">
                        <h2>Buttons</h2>

                        <div class="component-group">
                            <h3>Primary Button</h3>
                            <div class="component-demo">
                                <button class="btn btn-primary"
                                    >Get Started</button
                                >
                                <button class="btn btn-primary"
                                    >Subscribe</button
                                >
