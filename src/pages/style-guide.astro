                    <!-- Typography Section -->
                    <section class="style-section">
                        <h2>Typography</h2>

                        <div class="typography-group">
                            <h3>Font Family</h3>
                            <div class="font-family-demo">
                                <div class="font-sample">
                                    <span class="font-name">Primary Font</span>
                                    <p
                                        class="font-demo"
                                        style="font-family: 'Geist', sans-serif;"
                                    >
                                        Geist - The quick brown fox jumps over
                                        the lazy dog
                                    </p>
                                </div>
                                <div class="font-sample">
                                    <span class="font-name">Serif Font</span>
                                    <p
                                        class="font-demo"
                                        style="font-family: 'Playfair Display', Georgia, serif;"
