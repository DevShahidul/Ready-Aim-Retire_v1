---
const { cards } = Astro.props;
type Card = {
    id?: number;
    isPrimary?: boolean;
    title?: string;
    subtitle?: string;
    description?: string;
    list?: string[];
    bottomText?: string;
    buttonText?: string;
};
---

<section class="container faq-cards-wrapper">
    {
        cards.map((card: Card) => (
            <div class={`faqs-card ${card.isPrimary ? "primary" : ""}`}>
                <h2>{card.title}</h2>
                {card.subtitle && <p>{card.subtitle}</p>}
                {card.description && <p set:html={card.description} />}
                {card.list && (
                    <ul class="bullet-list">
                        {card.list.map((item) => (
                            <li>{item}</li>
                        ))}
                    </ul>
                )}
                {card.bottomText && <p>{card.bottomText}</p>}
                {card.buttonText && (
                    <a href="#" class="btn btn-dark">
                        {card.buttonText} <i class="fas fa-arrow-right" />
                    </a>
                )}
            </div>
        ))
    }
</section>

<style>
    .faq-cards-wrapper {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: clamp(1rem, 0.225rem + 3.875vw, 4.875rem);
        margin-top: clamp(1.875rem, 1.3125rem + 2.8125vw, 4.6875rem);
        margin-bottom: clamp(1.875rem, 0.375rem + 7.5vw, 9.375rem);
    }

    .faqs-card {
        padding: 3.4375rem 3.75rem 1.875rem 3rem;
        background-color: #fff;
        border-radius: 0.625rem;
        color: #2e2e2e;
        h2 {
            font-size: 1.5625rem;
            line-height: 1;
            font-weight: 500;
        }
        p {
            font-size: 1.0625rem;
            margin-top: 1.8rem;
        }
        ul {
            margin-top: 1.8rem;
            li {
                font-size: 1.0625rem;
                color: #2e2e2e;
            }
        }
        .btn-dark {
            margin-top: 1.8rem;
        }
    }

    .faqs-card.primary {
        background-color: #41bab4;
        color: #fff;
        ul li {
            color: #fff;
        }
        ul li:before {
            color: #fff;
        }
    }
</style>
