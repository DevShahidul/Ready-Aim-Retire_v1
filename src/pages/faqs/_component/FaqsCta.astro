---
const { ctaData } = Astro.props;
---

<section class="container">
    <div class="faqs-cta">
        <div class="faqs-cta-heading">
            <img src="/images/icons/round-arrow.png" />
            <h2 set:html={ctaData.heading} />
        </div>
        <div>
            <h3>{ctaData.title}</h3>
            <p>{ctaData.subtitle}</p>
            <p>{ctaData.description}</p>
            <p>{ctaData.bottomText}</p>
        </div>
    </div>
</section>

<style>
    .faqs-cta {
        padding: 3.75rem 2.1875rem 3.4375rem 3.875rem;
        border-radius: 0.625rem;
        background-color: #41bab4;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
        align-items: start;
        color: #fff;
        margin: clamp(1.875rem, 1.1rem + 3.875vw, 5.75rem) 0rem;

        img {
            width: 4rem;
            height: 4rem;
        }

        h2 {
            font-size: 3rem;
            line-height: 1;
            font-weight: 400;
        }

        h3 {
            font-size: 1.5625rem;
        }

        p {
            font-size: 1.0625rem;
            margin-top: 1.6rem;
        }
    }

    .faqs-cta-heading {
        display: flex;
        align-items: start;
        gap: 2.25rem;
    }

    @media (max-width: 1024px) {
        .faqs-cta {
            grid-template-columns: 1fr;
            gap: 1.5rem;
            padding: 2.5rem;
        }

        .faqs-cta-heading {
            gap: 1.5rem;

            img {
                width: 3rem;
                height: 3rem;
            }

            h2 {
                font-size: 2.25rem;
            }
        }
    }

    @media (max-width: 768px) {
        .faqs-cta {
            padding: 2rem 1.5rem;
        }

        .faqs-cta-heading {
            flex-direction: column;
            gap: 1rem;

            img {
                width: 2.5rem;
                height: 2.5rem;
            }

            h2 {
                font-size: 1.75rem;
            }
        }

        .faqs-cta h3 {
            font-size: 1.25rem;
        }

        .faqs-cta p {
            font-size: 1rem;
            margin-top: 1rem;
        }
    }

    @media (max-width: 480px) {
        .faqs-cta {
            padding: 1.5rem 1.25rem;
        }

        .faqs-cta-heading img {
            width: 2rem;
            height: 2rem;
        }

        .faqs-cta-heading h2 {
            font-size: 1.5rem;
        }

        .faqs-cta h3 {
            font-size: 1.125rem;
        }

        .faqs-cta p {
            font-size: 0.9375rem;
            margin-top: 0.875rem;
        }
    }
</style>
