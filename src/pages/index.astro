---
import BaseLayout from "../layouts/BaseLayout.astro";
import Testimonials from "../components/Testimonials.astro";
import CTABanner from "../components/CTABanner.astro";
import Blogs from "../components/Blogs.astro";
import Newsletter from "../components/Newsletter.astro";
---

<BaseLayout
    title="ReadyAimRetire – Visualize Your Retirement"
    description="Plan your retirement with confidence. Adjust income, spending, and market assumptions and instantly see the impact with ReadyAimRetire."
>
    <!-- Hero Section -->
    <section class="hero" id="home">
        <div class="container" data-aos="fade" data-aos-delay="200">
            <h1 id="hero-title">Visualize your<br />retirement</h1>
            <p class="hero-tagline-text">
                Clearly, confidently, all in one place
            </p>
            <p id="hero-subtitle">
                Ready Aim Retire offers the easiest way to model, visualize, and
                stress-test your retirement plan – whether you're just starting
                to think about retirement or fine-tuning a detailed plan. Take
                aim at your retirement with OnTarget™.
            </p>
            <a
                href={`${import.meta.env.PUBLIC_APP_URL}/signup`}
                id="hero-btn"
                class="btn btn-hero"
                >Start Your Plan <span class="arrow">
                    <i class="fa-solid fa-arrow-right"></i>
                </span></a
            >
        </div>
    </section>

    <!-- Hero App Screenshot -->
    <section class="hero-screenshot">
        <div
            class="container"
            data-aos="fade-up"
            data-aos-delay="400"
            data-aos-duration="1200"
        >
            <img
                class="hero-img"
                src="/images/hero-screenshot.png"
                alt="ReadyAimRetire app screenshot"
            />
        </div>
    </section>

    <div>
        <!-- OnTarget Section -->
        <section class="ontarget-section">
            <div class="container">
                <div class="ontarget-header" data-aos="fade-up">
                    <img
                        src="/images/logos/ontarget/ontarget_black_green.png"
                        alt="OnTarget™ by Ready Aim Retire"
                        class="ontarget-logo"
                    />
                </div>
                <div
                    class="ontarget-cards"
                    data-aos="fade-up"
                    data-aos-delay="100"
                >
                    <div
                        class="ontarget-card ontarget-card-highlight"
                        data-id="holistic"
                    >
                        <h3>Holistic Timeline</h3>
                        <p>
                            Watch your financial life unfold year by year –
                            accumulation, retirement, and beyond.
                        </p>
                    </div>
                    <div class="ontarget-card" data-id="scenario">
                        <h3>Scenario Planning</h3>
                        <p>
                            What if you retire earlier? Spend more? Markets
                            underperform? Adjust assumptions and instantly see
                            the long and short term impact.
                        </p>
                    </div>
                    <div class="ontarget-card" data-id="income">
                        <h3>Income & Spending Clarity</h3>
                        <p>
                            Understand where your money comes from and where it
                            goes – before and after retirement.
                        </p>
                    </div>
                    <div class="ontarget-card" data-id="stress">
                        <h3>Stress Test Your Plan</h3>
                        <p>
                            Run your plan through historical market data. More
                            certainty comes from better insight.
                        </p>
                    </div>
                    <div class="ontarget-card" data-id="taxes">
                        <h3>Maximize Taxes & Benefits</h3>
                        <p>
                            See taxes and social security as part of the plan –
                            that fits into long-term sustainability.
                        </p>
                    </div>
                </div>

                <!-- Interactive Animation Demo (commented out) -->
                <!-- <div class="animation-demo" data-aos="fade-up" data-aos-delay="200">
                   <MonthlySpendingAnimation />
               </div> -->
            </div>
        </section>

        <!-- Complete Retirement Planning System Section -->
        <section class="complete-system-section muted-border" id="holistic">
            <div class="container feature" data-aos="fade-up">
                <div class="feature-text">
                    <h3>Holistic Timeline</h3>
                    <h2>
                        Complete retirement planning system – built to show the <span
                            class="text-teal">full picture</span
                        >
                    </h2>
                    <p>
                        OnTarget™ isn't a collection of disconnected accounts
                        and assumptions. It's a <strong
                            >holistic planning</strong
                        > environment that models your entire financial life – before,
                        during, and throughout retirement.
                    </p>
                    <p>Everything connects. Nothing lives in isolation.</p>
                    <a
                        href={`${import.meta.env.PUBLIC_APP_URL}/signup`}
                        class="btn btn-dark"
                    >
                        Start Planning
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                </div>
                <div class="feature-img">
                    <img
                        src="/images/feature-img1.jpg"
                        alt="Tax strategy chart"
                    />
                </div>
            </div>
        </section>

        <!-- Features Section 1 - Unlimited Scenarios -->
        <section class="section-gray muted-border" id="scenario">
            <div class="container feature" data-aos="fade-right">
                <div class="feature-img">
                    <img
                        src="/images/feature-img2.png"
                        alt="Tax strategy chart"
                    />
                </div>
                <div class="feature-text">
                    <h3>Scenario Planning</h3>
                    <h2>
                        Unlimited scenarios, unlimited <span class="text-teal"
                            >flexibility</span
                        >
                    </h2>
                    <p>
                        Model real life – not perfect assumptions. Life changes,
                        your plan should be able to change with it. OnTarget™
                        allows you to create, save, and compare <strong
                            >unlimited scenarios</strong
                        >, such as:
                    </p>
                    <ul class="feature-list">
                        <li>Retiring earlier or later</li>
                        <li>Spending more or less</li>
                        <li>Market underperformance or outperformance</li>
                        <li>Major purchases or windfalls</li>
                        <li>Health events or lifestyle changes</li>
                    </ul>
                    <p class="">
                        Explore "what if?" scenarios without fear of breaking
                        your plan.
                    </p>
                    <a
                        href={`${import.meta.env.PUBLIC_APP_URL}/signup`}
                        class="btn btn-dark"
                        style="margin-top: 1.5rem;"
                        >Try for free <span class="arrow">
                            <i class="fa-solid fa-arrow-right"></i>
                        </span></a
                    >
                </div>
            </div>
        </section>

        <!-- Features Section 2 - Budget Planning -->
        <section class="muted-border" id="income">
            <div class="container feature" data-aos="fade-left">
                <div class="feature-text">
                    <h3>Income & Spending Clarity</h3>
                    <h2>
                        Build a detailed retirement budget with <span
                            class="text-teal">smarter</span
                        > retirement withdrawals
                    </h2>
                    <p>
                        Know what retirement actually costs. Create a detailed, <strong
                            >realistic budget</strong
                        > for your retirement years – and adjust it as life evolves.
                        Strategize how and when to withdraw from your accounts to
                        support <strong>long-term longevity</strong>.
                    </p>
                    <ul class="feature-checklist">
                        <li>
                            <img src="/images/icons/feature-list-check.svg" />
                            Different withdrawal strategies
                        </li>
                        <li>
                            <img src="/images/icons/feature-list-check.svg" />
                            Account sequencing
                        </li>
                        <li>
                            <img src="/images/icons/feature-list-check.svg" />
                            The impact of taxes and timing
                        </li>
                        <li>
                            <img src="/images/icons/feature-list-check.svg" />
                            Make your money last – Intentionally
                        </li>
                    </ul>
                    <p class="">
                        Small decisions can have large long-term consequences.
                        OnTarget™ helps you see them clearly.
                    </p>
                    <a
                        href={`${import.meta.env.PUBLIC_APP_URL}/signup`}
                        class="btn btn-dark"
                        style="margin-top: 1.5rem;"
                        >Start Planning <span class="arrow">
                            <i class="fa-solid fa-arrow-right"></i>
                        </span></a
                    >
                </div>
                <div class="feature-img">
                    <img
                        src="/images/feature-img1.jpg"
                        alt="Tax strategy chart"
                    />
                </div>
            </div>
        </section>

        <!-- Features Section 3 - Confidence from Pressure Testing -->
        <section class="section-gray muted-border" id="stress">
            <div class="container feature" data-aos="fade-right">
                <div class="feature-img">
                    <img
                        src="/images/feature-img2.png"
                        alt="Stress testing visualization"
                    />
                </div>
                <div class="feature-text">
                    <h3>Stress-Test Your Plan</h3>
                    <h2>
                        <span class="text-teal">Confidence</span> comes from pressure-testing
                    </h2>
                    <p>
                        Explore how your retirement plan could perform under
                        various economic conditions. OnTarget™ uses <strong
                            >Monte Carlo simulations</strong
                        > to model thousands of scenarios, delivering realistic insights
                        rather than misleading presumptions.
                    </p>
                    <p>Stress testing helps you:</p>
                    <ul class="feature-list">
                        <li>Understand risk, not fear it</li>
                        <li>See potential weak points</li>
                        <li>Make adjustments before compromising</li>
                    </ul>
                    <a
                        href={`${import.meta.env.PUBLIC_APP_URL}/signup`}
                        class="btn btn-dark"
                        style="margin-top: 1.5rem;"
                        >Try for free <span class="arrow">
                            <i class="fa-solid fa-arrow-right"></i>
                        </span></a
                    >
                </div>
            </div>
        </section>
    </div>
    <!-- Features Section 4 - Tax Strategy -->
    <section id="taxes">
        <div class="container feature" data-aos="fade-left">
            <div class="feature-text">
                <h3>Maximise Taxes & Benefits</h3>
                <h2>
                    Navigate taxes with <span class="text-teal">clarity</span> and
                    <span class="text-teal">plan</span> for Social Security with confidence
                </h2>
                <p>
                    <strong>Taxes matter</strong> – especially in retirement. OnTarget™
                    helps you plan across all major account types, including tax-deferred,
                    tax-free, and taxable accounts.
                </p>
                <p>
                    Model Social Security collection strategies and see how <strong
                        >timing</strong
                    > impacts your retirement income and overall plan. Uncover how
                    benefits integrate with other income sources and the tradeoffs
                    of claiming earlier vs later.
                </p>
                <a
                    href={`${import.meta.env.PUBLIC_APP_URL}/signup`}
                    class="btn btn-dark"
                    style="margin-top: 1.5rem;"
                    >Start Planning <span class="arrow">
                        <i class="fa-solid fa-arrow-right"></i>
                    </span></a
                >
            </div>
            <div class="feature-img">
                <img src="/images/feature-img1.jpg" alt="Tax strategy chart" />
            </div>
        </div>
    </section>

    <!-- Spaghetti Animation (commented out) -->
    <!-- <section class="animation-section">
        <div class="container">
            <div class="animation-demo" data-aos="fade-up">
                <SpaghettiAnimation />
            </div>
        </div>
    </section> -->

    <!-- Clearer way to plan section -->
    <section class="clearer-way">
        <div class="container">
            <div class="split-content">
                <div class="split-content-text">
                    <h2>
                        A clearer way to plan retirement – built for <span
                            class="text-teal">real people</span
                        >
                    </h2>
                    <p>
                        OnTarget™ helps you model your entire financial life,
                        not just a single number or projection. Visualize
                        income, spending, taxes, and assets over time. Explore
                        endless "what-if" scenarios without breaking anything.
                        Understand how today's decisions affect decades of
                        retirement.
                    </p>
                    <p class="text-bold">
                        Adjust as life changes – because it always does.
                    </p>
                </div>
                <div class="split-content-thumb">
                    <img
                        src="/images/landing/stock/couple_water.jpg"
                        alt="People with a retirement plan feel more confident about their future"
                    />
                    <div class="split-content-text-overlay">
                        <h3 class="stat-number">87%</h3>
                        <p class="stat-headline">
                            People with a retirement plan feel more confident
                            about their future.
                        </p>
                        <p class="stat-subtext">
                            Confidence comes from planning, not guessing.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div
            class="clearer-plan-benefits container"
            data-aos="fade-up"
            data-aos-delay="100"
        >
            <div class="benefit-pill">
                <img src="/images/icons/clearer-way-check.svg" />
                <span>Spot risks early</span>
            </div>
            <div class="benefit-pill">
                <img src="/images/icons/clearer-way-check.svg" />
                <span>Understand trade-offs</span>
            </div>
            <div class="benefit-pill">
                <img src="/images/icons/clearer-way-check.svg" />
                <span>Prepare for the unexpected</span>
            </div>
            <div class="benefit-pill">
                <img src="/images/icons/clearer-way-check.svg" />
                <span>Everything works together</span>
            </div>
        </div>
    </section>

    <!-- Testimonials Section -->
    <Testimonials limit={28} heading="Our success stories" initialShow={10} />

    <!-- Blog cards -->
    <Blogs limit={4} />
    <!-- Newsletter -->
    <Newsletter />

    <!-- Call to Action Banner -->
    <CTABanner />

    <!-- Page-specific scripts for landing page animations -->
    <script is:inline>
        document.addEventListener("DOMContentLoaded", function () {
            // Scrolling sliders animation (commented out)
            /*
        const scrollingContent = document.querySelector('.scrolling-content');
        if (scrollingContent) {
            scrollingContent.style.animationPlayState = 'running';

            const observer = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                    if (entry.isIntersecting) {
                        scrollingContent.style.animation = 'none';
                        scrollingContent.offsetHeight;
                        scrollingContent.style.animation = 'scrollUp 30s linear infinite';
                        scrollingContent.style.animationPlayState = 'running';
                    }
                });
            }, { threshold: 0.1 });

            observer.observe(scrollingContent);

            setTimeout(function() {
                scrollingContent.style.animation = 'none';
                scrollingContent.offsetHeight;
                scrollingContent.style.animation = 'scrollUp 30s linear infinite';
                scrollingContent.style.animationPlayState = 'running';
            }, 1000);
        }
        */

            // Sticky on target section functionalities
            const stickySection = document.querySelector(".ontarget-section");
            const sentinel = document.createElement("div");
            sentinel.className = "sticky-sentinel";
            stickySection.parentNode.insertBefore(sentinel, stickySection);

            const observer = new IntersectionObserver(
                ([entry]) => {
                    if (entry.isIntersecting) {
                        stickySection.classList.remove("sticky");
                    } else {
                        stickySection.classList.add("sticky");
                    }
                },
                { threshold: [1] },
            );

            observer.observe(sentinel);

            let resizeTimeout;
            window.addEventListener("resize", () => {
                clearTimeout(resizeTimeout);
                resizeTimeout = setTimeout(() => {
                    location.reload();
                }, 200);
            });

            // Scroll to the specific feature section when clicking the on target cards
            const cards = document.querySelectorAll(".ontarget-card");

            function scrollToFeature(event) {
                const hastClassHighlight = event.currentTarget.classList[1];
                const section = document.querySelector(
                    `#${event.currentTarget.dataset.id}`,
                );
                const notSticky =
                    document.querySelector(".ontarget-section").classList[1] !==
                    "sticky";

                if (!hastClassHighlight) {
                    cards.forEach((card) =>
                        card.classList.remove("ontarget-card-highlight"),
                    );
                    event.currentTarget.classList.add(
                        "ontarget-card-highlight",
                    );
                }

                if (notSticky) {
                    window.scrollTo({
                        top: section.offsetTop - 400,
                        behavior: "smooth",
                    });
                } else {
                    window.scrollTo({
                        top: section.offsetTop - 155,
                        behavior: "smooth",
                    });
                }
            }

            cards.forEach((card) => {
                card.addEventListener("click", scrollToFeature);
            });

            // GSAP animations
            const heroTitleEl = document.getElementById("hero-title");
            const originalTitleHTML = heroTitleEl ? heroTitleEl.innerHTML : "";

            function splitWordsToSpans(element) {
                const html = element.innerHTML;
                const words = html
                    .replace(/<br[^>]*>/gi, " __BR__ ")
                    .split(" ");
                element.innerHTML = "";
                words.forEach((word, i) => {
                    if (word === "__BR__") {
                        element.appendChild(document.createElement("br"));
                    } else if (word) {
                        const span = document.createElement("span");
                        span.textContent = word;
                        span.style.display = "inline-block";
                        span.style.marginRight = "0.3em";
                        if (word.toLowerCase() === "retirement") {
                            span.classList.add("text-primary");
                        }
                        element.appendChild(span);
                    }
                });
                return element.querySelectorAll("span");
            }

            // Hero animation on page load
            if (heroTitleEl) {
                heroTitleEl.style.visibility = "hidden";
                const heroSubtitleEl = document.getElementById("hero-subtitle");
                const heroBtnEl = document.getElementById("hero-btn");
                gsap.set([heroSubtitleEl, heroBtnEl], { opacity: 0, y: 20 });

                setTimeout(function () {
                    heroTitleEl.style.visibility = "visible";
                    heroTitleEl.innerHTML = originalTitleHTML;
                    const words = splitWordsToSpans(heroTitleEl);
                    gsap.fromTo(
                        words,
                        { opacity: 0, filter: "blur(20px)" },
                        {
                            opacity: 1,
                            filter: "blur(0px)",
                            duration: 0.8,
                            stagger: 0.1,
                            ease: "power2.out",
                        },
                    );

                    setTimeout(function () {
                        gsap.to(heroSubtitleEl, {
                            opacity: 1,
                            y: 0,
                            duration: 0.6,
                            ease: "power2.out",
                        });
                        gsap.to(heroBtnEl, {
                            opacity: 1,
                            y: 0,
                            duration: 0.6,
                            delay: 0.15,
                            ease: "power2.out",
                        });
                    }, 750);
                }, 300);
            }

            // Section Animations with GSAP ScrollTrigger
            gsap.registerPlugin(ScrollTrigger);

            const featureSections = document.querySelectorAll(".feature");
            let currentSectionTriggers = [];

            function applySectionAnimations() {
                featureSections.forEach((section, index) => {
                    const img = section.querySelector(".feature-img");
                    const text = section.querySelector(".feature-text");
                    const isEven = index % 2 === 1;
                    gsap.set(img, { opacity: 0, x: isEven ? 100 : -100 });
                    gsap.set(text, { opacity: 0, x: isEven ? -100 : 100 });
                    const tl = gsap.timeline({
                        scrollTrigger: {
                            trigger: section,
                            start: "top 80%",
                            end: "top 30%",
                            toggleActions: "play none none none",
                        },
                    });
                    tl.to(img, {
                        opacity: 1,
                        x: 0,
                        duration: 0.8,
                        ease: "power3.out",
                    }).to(
                        text,
                        { opacity: 1, x: 0, duration: 0.8, ease: "power3.out" },
                        "-=0.6",
                    );
                    currentSectionTriggers.push(tl.scrollTrigger);
                });
            }

            applySectionAnimations();

            // Testimonial cards elastic bounce animation
            const testimonialCards = document.querySelectorAll(
                ".testimonial-card-v2",
            );
            testimonialCards.forEach((card, index) => {
                gsap.set(card, { opacity: 0, y: 60, scale: 0.8 });
                gsap.to(card, {
                    opacity: 1,
                    y: 0,
                    scale: 1,
                    duration: 1,
                    ease: "elastic.out(1, 0.5)",
                    scrollTrigger: {
                        trigger: card,
                        start: "top 85%",
                        toggleActions: "play none none none",
                    },
                    delay: (index % 3) * 0.1,
                });
            });
        });
    </script>

    <!-- Organization Schema for SEO -->
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "Organization",
            "name": "ReadyAimRetire",
            "description": "Retirement planning software that helps you visualize your financial future with powerful scenario modeling and tax optimization tools.",
            "url": "https://readyaimretire.com",
            "logo": "https://readyaimretire.com/images/logos/rar/rar_white_black_bg.png",
            "sameAs": [
                "https://linkedin.com/company/readyaimretire",
                "https://x.com/readyaimretire",
                "https://facebook.com/readyaimretire",
                "https://youtube.com/@readyaimretire",
                "https://instagram.com/readyaimretire"
            ],
            "contactPoint": {
                "@type": "ContactPoint",
                "contactType": "customer support",
                "email": "support@readyaimretire.com"
            }
        }
    </script>
</BaseLayout>
