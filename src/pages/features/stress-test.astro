---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTABanner from "../../components/CTABanner.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
---

<BaseLayout
    title="Stress Test Your Plan – ReadyAimRetire Features"
    description="Run your retirement plan through historical market scenarios with Monte Carlo simulations."
    solidHeader={true}
>
    <!-- Hero Section -->
    <section class="hero feature-detail-hero">
        <div class="container" data-aos="fade-up">
            <Breadcrumbs
                theme="dark"
                items={[
                    { label: "Features", href: "/features" },
                    { label: "Stress Test Your Plan" },
                ]}
            />
            <h1>Run Your Plan Through Historical Market Data</h1>
            <p>
                See how your retirement strategy holds up against real-world
                market volatility using decades of historical returns.
            </p>
        </div>
    </section>

    <!-- Main Content -->
    <section style="padding: 5rem 0; background: #ffffff;">
        <div class="container">
            <div class="feature-content">
                <div class="content-block" data-aos="fade-up">
                    <h2>Test Against Real Market History</h2>
                    <p>
                        What if you had retired right before the 2008 financial
                        crisis? Or during the dot-com bubble? Or at the start of
                        the Great Depression? Would your plan have survived?
                    </p>
                    <p>
                        ReadyAimRetire lets you run your retirement strategy
                        through actual historical market data to see how it
                        would have performed during the best and worst times in
                        market history.
                    </p>
                </div>

                <div
                    class="benefits-grid"
                    data-aos="fade-up"
                    data-aos-delay="100"
                >
                    <div class="benefit-item">
                        <i class="fas fa-history"></i>
                        <h3>Historical Returns</h3>
                        <p>
                            Test your plan against real market data from major
                            historical events.
                        </p>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-shield-alt"></i>
                        <h3>Worst-Case Scenarios</h3>
                        <p>
                            See how your plan holds up during market crashes and
                            bear markets.
                        </p>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-chart-line"></i>
                        <h3>Best-Case Scenarios</h3>
                        <p>
                            Understand your upside potential during strong bull
                            markets.
                        </p>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-adjust"></i>
                        <h3>Realistic Expectations</h3>
                        <p>
                            Build confidence by seeing the range of possible
                            outcomes.
                        </p>
                    </div>
                </div>

                <div class="content-block" data-aos="fade-up">
                    <h2>Key Stress-Testing Capabilities</h2>
                    <ul class="feature-list">
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Historical sequences:</strong> Test against actual
                            market return sequences from the past century
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Monte Carlo simulation:</strong> Run thousands
                            of scenarios to see the probability of success
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Market volatility:</strong> Adjust expected returns
                            and standard deviation to match your assumptions
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Inflation scenarios:</strong> Test how different
                            inflation rates impact your purchasing power
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Sequence risk:</strong> Understand how the timing
                            of returns affects your portfolio longevity
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Recovery analysis:</strong> See how long it takes
                            to recover from major market downturns
                        </li>
                    </ul>
                </div>

                <div class="content-block" data-aos="fade-up">
                    <h2>Build a Resilient Retirement Plan</h2>
                    <p>
                        Stress-testing reveals weaknesses in your strategy
                        before you retire. Discover if you're withdrawing too
                        much, if your allocation is too aggressive, or if you
                        need more cushion for market volatility.
                    </p>
                    <p>
                        Make adjustments with confidence, knowing your plan can
                        weather the storms that historically have hit real
                        retirees.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section style="padding: 4rem 0; background: #f6f6f4;">
        <div class="container">
            <div class="cta-box" data-aos="fade-up">
                <h2>Stress-Test Your Retirement Today</h2>
                <p>
                    Build confidence by seeing how your plan performs against
                    real historical market data.
                </p>
                <a
                    href={`${import.meta.env.PUBLIC_APP_URL}/signup`}
                    class="btn btn-primary">Get Started Free</a
                >
            </div>
        </div>
    </section>

    <!-- Call to Action Banner -->
    <CTABanner />

    <!-- BreadcrumbList Schema for SEO -->
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            "itemListElement": [
                {
                    "@type": "ListItem",
                    "position": 1,
                    "name": "Home",
                    "item": "https://readyaimretire.com"
                },
                {
                    "@type": "ListItem",
                    "position": 2,
                    "name": "Features",
                    "item": "https://readyaimretire.com/features"
                },
                {
                    "@type": "ListItem",
                    "position": 3,
                    "name": "Stress Test",
                    "item": "https://readyaimretire.com/features/stress-test"
                }
            ]
        }
    </script>
</BaseLayout>
