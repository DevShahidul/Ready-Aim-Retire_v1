---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
---

<BaseLayout
    title="Stress Test Your Plan – ReadyAimRetire Features"
    description="Run your retirement plan through historical market scenarios with Monte Carlo simulations."
    solidHeader={true}
>
    <!-- Hero Section -->
    <section class="hero feature-detail-hero">
        <div class="container" data-aos="fade-up">
            <Breadcrumbs theme="dark" items={[
                { label: "Features", href: "/features" },
                { label: "Stress Test Your Plan" }
            ]} />
            <h1>Run Your Plan Through Historical Market Data</h1>
            <p>See how your retirement strategy holds up against real-world market volatility using decades of historical returns.</p>
        </div>
    </section>

    <!-- Main Content -->
    <section style="padding: 5rem 0; background: #ffffff;">
        <div class="container">
            <div class="feature-content">
                <div class="content-block" data-aos="fade-up">
                    <h2>Test Against Real Market History</h2>
                    <p>What if you had retired right before the 2008 financial crisis? Or during the dot-com bubble? Or at the start of the Great Depression? Would your plan have survived?</p>
                    <p>ReadyAimRetire lets you run your retirement strategy through actual historical market data to see how it would have performed during the best and worst times in market history.</p>
                </div>

                <div class="benefits-grid" data-aos="fade-up" data-aos-delay="100">
                    <div class="benefit-item">
                        <i class="fas fa-history"></i>
                        <h3>Historical Returns</h3>
                        <p>Test your plan against real market data from major historical events.</p>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-shield-alt"></i>
                        <h3>Worst-Case Scenarios</h3>
                        <p>See how your plan holds up during market crashes and bear markets.</p>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-chart-line"></i>
                        <h3>Best-Case Scenarios</h3>
                        <p>Understand your upside potential during strong bull markets.</p>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-adjust"></i>
                        <h3>Realistic Expectations</h3>
                        <p>Build confidence by seeing the range of possible outcomes.</p>
                    </div>
                </div>

                <div class="content-block" data-aos="fade-up">
                    <h2>Key Stress-Testing Capabilities</h2>
                    <ul class="feature-list">
                        <li><i class="fas fa-check-circle"></i> <strong>Historical sequences:</strong> Test against actual market return sequences from the past century</li>
                        <li><i class="fas fa-check-circle"></i> <strong>Monte Carlo simulation:</strong> Run thousands of scenarios to see the probability of success</li>
                        <li><i class="fas fa-check-circle"></i> <strong>Market volatility:</strong> Adjust expected returns and standard deviation to match your assumptions</li>
                        <li><i class="fas fa-check-circle"></i> <strong>Inflation scenarios:</strong> Test how different inflation rates impact your purchasing power</li>
                        <li><i class="fas fa-check-circle"></i> <strong>Sequence risk:</strong> Understand how the timing of returns affects your portfolio longevity</li>
                        <li><i class="fas fa-check-circle"></i> <strong>Recovery analysis:</strong> See how long it takes to recover from major market downturns</li>
                    </ul>
                </div>

                <div class="content-block" data-aos="fade-up">
                    <h2>Build a Resilient Retirement Plan</h2>
                    <p>Stress-testing reveals weaknesses in your strategy before you retire. Discover if you're withdrawing too much, if your allocation is too aggressive, or if you need more cushion for market volatility.</p>
                    <p>Make adjustments with confidence, knowing your plan can weather the storms that historically have hit real retirees.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section style="padding: 4rem 0; background: #f6f6f4;">
        <div class="container">
            <div class="cta-box" data-aos="fade-up">
                <h2>Stress-Test Your Retirement Today</h2>
                <p>Build confidence by seeing how your plan performs against real historical market data.</p>
                <a href={`${import.meta.env.PUBLIC_APP_URL}/signup`} class="btn btn-primary">Get Started Free</a>
            </div>
        </div>
    </section>

    <!-- Call to Action Banner -->
    <CTABanner />

    <!-- BreadcrumbList Schema for SEO -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": "Home",
                "item": "https://readyaimretire.com"
            },
            {
                "@type": "ListItem",
                "position": 2,
                "name": "Features",
                "item": "https://readyaimretire.com/features"
            },
            {
                "@type": "ListItem",
                "position": 3,
                "name": "Stress Test",
                "item": "https://readyaimretire.com/features/stress-test"
            }
        ]
    }
    </script>
</BaseLayout>

<style>
    .feature-detail-hero {
        background: linear-gradient(135deg, #3b7eff 0%, #2563eb 100%);
        padding: 8rem 0 3rem 0;
        text-align: left;
    }

    .feature-detail-hero h1 {
        font-family: 'Inter', sans-serif;
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 700;
        color: #ffffff;
        margin: 0 0 1.5rem 0;
        line-height: 1.2;
        max-width: 900px;
    }

    .feature-detail-hero p {
        font-size: clamp(1rem, 2vw, 1.25rem);
        color: rgba(255, 255, 255, 0.9);
        max-width: 800px;
        line-height: 1.6;
        margin: 0;
    }

    .feature-content {
        max-width: 900px;
        margin: 0 auto;
    }

    .content-block {
        margin-bottom: 3rem;
    }

    .content-block h2 {
        font-family: 'Inter', sans-serif;
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 700;
        color: #1a1a2e;
        margin: 0 0 1.5rem 0;
        line-height: 1.3;
    }

    .content-block p {
        font-size: 1.05rem;
        line-height: 1.8;
        color: #444;
        margin-bottom: 1rem;
    }

    .benefits-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 2rem;
        margin: 3rem 0;
    }

    .benefit-item {
        text-align: center;
        padding: 1.5rem;
    }

    .benefit-item i {
        font-size: 2.5rem;
        color: #3b7eff;
        margin-bottom: 1rem;
    }

    .benefit-item h3 {
        font-family: 'Inter', sans-serif;
        font-size: 1.15rem;
        font-weight: 600;
        color: #1a1a2e;
        margin: 0 0 0.75rem 0;
    }

    .benefit-item p {
        font-size: 0.95rem;
        line-height: 1.6;
        color: #666;
        margin: 0;
    }

    .feature-list {
        list-style: none;
        padding: 0;
        margin: 2rem 0;
    }

    .feature-list li {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1.25rem;
        font-size: 1.05rem;
        line-height: 1.7;
        color: #444;
    }

    .feature-list li i {
        color: #22c997;
        font-size: 1.25rem;
        margin-top: 0.25rem;
        flex-shrink: 0;
    }

    .feature-list li strong {
        color: #1a1a2e;
        font-weight: 600;
    }

    .cta-box {
        background: linear-gradient(135deg, #3b5998 0%, #415776 100%);
        border-radius: 20px;
        padding: 3rem;
        text-align: center;
        color: #ffffff;
    }

    .cta-box h2 {
        font-family: 'Inter', sans-serif;
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 700;
        color: #ffffff;
        margin: 0 0 1rem 0;
    }

    .cta-box p {
        font-size: 1.1rem;
        color: rgba(255, 255, 255, 0.9);
        margin: 0 0 2rem 0;
    }

    .cta-box .btn-primary {
        background-color: #14b8a6;
        color: #ffffff;
        padding: 0.85rem 2.5rem;
        font-size: 1rem;
        font-weight: 600;
        border-radius: 50px;
        border: none;
        transition: background-color 0.2s, transform 0.2s;
    }

    .cta-box .btn-primary:hover {
        background-color: #0d9488;
        transform: translateY(-2px);
    }

    @media (max-width: 768px) {
        .benefits-grid {
            grid-template-columns: 1fr;
        }

        .cta-box {
            padding: 2rem;
        }
    }
</style>
