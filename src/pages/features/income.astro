---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTABanner from "../../components/CTABanner.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
---

<BaseLayout
    title="Income & Spending – ReadyAimRetire Features"
    description="Understand where your retirement income comes from and where it goes with clear visualizations."
    solidHeader={true}
>
    <!-- Hero Section -->
    <section class="hero feature-detail-hero">
        <div class="container" data-aos="fade-up">
            <Breadcrumbs
                theme="dark"
                items={[
                    { label: "Features", href: "/features" },
                    { label: "Income & Spending" },
                ]}
            />
            <h1>Understand Where Your Money Comes From and Goes</h1>
            <p>
                Track every income source and expense category across decades.
                See exactly how your cash flow evolves throughout retirement.
            </p>
        </div>
    </section>

    <!-- Main Content -->
    <section style="padding: 5rem 0; background: #ffffff;">
        <div class="container">
            <div class="feature-content">
                <div class="content-block" data-aos="fade-up">
                    <h2>Complete Income and Spending Clarity</h2>
                    <p>
                        Retirement income doesn't come from a single source, and
                        your spending needs will change over time. Will you have
                        enough income to cover your expenses? Where will that
                        income come from? How will your spending evolve?
                    </p>
                    <p>
                        ReadyAimRetire shows you the complete picture—year by
                        year, source by source, category by category.
                    </p>
                </div>

                <div
                    class="benefits-grid"
                    data-aos="fade-up"
                    data-aos-delay="100"
                >
                    <div class="benefit-item">
                        <i class="fas fa-hand-holding-usd"></i>
                        <h3>Multiple Income Sources</h3>
                        <p>
                            Track Social Security, pensions, withdrawals,
                            part-time work, and more.
                        </p>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-shopping-cart"></i>
                        <h3>Detailed Budgeting</h3>
                        <p>
                            Model essential expenses, discretionary spending,
                            and healthcare costs.
                        </p>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-chart-bar"></i>
                        <h3>Visual Cash Flow</h3>
                        <p>
                            See income vs. expenses in clear, intuitive charts.
                        </p>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-calendar-check"></i>
                        <h3>Year-by-Year Tracking</h3>
                        <p>
                            Watch how your income sources and spending change
                            over time.
                        </p>
                    </div>
                </div>

                <div class="content-block" data-aos="fade-up">
                    <h2>Track All Your Income Sources</h2>
                    <ul class="feature-list">
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Social Security:</strong> Model benefits for you
                            and your spouse with different claiming ages
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Pensions:</strong> Include employer pensions with
                            COLA adjustments and survivor benefits
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Portfolio withdrawals:</strong> See withdrawals
                            from taxable, tax-deferred, and Roth accounts
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Part-time income:</strong> Add bridge jobs or
                            consulting income during early retirement
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Rental income:</strong> Include real estate rental
                            income with expense tracking
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Annuities:</strong> Model fixed or variable annuity
                            payments
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Other income:</strong> Add any additional income
                            sources like royalties or side businesses
                        </li>
                    </ul>
                </div>

                <div class="content-block" data-aos="fade-up">
                    <h2>Model Your Retirement Spending</h2>
                    <ul class="feature-list">
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Essential expenses:</strong> Housing, utilities,
                            food, insurance, and other necessities
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Discretionary spending:</strong> Travel, entertainment,
                            hobbies, and lifestyle expenses
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Healthcare costs:</strong> Medicare premiums,
                            supplements, prescriptions, and out-of-pocket expenses
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>One-time expenses:</strong> Home repairs, car
                            purchases, major trips, or other large expenditures
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Spending adjustments:</strong> Model the "go-go,"
                            "slow-go," "no-go" phases of retirement
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Inflation adjustments:</strong> See how inflation
                            impacts your purchasing power over time
                        </li>
                    </ul>
                </div>

                <div class="content-block" data-aos="fade-up">
                    <h2>Build a Sustainable Retirement Budget</h2>
                    <p>
                        The key to retirement confidence is knowing your income
                        will cover your expenses—not just this year, but every
                        year for the rest of your life.
                    </p>
                    <p>
                        ReadyAimRetire helps you build a detailed retirement
                        budget that balances your income sources with your
                        spending needs, so you can retire with confidence
                        knowing you've planned for the reality of retirement
                        cash flow.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section style="padding: 4rem 0; background: #f6f6f4;">
        <div class="container">
            <div class="cta-box" data-aos="fade-up">
                <h2>Master Your Retirement Cash Flow</h2>
                <p>
                    Build a comprehensive income and spending plan that gives
                    you confidence for every year of retirement.
                </p>
                <a
                    href={`${import.meta.env.PUBLIC_APP_URL}/signup`}
                    class="btn btn-primary">Get Started Free</a
                >
            </div>
        </div>
    </section>

    <!-- Call to Action Banner -->
    <CTABanner />

    <!-- BreadcrumbList Schema for SEO -->
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            "itemListElement": [
                {
                    "@type": "ListItem",
                    "position": 1,
                    "name": "Home",
                    "item": "https://readyaimretire.com"
                },
                {
                    "@type": "ListItem",
                    "position": 2,
                    "name": "Features",
                    "item": "https://readyaimretire.com/features"
                },
                {
                    "@type": "ListItem",
                    "position": 3,
                    "name": "Income",
                    "item": "https://readyaimretire.com/features/income"
                }
            ]
        }
    </script>
</BaseLayout>
