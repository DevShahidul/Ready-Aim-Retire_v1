---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTABanner from "../../components/CTABanner.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
---

<BaseLayout
    title="Holistic Timeline – ReadyAimRetire Features"
    description="See your financial life unfold year by year with ReadyAimRetire's holistic timeline feature."
    solidHeader={true}
>
    <!-- Hero Section -->
    <section class="hero feature-detail-hero">
        <div class="container" data-aos="fade-up">
            <Breadcrumbs
                theme="dark"
                items={[
                    { label: "Features", href: "/features" },
                    { label: "Holistic Timeline" },
                ]}
            />
            <h1>Watch Your Financial Life Unfold Year by Year</h1>
            <p>
                See the complete picture of your retirement with a comprehensive
                timeline that connects every aspect of your financial plan.
            </p>
        </div>
    </section>

    <!-- Main Content -->
    <section style="padding: 5rem 0; background: #ffffff;">
        <div class="container">
            <div class="feature-content">
                <div class="content-block" data-aos="fade-up">
                    <h2>Your Entire Financial Future in One View</h2>
                    <p>
                        Most retirement calculators give you a single number or
                        percentage. ReadyAimRetire shows you year-by-year
                        exactly what happens with your money—from today through
                        age 100.
                    </p>
                    <p>
                        Track every account balance, income source, expense, tax
                        payment, and withdrawal across decades. Understand not
                        just if your money will last, but how your financial
                        life will evolve.
                    </p>
                </div>

                <div
                    class="benefits-grid"
                    data-aos="fade-up"
                    data-aos-delay="100"
                >
                    <div class="benefit-item">
                        <i class="fas fa-calendar-alt"></i>
                        <h3>Year-by-Year Clarity</h3>
                        <p>
                            See exactly what happens at ages 65, 72, 85, and
                            every year in between.
                        </p>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-link"></i>
                        <h3>Connected Planning</h3>
                        <p>
                            Watch how withdrawals affect taxes, how taxes affect
                            Social Security, and how it all connects.
                        </p>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-chart-area"></i>
                        <h3>Visual Insights</h3>
                        <p>
                            Rich charts and graphs make complex financial data
                            easy to understand at a glance.
                        </p>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-calculator"></i>
                        <h3>Detailed Tables</h3>
                        <p>
                            Drill down into the numbers with comprehensive data
                            tables for every year.
                        </p>
                    </div>
                </div>

                <div class="content-block" data-aos="fade-up">
                    <h2>Track Everything That Matters</h2>
                    <ul class="feature-list">
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Account balances:</strong> Traditional IRA, Roth
                            IRA, taxable accounts, 401(k)s, and more
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Income sources:</strong> Social Security, pensions,
                            part-time work, rental income
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Spending patterns:</strong> Essential expenses,
                            discretionary spending, healthcare costs
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Tax implications:</strong> Federal taxes, state
                            taxes, IRMAA surcharges
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Required distributions:</strong> RMDs from traditional
                            accounts starting at age 73
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Strategic moves:</strong> Roth conversions, tax-loss
                            harvesting, withdrawal strategies
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section style="padding: 4rem 0; background: #f6f6f4;">
        <div class="container">
            <div class="cta-box" data-aos="fade-up">
                <h2>See Your Complete Timeline Today</h2>
                <p>
                    Start planning with year-by-year clarity and watch your
                    retirement strategy come to life.
                </p>
                <a
                    href={`${import.meta.env.PUBLIC_APP_URL}/signup`}
                    class="btn btn-primary">Get Started Free</a
                >
            </div>
        </div>
    </section>

    <!-- Call to Action Banner -->
    <CTABanner />

    <!-- BreadcrumbList Schema for SEO -->
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            "itemListElement": [
                {
                    "@type": "ListItem",
                    "position": 1,
                    "name": "Home",
                    "item": "https://readyaimretire.com"
                },
                {
                    "@type": "ListItem",
                    "position": 2,
                    "name": "Features",
                    "item": "https://readyaimretire.com/features"
                },
                {
                    "@type": "ListItem",
                    "position": 3,
                    "name": "Holistic Timeline",
                    "item": "https://readyaimretire.com/features/timeline"
                }
            ]
        }
    </script>
</BaseLayout>
