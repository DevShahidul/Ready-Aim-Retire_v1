---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTABanner from "../../components/CTABanner.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
---

<BaseLayout
    title="Tax Optimization – ReadyAimRetire Features"
    description="Optimize your retirement taxes. Roth conversions, withdrawal sequencing, and IRMAA management."
    solidHeader={true}
>
    <!-- Hero Section -->
    <section class="hero feature-detail-hero">
        <div class="container" data-aos="fade-up">
            <Breadcrumbs
                theme="dark"
                items={[
                    { label: "Features", href: "/features" },
                    { label: "Tax Optimization" },
                ]}
            />
            <h1>See Taxes and Social Security as Part of the Plan</h1>
            <p>
                Navigate the complex tax landscape of retirement with integrated
                planning that shows exactly how taxes, benefits, and premiums
                impact your bottom line.
            </p>
        </div>
    </section>

    <!-- Main Content -->
    <section style="padding: 5rem 0; background: #ffffff;">
        <div class="container">
            <div class="feature-content">
                <div class="content-block" data-aos="fade-up">
                    <h2>Taxes Are Part of Your Plan, Not an Afterthought</h2>
                    <p>
                        In retirement, taxes become more complex—not simpler.
                        Social Security taxation, RMDs, Medicare premiums, Roth
                        conversions, capital gains... they all interact in ways
                        that can significantly impact how much you keep.
                    </p>
                    <p>
                        ReadyAimRetire integrates tax planning directly into
                        your retirement projections, showing you year-by-year
                        how taxes affect your cash flow and how strategic
                        decisions can help you keep more of what you've saved.
                    </p>
                </div>

                <div
                    class="benefits-grid"
                    data-aos="fade-up"
                    data-aos-delay="100"
                >
                    <div class="benefit-item">
                        <i class="fas fa-calculator"></i>
                        <h3>Tax-Aware Planning</h3>
                        <p>
                            See federal and state taxes calculated for every
                            year of retirement.
                        </p>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-university"></i>
                        <h3>Social Security Modeling</h3>
                        <p>
                            Optimize when to claim and understand taxation of
                            benefits.
                        </p>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-coins"></i>
                        <h3>Roth Conversion Analysis</h3>
                        <p>
                            Identify optimal years and amounts for Roth
                            conversions.
                        </p>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-heartbeat"></i>
                        <h3>IRMAA Planning</h3>
                        <p>
                            Avoid costly Medicare premium surcharges with
                            strategic planning.
                        </p>
                    </div>
                </div>

                <div class="content-block" data-aos="fade-up">
                    <h2>Comprehensive Tax & Benefits Features</h2>
                    <ul class="feature-list">
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Federal tax brackets:</strong> Accurate calculations
                            using current tax law and brackets
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>State tax modeling:</strong> Support for state
                            income tax calculations
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Social Security benefits:</strong> PIA calculations,
                            spousal benefits, and taxation modeling
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Social Security claiming strategies:</strong
                            > Compare claiming at different ages
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Required Minimum Distributions:</strong> Automatic
                            RMD calculations starting at age 73
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Roth conversion planning:</strong> Model conversions
                            and see long-term tax impact
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>IRMAA thresholds:</strong> Track Modified AGI
                            and Medicare premium surcharges
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Capital gains tax:</strong> Model long-term capital
                            gains from taxable account withdrawals
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Standard deduction:</strong> Automatic adjustments
                            for age 65+ and filing status
                        </li>
                        <li>
                            <i class="fas fa-check-circle"></i>
                            <strong>Tax-efficient withdrawals:</strong> Compare different
                            withdrawal order strategies
                        </li>
                    </ul>
                </div>

                <div class="content-block" data-aos="fade-up">
                    <h2>Make Tax-Smart Decisions</h2>
                    <p>
                        Should you do Roth conversions in your 60s before Social
                        Security starts? Should you withdraw from taxable
                        accounts first or tax-deferred? When should you claim
                        Social Security to minimize lifetime taxes?
                    </p>
                    <p>
                        These questions have huge financial implications.
                        ReadyAimRetire gives you the tools to answer them with
                        clarity and confidence.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section style="padding: 4rem 0; background: #f6f6f4;">
        <div class="container">
            <div class="cta-box" data-aos="fade-up">
                <h2>Start Tax-Aware Planning Today</h2>
                <p>
                    Keep more of what you've saved with integrated tax and
                    benefits planning.
                </p>
                <a
                    href={`${import.meta.env.PUBLIC_APP_URL}/signup`}
                    class="btn btn-primary">Get Started Free</a
                >
            </div>
        </div>
    </section>

    <!-- Call to Action Banner -->
    <CTABanner />

    <!-- BreadcrumbList Schema for SEO -->
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            "itemListElement": [
                {
                    "@type": "ListItem",
                    "position": 1,
                    "name": "Home",
                    "item": "https://readyaimretire.com"
                },
                {
                    "@type": "ListItem",
                    "position": 2,
                    "name": "Features",
                    "item": "https://readyaimretire.com/features"
                },
                {
                    "@type": "ListItem",
                    "position": 3,
                    "name": "Taxes",
                    "item": "https://readyaimretire.com/features/taxes"
                }
            ]
        }
    </script>
</BaseLayout>
