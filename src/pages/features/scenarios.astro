---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
---

<BaseLayout
    title="Scenario Planning – ReadyAimRetire Features"
    description="Model unlimited what-if scenarios. Explore how different decisions affect your retirement."
    solidHeader={true}
>
    <!-- Hero Section -->
    <section class="hero feature-detail-hero">
        <div class="container" data-aos="fade-up">
            <Breadcrumbs theme="dark" items={[
                { label: "Features", href: "/features" },
                { label: "Scenario Planning" }
            ]} />
            <h1>What If You Retire Earlier? Spend More?</h1>
            <p>Instantly model unlimited scenarios with over 100 intuitive sliders. See how every decision impacts your retirement in real-time.</p>
        </div>
    </section>

    <!-- Main Content -->
    <section style="padding: 5rem 0; background: #ffffff;">
        <div class="container">
            <div class="feature-content">
                <div class="content-block" data-aos="fade-up">
                    <h2>Model Any Scenario Instantly</h2>
                    <p>Retirement planning isn't one-size-fits-all. What if you retire at 62 instead of 65? What if healthcare costs are higher than expected? What if you spend more in your early retirement years?</p>
                    <p>With ReadyAimRetire, you don't have to guess. Adjust any assumption and instantly see how it ripples through your entire plan—year by year, account by account.</p>
                </div>

                <div class="benefits-grid" data-aos="fade-up" data-aos-delay="100">
                    <div class="benefit-item">
                        <i class="fas fa-sliders-h"></i>
                        <h3>100+ Adjustable Inputs</h3>
                        <p>Fine-tune every aspect of your plan with intuitive slider controls.</p>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-bolt"></i>
                        <h3>Real-Time Updates</h3>
                        <p>Changes update instantly—no waiting, no recalculation delays.</p>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-copy"></i>
                        <h3>Compare Side-by-Side</h3>
                        <p>Save multiple scenarios and compare them to find your best path.</p>
                    </div>
                    <div class="benefit-item">
                        <i class="fas fa-random"></i>
                        <h3>Unlimited Flexibility</h3>
                        <p>Model traditional retirement, phased retirement, or anything in between.</p>
                    </div>
                </div>

                <div class="content-block" data-aos="fade-up">
                    <h2>Explore Key Scenarios</h2>
                    <ul class="feature-list">
                        <li><i class="fas fa-check-circle"></i> <strong>Retirement age:</strong> See the impact of retiring at 60, 62, 65, 67, or 70</li>
                        <li><i class="fas fa-check-circle"></i> <strong>Spending levels:</strong> Model conservative, moderate, or aggressive spending patterns</li>
                        <li><i class="fas fa-check-circle"></i> <strong>Investment returns:</strong> Test optimistic, realistic, and pessimistic market scenarios</li>
                        <li><i class="fas fa-check-circle"></i> <strong>Social Security timing:</strong> Compare claiming at 62, FRA, or 70</li>
                        <li><i class="fas fa-check-circle"></i> <strong>Healthcare costs:</strong> Model different Medicare supplement plans and long-term care needs</li>
                        <li><i class="fas fa-check-circle"></i> <strong>Part-time income:</strong> Add bridge jobs or consulting income during early retirement</li>
                        <li><i class="fas fa-check-circle"></i> <strong>Roth conversions:</strong> Test different conversion strategies and timings</li>
                        <li><i class="fas fa-check-circle"></i> <strong>Withdrawal strategies:</strong> Compare proportional, priority-based, and tax-optimized approaches</li>
                    </ul>
                </div>

                <div class="content-block" data-aos="fade-up">
                    <h2>Make Confident Decisions</h2>
                    <p>Scenario planning removes the guesswork. Instead of wondering "what if," you can see exactly how different choices play out over decades.</p>
                    <p>Identify the tradeoffs, understand the risks, and choose the retirement path that aligns with your goals and values.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section style="padding: 4rem 0; background: #f6f6f4;">
        <div class="container">
            <div class="cta-box" data-aos="fade-up">
                <h2>Start Exploring Your Scenarios</h2>
                <p>Discover the power of unlimited scenario modeling and find your optimal retirement path.</p>
                <a href={`${import.meta.env.PUBLIC_APP_URL}/signup`} class="btn btn-primary">Get Started Free</a>
            </div>
        </div>
    </section>

    <!-- Call to Action Banner -->
    <CTABanner />

    <!-- BreadcrumbList Schema for SEO -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": "Home",
                "item": "https://readyaimretire.com"
            },
            {
                "@type": "ListItem",
                "position": 2,
                "name": "Features",
                "item": "https://readyaimretire.com/features"
            },
            {
                "@type": "ListItem",
                "position": 3,
                "name": "Scenarios",
                "item": "https://readyaimretire.com/features/scenarios"
            }
        ]
    }
    </script>
</BaseLayout>

<style>
    .feature-detail-hero {
        background: linear-gradient(135deg, #3b7eff 0%, #2563eb 100%);
        padding: 8rem 0 3rem 0;
        text-align: left;
    }

    .feature-detail-hero h1 {
        font-family: 'Inter', sans-serif;
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 700;
        color: #ffffff;
        margin: 0 0 1.5rem 0;
        line-height: 1.2;
        max-width: 900px;
    }

    .feature-detail-hero p {
        font-size: clamp(1rem, 2vw, 1.25rem);
        color: rgba(255, 255, 255, 0.9);
        max-width: 800px;
        line-height: 1.6;
        margin: 0;
    }

    .feature-content {
        max-width: 900px;
        margin: 0 auto;
    }

    .content-block {
        margin-bottom: 3rem;
    }

    .content-block h2 {
        font-family: 'Inter', sans-serif;
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 700;
        color: #1a1a2e;
        margin: 0 0 1.5rem 0;
        line-height: 1.3;
    }

    .content-block p {
        font-size: 1.05rem;
        line-height: 1.8;
        color: #444;
        margin-bottom: 1rem;
    }

    .benefits-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 2rem;
        margin: 3rem 0;
    }

    .benefit-item {
        text-align: center;
        padding: 1.5rem;
    }

    .benefit-item i {
        font-size: 2.5rem;
        color: #3b7eff;
        margin-bottom: 1rem;
    }

    .benefit-item h3 {
        font-family: 'Inter', sans-serif;
        font-size: 1.15rem;
        font-weight: 600;
        color: #1a1a2e;
        margin: 0 0 0.75rem 0;
    }

    .benefit-item p {
        font-size: 0.95rem;
        line-height: 1.6;
        color: #666;
        margin: 0;
    }

    .feature-list {
        list-style: none;
        padding: 0;
        margin: 2rem 0;
    }

    .feature-list li {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1.25rem;
        font-size: 1.05rem;
        line-height: 1.7;
        color: #444;
    }

    .feature-list li i {
        color: #22c997;
        font-size: 1.25rem;
        margin-top: 0.25rem;
        flex-shrink: 0;
    }

    .feature-list li strong {
        color: #1a1a2e;
        font-weight: 600;
    }

    .cta-box {
        background: linear-gradient(135deg, #3b5998 0%, #415776 100%);
        border-radius: 20px;
        padding: 3rem;
        text-align: center;
        color: #ffffff;
    }

    .cta-box h2 {
        font-family: 'Inter', sans-serif;
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 700;
        color: #ffffff;
        margin: 0 0 1rem 0;
    }

    .cta-box p {
        font-size: 1.1rem;
        color: rgba(255, 255, 255, 0.9);
        margin: 0 0 2rem 0;
    }

    .cta-box .btn-primary {
        background-color: #14b8a6;
        color: #ffffff;
        padding: 0.85rem 2.5rem;
        font-size: 1rem;
        font-weight: 600;
        border-radius: 50px;
        border: none;
        transition: background-color 0.2s, transform 0.2s;
    }

    .cta-box .btn-primary:hover {
        background-color: #0d9488;
        transform: translateY(-2px);
    }

    @media (max-width: 768px) {
        .benefits-grid {
            grid-template-columns: 1fr;
        }

        .cta-box {
            padding: 2rem;
        }
    }
</style>
