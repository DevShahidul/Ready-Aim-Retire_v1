---
import { getEntry } from "astro:content";
import DisplayCard from "../../../components/DisplayCard.astro";
const founder1Data = await getEntry("displayCard", "founder-one_card");
const founder2Data = await getEntry("displayCard", "founder-two_card");
---

<section>
    <h2 class="container">Meet our founders</h2>

    <div class="first-display-card">
        <DisplayCard displayData={founder1Data?.data} smallImg={true} />
    </div>
    <DisplayCard displayData={founder2Data?.data} smallImg={true} />
</section>

<style>
    section {
        margin-top: clamp(1.25rem, -0.775rem + 10.125vw, 11.375rem);

        .first-display-card {
            margin: 2.875rem 0 2.625rem;
        }
    }
    h2 {
        font-size: clamp(1.875rem, 1.25rem + 3.125vw, 5rem);
        line-height: 1;
        font-weight: 400;
        font-family: "Playfair Display", sans-serif;
    }
</style>
