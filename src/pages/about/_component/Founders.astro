---
import { getEntry } from "astro:content";
import DisplayCard from "../../../components/DisplayCard.astro";
const founder1Data = await getEntry("displayCard", "founder-one_card");
const founder2Data = await getEntry("displayCard", "founder-two_card");
---

<section>
    <h2 class="container">Meet our founders</h2>

    <DisplayCard displayData={founder1Data?.data} />
    <DisplayCard displayData={founder2Data?.data} />
</section>
