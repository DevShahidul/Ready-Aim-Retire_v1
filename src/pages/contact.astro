---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTABanner from "../components/CTABanner.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
---

<BaseLayout
    title="Contact Us – ReadyAimRetire"
    description="Get in touch with the ReadyAimRetire team. We're here to help with your retirement planning questions."
    solidHeader={true}
>
    <!-- Hero Section -->
    <section class="contact-hero">
        <div class="container">
            <Breadcrumbs items={[{ label: "Contact Us" }]} />
            <h1>Contact Us</h1>
            <p class="hero-subtitle">We're here to help</p>
            <p class="hero-description">
                Have a question, need support, or just want to reach out?
            </p>
            <p class="hero-text">
                Whether you're curious about retirement planning, need help with
                your OnTarget Pro membership, or are interested in partnerships,
                we'd love to hear from you.
            </p>
        </div>
    </section>

    <!-- Contact Methods -->
    <section class="contact-methods">
        <div class="container">
            <div class="contact-grid">
                <!-- General Questions & Support -->
                <div class="contact-card" data-aos="fade-up" data-aos-delay="0">
                    <div class="card-icon">
                        <i class="fas fa-question-circle"></i>
                    </div>
                    <h3>GENERAL QUESTIONS & SUPPORT</h3>
                    <p>
                        For questions about the product, support needs, or
                        general inquiries
                    </p>
                    <a
                        href="mailto:support@readyaimretire.com"
                        class="email-link"
                    >
                        <i class="fas fa-envelope"></i>
                        support@readyaimretire.com
                    </a>
                </div>

                <!-- Student Pro Access -->
                <div
                    class="contact-card"
                    data-aos="fade-up"
                    data-aos-delay="100"
                >
                    <div class="card-icon">
                        <i class="fas fa-graduation-cap"></i>
                    </div>
                    <h3>STUDENT PRO ACCESS</h3>
                    <p>
                        Students can receive a free Pro account to support their
                        financial education
                    </p>
                    <a
                        href="mailto:support@readyaimretire.com"
                        class="email-link"
                    >
                        <i class="fas fa-envelope"></i>
                        support@readyaimretire.com
                    </a>
                </div>

                <!-- Advisors & Partnerships -->
                <div
                    class="contact-card"
                    data-aos="fade-up"
                    data-aos-delay="200"
                >
                    <div class="card-icon">
                        <i class="fas fa-handshake"></i>
                    </div>
                    <h3>ADVISORS & PARTNERSHIPS</h3>
                    <p>
                        For financial advisors interested in partnerships and
                        collaboration opportunities
                    </p>
                    <a
                        href="mailto:support@readyaimretire.com"
                        class="email-link"
                    >
                        <i class="fas fa-envelope"></i>
                        support@readyaimretire.com
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Mailing Address -->
    <section class="mailing-address">
        <div class="container">
            <div class="address-card" data-aos="fade-up">
                <h2>Mailing Address</h2>
                <div class="address-content">
                    <p>Ready Aim Retire</p>
                    <p>1321 17th St Lot 70447</p>
                    <p>Denver, CO 80202</p>
                    <p>United States</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Stay Connected -->
    <section class="stay-connected">
        <div class="container">
            <div class="connected-content" data-aos="fade-up">
                <h2>Stay Connected</h2>
                <p>
                    Follow us on social media for retirement planning tips,
                    product updates, and financial insights.
                </p>

                <div class="social-links">
                    <a
                        href="https://linkedin.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="LinkedIn"
                    >
                        <i class="fab fa-linkedin"></i>
                    </a>
                    <a
                        href="https://instagram.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Instagram"
                    >
                        <i class="fab fa-instagram"></i>
                    </a>
                    <a
                        href="https://youtube.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="YouTube"
                    >
                        <i class="fab fa-youtube"></i>
                    </a>
                    <a
                        href="https://x.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="X"
                    >
                        <i class="fab fa-x-twitter"></i>
                    </a>
                    <a
                        href="https://facebook.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label="Facebook"
                    >
                        <i class="fab fa-facebook"></i>
                    </a>
                </div>

                <a
                    href={`${import.meta.env.PUBLIC_APP_URL}/signup`}
                    class="btn-start-planning"
                >
                    Start Planning for Free
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </section>

    <!-- Contact Form -->
    <section class="contact-form-section">
        <div class="container">
            <div class="form-wrapper" data-aos="fade-up">
                <h2>Send Us a Message</h2>
                <p class="form-description">
                    Fill out the form below and we'll get back to you within 24
                    hours.
                </p>

                <form class="contact-form">
                    <!-- Honeypot field - hidden from humans, visible to bots -->
                    <div class="hp-field" aria-hidden="true">
                        <label for="website">Website</label>
                        <input
                            type="text"
                            id="website"
                            name="website"
                            tabindex="-1"
                            autocomplete="off"
                        />
                    </div>

                    <div class="form-group">
                        <label for="name">
                            Name
                            <span class="required-indicator">*</span>
                        </label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            required
                            aria-describedby="name-error"
                        />
                        <span class="error-message" id="name-error" role="alert"
                        ></span>
                    </div>

                    <div class="form-group">
                        <label for="contact-email">
                            Email
                            <span class="required-indicator">*</span>
                        </label>
                        <input
                            type="email"
                            id="contact-email"
                            name="email"
                            required
                            aria-describedby="contact-email-error"
                        />
                        <span
                            class="error-message"
                            id="contact-email-error"
                            role="alert"></span>
                    </div>

                    <div class="form-group">
                        <label for="message">
                            Message
                            <span class="required-indicator">*</span>
                        </label>
                        <textarea
                            id="message"
                            name="message"
                            rows="6"
                            required
                            aria-describedby="message-error"></textarea>
                        <span
                            class="error-message"
                            id="message-error"
                            role="alert"></span>
                    </div>

                    <button type="submit" class="btn-submit">
                        Send Message
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </form>
            </div>
        </div>
    </section>

    <!-- Newsletter Signup -->
    <section class="newsletter-section">
        <div class="container">
            <div class="newsletter-card" data-aos="fade-up">
                <h2>Get the latest news in your inbox</h2>
                <p>
                    Subscribe to our newsletter for retirement planning tips,
                    product updates, and financial insights.
                </p>

                <form class="newsletter-form">
                    <!-- Honeypot field -->
                    <div class="hp-field" aria-hidden="true">
                        <label for="newsletter-website">Website</label>
                        <input
                            type="text"
                            id="newsletter-website"
                            name="website"
                            tabindex="-1"
                            autocomplete="off"
                        />
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <input
                                type="text"
                                id="firstName"
                                name="firstName"
                                placeholder="First Name *"
                                required
                                aria-describedby="firstName-error"
                            />
                            <span
                                class="error-message"
                                id="firstName-error"
                                role="alert"></span>
                        </div>
                        <div class="form-group">
                            <input
                                type="text"
                                id="lastName"
                                name="lastName"
                                placeholder="Last Name *"
                                required
                                aria-describedby="lastName-error"
                            />
                            <span
                                class="error-message"
                                id="lastName-error"
                                role="alert"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <input
                            type="email"
                            id="newsletter-email"
                            name="email"
                            placeholder="Email Address *"
                            required
                            aria-describedby="newsletter-email-error"
                        />
                        <span
                            class="error-message"
                            id="newsletter-email-error"
                            role="alert"></span>
                    </div>
                    <button type="submit" class="btn-subscribe">
                        Subscribe
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </form>
            </div>
        </div>
    </section>

    <!-- CTA Banner -->
    <CTABanner />
</BaseLayout>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Contact Form Validation
        const contactForm = document.querySelector(".contact-form");
        if (contactForm) {
            const nameInput = contactForm.querySelector('input[name="name"]');
            const emailInput = contactForm.querySelector('input[name="email"]');
            const messageInput = contactForm.querySelector(
                'textarea[name="message"]',
            );
            const submitBtn = contactForm.querySelector(
                'button[type="submit"]',
            );
            const honeypot = contactForm.querySelector('input[name="website"]');

            function showError(input, message) {
                const errorEl =
                    input.parentElement.querySelector(".error-message");
                if (errorEl) {
                    errorEl.textContent = message;
                    errorEl.style.display = "block";
                }
                input.classList.add("input-error");
                input.setAttribute("aria-invalid", "true");
            }

            function clearError(input) {
                const errorEl =
                    input.parentElement.querySelector(".error-message");
                if (errorEl) {
                    errorEl.textContent = "";
                    errorEl.style.display = "none";
                }
                input.classList.remove("input-error");
                input.removeAttribute("aria-invalid");
            }

            function validateEmail(email) {
                return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
            }

            function validateContactForm() {
                let isValid = true;

                // Check honeypot
                if (honeypot && honeypot.value) {
                    return false; // Bot detected
                }

                // Validate name
                if (
                    !nameInput.value.trim() ||
                    nameInput.value.trim().length < 2
                ) {
                    showError(
                        nameInput,
                        "Please enter your name (at least 2 characters)",
                    );
                    isValid = false;
                } else {
                    clearError(nameInput);
                }

                // Validate email
                if (
                    !emailInput.value.trim() ||
                    !validateEmail(emailInput.value)
                ) {
                    showError(emailInput, "Please enter a valid email address");
                    isValid = false;
                } else {
                    clearError(emailInput);
                }

                // Validate message
                if (
                    !messageInput.value.trim() ||
                    messageInput.value.trim().length < 10
                ) {
                    showError(
                        messageInput,
                        "Please enter a message (at least 10 characters)",
                    );
                    isValid = false;
                } else {
                    clearError(messageInput);
                }

                return isValid;
            }

            contactForm.addEventListener("submit", function (e) {
                e.preventDefault();

                if (validateContactForm()) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML =
                        '<i class="fas fa-spinner fa-spin"></i> Sending...';

                    // Simulate form submission (replace with actual submission logic)
                    setTimeout(function () {
                        const formWrapper =
                            contactForm.closest(".form-wrapper");
                        formWrapper.innerHTML =
                            '<div class="success-message"><i class="fas fa-check-circle"></i><h3>Message Sent!</h3><p>Thank you for reaching out. We\'ll get back to you within 24 hours.</p></div>';
                    }, 1500);
                }
            });

            // Real-time validation on blur
            [nameInput, emailInput, messageInput].forEach(function (input) {
                input.addEventListener("blur", function () {
                    if (this.value.trim()) {
                        validateContactForm();
                    }
                });
            });
        }

        // Newsletter Form Validation
        const newsletterForm = document.querySelector(".newsletter-form");
        if (newsletterForm) {
            const firstNameInput = newsletterForm.querySelector(
                'input[name="firstName"]',
            );
            const lastNameInput = newsletterForm.querySelector(
                'input[name="lastName"]',
            );
            const newsletterEmailInput = newsletterForm.querySelector(
                'input[name="email"]',
            );
            const subscribeBtn = newsletterForm.querySelector(
                'button[type="submit"]',
            );
            const newsletterHoneypot = newsletterForm.querySelector(
                'input[name="website"]',
            );

            function showNewsletterError(input, message) {
                const errorEl =
                    input.parentElement.querySelector(".error-message");
                if (errorEl) {
                    errorEl.textContent = message;
                    errorEl.style.display = "block";
                }
                input.classList.add("input-error");
                input.setAttribute("aria-invalid", "true");
            }

            function clearNewsletterError(input) {
                const errorEl =
                    input.parentElement.querySelector(".error-message");
                if (errorEl) {
                    errorEl.textContent = "";
                    errorEl.style.display = "none";
                }
                input.classList.remove("input-error");
                input.removeAttribute("aria-invalid");
            }

            function validateNewsletterEmail(email) {
                return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
            }

            function validateNewsletterForm() {
                let isValid = true;

                // Check honeypot
                if (newsletterHoneypot && newsletterHoneypot.value) {
                    return false; // Bot detected
                }

                // Validate first name
                if (
                    !firstNameInput.value.trim() ||
                    firstNameInput.value.trim().length < 2
                ) {
                    showNewsletterError(
                        firstNameInput,
                        "Please enter your first name",
                    );
                    isValid = false;
                } else {
                    clearNewsletterError(firstNameInput);
                }

                // Validate last name
                if (
                    !lastNameInput.value.trim() ||
                    lastNameInput.value.trim().length < 2
                ) {
                    showNewsletterError(
                        lastNameInput,
                        "Please enter your last name",
                    );
                    isValid = false;
                } else {
                    clearNewsletterError(lastNameInput);
                }

                // Validate email
                if (
                    !newsletterEmailInput.value.trim() ||
                    !validateNewsletterEmail(newsletterEmailInput.value)
                ) {
                    showNewsletterError(
                        newsletterEmailInput,
                        "Please enter a valid email address",
                    );
                    isValid = false;
                } else {
                    clearNewsletterError(newsletterEmailInput);
                }

                return isValid;
            }

            newsletterForm.addEventListener("submit", function (e) {
                e.preventDefault();

                if (validateNewsletterForm()) {
                    subscribeBtn.disabled = true;
                    subscribeBtn.innerHTML =
                        '<i class="fas fa-spinner fa-spin"></i> Subscribing...';

                    // Simulate form submission (replace with actual submission logic)
                    setTimeout(function () {
                        const newsletterCard =
                            newsletterForm.closest(".newsletter-card");
                        const cardContent = newsletterCard.innerHTML;
                        newsletterCard.innerHTML =
                            '<div class="success-message"><i class="fas fa-check-circle"></i><h3>You\'re Subscribed!</h3><p>Thank you for subscribing. You\'ll receive our latest updates in your inbox.</p></div>';
                    }, 1500);
                }
            });

            // Real-time validation on blur
            [firstNameInput, lastNameInput, newsletterEmailInput].forEach(
                function (input) {
                    input.addEventListener("blur", function () {
                        if (this.value.trim()) {
                            validateNewsletterForm();
                        }
                    });
                },
            );
        }
    });
</script>
