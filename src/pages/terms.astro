---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTABanner from "../components/CTABanner.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
---

<BaseLayout
    title="Terms of Service – ReadyAimRetire"
    description="ReadyAimRetire's terms of service. Understand your rights and responsibilities when using our platform."
    solidHeader={true}
>
    <!-- Hero Section -->
    <section class="terms-hero">
        <div class="container">
            <Breadcrumbs theme="dark" items={[{ label: "Terms of Service" }]} />
            <h1 class="terms-hero-title">Terms of Service</h1>
            <p class="terms-hero-subtitle">Last Updated: January 1, 2026</p>
        </div>
    </section>

    <!-- Terms at a Glance -->
    <section class="terms-intro">
        <div class="container">
            <div class="intro-content">
                <h2>Terms at a Glance</h2>
                <p>
                    Welcome to ReadyAimRetire. These Terms of Service govern
                    your use of our retirement planning platform and services.
                    By creating an account or using our services, you agree to
                    these terms.
                </p>
                <p><strong>Key Points:</strong></p>
                <ul class="key-points">
                    <li>
                        ReadyAimRetire provides retirement planning tools and
                        projections, not financial advice
                    </li>
                    <li>
                        You retain ownership of your data and can export or
                        delete it at any time
                    </li>
                    <li>
                        Subscriptions can be cancelled anytime with access
                        continuing until the end of your billing period
                    </li>
                    <li>
                        We use your data solely to provide our services and
                        never sell it to third parties
                    </li>
                    <li>
                        Our calculations are based on current tax laws and the
                        assumptions you provide
                    </li>
                </ul>
            </div>
        </div>
    </section>

    <!-- Section 1: Acceptance of Terms -->
    <section class="terms-section">
        <div class="container">
            <div class="terms-content">
                <h2>
                    <span class="section-number">1.</span> Acceptance of Terms
                </h2>
                <p>
                    By accessing or using ReadyAimRetire's website, web
                    application, or services (collectively, the "Service"), you
                    agree to be bound by these Terms of Service and all
                    applicable laws and regulations. If you do not agree with
                    any part of these terms, you may not use our Service.
                </p>
                <p>
                    We reserve the right to modify these terms at any time. We
                    will notify users of material changes via email or through
                    the Service. Your continued use of the Service after such
                    modifications constitutes acceptance of the updated terms.
                </p>
                <p>
                    You must be at least 18 years old to use our Service. By
                    using the Service, you represent and warrant that you meet
                    this age requirement.
                </p>
            </div>
        </div>
    </section>

    <!-- Section 2: Description of Service -->
    <section class="terms-section alt">
        <div class="container">
            <div class="terms-content">
                <h2>
                    <span class="section-number">2.</span> Description of Service
                </h2>
                <p>
                    ReadyAimRetire provides online retirement planning tools,
                    including our OnTarget™ planning engine, that allow users
                    to:
                </p>
                <ul>
                    <li>Create and manage retirement financial projections</li>
                    <li>Model various retirement scenarios and strategies</li>
                    <li>Analyze tax implications of retirement decisions</li>
                    <li>
                        Run Monte Carlo simulations and historical scenario
                        testing
                    </li>
                    <li>Optimize Social Security claiming strategies</li>
                    <li>Evaluate Roth conversion opportunities</li>
                    <li>
                        Generate reports and visualizations of retirement plans
                    </li>
                </ul>
                <p>
                    <strong>Important Disclaimer:</strong> ReadyAimRetire is a financial
                    planning tool, not a financial advisor. The Service provides projections
                    and analysis based on the data and assumptions you provide, but
                    does not constitute financial, tax, legal, or investment advice.
                    We strongly recommend consulting with qualified professionals
                    before making significant financial decisions.
                </p>
                <p>
                    Our calculations are based on current federal and state tax
                    laws, which are subject to change. While we strive to keep
                    our tax calculations current and accurate, we cannot
                    guarantee that all calculations reflect the most recent
                    legislative changes. The accuracy of projections depends on
                    the accuracy and completeness of the information you
                    provide.
                </p>
            </div>
        </div>
    </section>

    <!-- Section 3: User Accounts & Registration -->
