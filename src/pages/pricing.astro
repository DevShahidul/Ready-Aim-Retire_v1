---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
// import CommonHero from "../components/CommonHero.astro";
---

<BaseLayout
    title="Pricing – ReadyAimRetire"
    description="Choose the right ReadyAimRetire plan for your retirement planning needs. Free tier available, premium features for serious planners."
    solidHeader={true}
>
    <!-- Pricing Section -->
    <!-- <CommonHero title={"Simple, transparent pricing"} /> -->
    <section class="pricing-section">
        <div class="container">
            <div
                class="pricing-subheader"
                data-aos="fade-up"
                data-aos-delay="100"
            >
                <p class="pricing-intro">
                    OnTarget™ is free to start and powerful when you're ready to
                    go deeper. Whether you're just exploring or building a
                    long-term plan, you only pay for what you need.
                </p>
                <div class="billing-toggle">
                    <button class="toggle-pill" data-billing="monthly"
                        >Monthly</button
                    >
                    <button class="toggle-pill active" data-billing="yearly"
                        >Annual (Save 38%)</button
                    >
                </div>
            </div>

            <!-- Pricing Cards Grid -->
            <div class="pricing-cards" data-aos="fade-up" data-aos-delay="200">
                <!-- Basic Plan -->
                <div class="pricing-card-v2">
                    <div class="price-badge" data-monthly="0" data-yearly="0">
                        <span class="price">$0</span>
                        <span class="period">/y</span>
                    </div>
                    <div class="card-header-row">
                        <h3 class="plan-name">Basic</h3>
                    </div>
                    <p class="plan-description">
                        For exploring your retirement picture and getting
                        oriented.
                    </p>
                    <a
                        href={`${import.meta.env.PUBLIC_APP_URL}/signup`}
                        class="btn-choose-plan">Choose Plan</a
                    >
                    <ul class="plan-features">
                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            <span>Build a basic retirement plan</span>
                        </li>
                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            <span>Visualize your financial timeline</span>
                        </li>
                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            <span>Track net worth at a high level</span>
                        </li>
                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            <span>Run limited scenarios</span>
                        </li>
                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            <span>Save your plan for a limited time</span>
                        </li>
                    </ul>
                    <div class="plan-limitations">
                        <h4>Limitations</h4>
                        <ul>
                            <li>
                                <i class="fa-solid fa-circle limitation-icon"
                                ></i>
                                <span>Limited scenario creation</span>
                            </li>
                            <li>
                                <i class="fa-solid fa-circle limitation-icon"
                                ></i>
                                <span>Plan saved for a limited time</span>
                            </li>
                            <li>
                                <i class="fa-solid fa-circle limitation-icon"
                                ></i>
                                <span>Premium features locked</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Pro Plan -->
                <div class="pricing-card-v2">
                    <div
                        class="price-badge"
                        data-monthly="12"
                        data-yearly="115"
                    >
                        <span class="price">$115</span>
                        <span class="period">/y</span>
                    </div>
                    <div class="card-header-row">
                        <h3 class="plan-name">Pro</h3>
                    </div>
                    <p class="plan-description">
                        For those ready to take aim, who want clarity, control,
                        and confidence.
                    </p>
                    <a
                        href={`${import.meta.env.PUBLIC_APP_URL}/signup`}
                        class="btn-choose-plan">Choose Plan</a
                    >
                    <h4 class="features-subheading">
                        Everything in Basic, plus:
                    </h4>
                    <ul class="plan-features">
                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            <span>Save unlimited plans</span>
                        </li>
                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            <span>Create and compare unlimited scenarios</span>
                        </li>
                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            <span>Full historical stress testing</span>
                        </li>
                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            <span>Advanced withdrawal strategy modeling</span>
                        </li>
                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            <span>Detailed retirement budgeting</span>
                        </li>
                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            <span
                                >Tax-aware planning across all account types</span
                            >
                        </li>
                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            <span>Social Security planning tools</span>
                        </li>
                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            <span
                                >Plan for major life events, expected, and
                                unexpected expenses</span
                            >
                        </li>
                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            <span>Ongoing updates as your life changes</span>
                        </li>
                    </ul>
                </div>

                <!-- Lifetime Plan -->
                <div class="pricing-card-v2">
                    <div
                        class="price-badge"
                        data-monthly="1199"
                        data-yearly="1199"
                        data-onetime="true"
                    >
                        <span class="price">$1199</span>
                        <span class="period">/y</span>
                    </div>
                    <div class="card-header-row">
                        <h3 class="plan-name">Lifetime</h3>
                    </div>
                    <p class="plan-description">
                        Get all the great features of Pro with a single one-time
                        payment.
                    </p>
                    <a
                        href={`${import.meta.env.PUBLIC_APP_URL}/signup`}
                        class="btn-choose-plan">Choose Plan</a
                    >
                    <ul class="plan-features">
                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            <span>Everything in Pro</span>
                        </li>
                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            <span>One-time payment</span>
                        </li>
                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            <span>No subscriptions</span>
                        </li>
                    </ul>
                </div>

                <!-- Professional Plan -->
                <div class="pricing-card-v2 professional">
                    <div
                        class="price-badge"
                        data-monthly="732"
                        data-yearly="549"
                    >
                        <span class="price">$549</span>
                        <span class="period">/y</span>
                    </div>
                    <div class="card-header-row">
                        <h3 class="plan-name">Professional</h3>
                    </div>
                    <p class="plan-description">
                        Modern financial planning software for financial
                        advisors and coaches.
                    </p>
                    <a href="/advisors" class="btn-choose-plan">Coming Soon</a>
                    <ul class="plan-features">
                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            <span>Everything in <strong>Premium</strong></span>
                        </li>
                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            <span><strong>20</strong> Client Seats</span>
                        </li>
                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            <span>Plan team <strong>meetings</strong></span>
                        </li>
                        <li>
                            <i class="fa-solid fa-circle-check"></i>
                            <span>Advisor Dashboard</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Why We Charge Section -->
    <section class="why-charge-section">
        <div class="container">
            <div class="why-charge-content">
                <div class="why-charge-logo">
                    <img
                        src="/images/landing/ontargetlogo.png"
                        alt="OnTarget - Ready Aim Retire"
                        class="ontarget-logo-img"
                    />
                </div>
                <div class="why-charge-box">
                    <h2>Why we charge - and why it's worth it</h2>
                    <p class="why-charge-intro">
                        This isn't a one-time calculator. It's an ongoing
                        planning tool.
                    </p>
                    <p class="why-charge-desc">
                        Retirement planning isn't something you do once. It's
                        something you revisit as markets, life, and priorities
                        change.
                    </p>
                    <p class="why-charge-supports">
                        <strong>Your Pro subscription supports:</strong>
                    </p>
                    <ul class="why-charge-points">
                        <li>
                            <svg
                                class="check-icon"
                                viewBox="0 0 24 24"
                                width="16"
                                height="16"
                                ><path
                                    fill="currentColor"
                                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                ></path></svg
                            > Continuous improvements
                        </li>
                        <li>
                            <svg
                                class="check-icon"
                                viewBox="0 0 24 24"
                                width="16"
                                height="16"
                                ><path
                                    fill="currentColor"
                                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                ></path></svg
                            > New features and modeling tools
                        </li>
                        <li>
                            <svg
                                class="check-icon"
                                viewBox="0 0 24 24"
                                width="16"
                                height="16"
                                ><path
                                    fill="currentColor"
                                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                ></path></svg
                            > Accurate, thoughtful assumptions
                        </li>
                        <li>
                            <svg
                                class="check-icon"
                                viewBox="0 0 24 24"
                                width="16"
                                height="16"
                                ><path
                                    fill="currentColor"
                                    d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                ></path></svg
                            > A product built for planners - not advertisers
                        </li>
                    </ul>
                    <div class="why-charge-divider"></div>
                    <div class="why-charge-bold-statements">
                        <p><strong>We don't sell your data.</strong></p>
                        <p><strong>We don't push products.</strong></p>
                        <p>
                            <strong
                                >Our incentives are aligned with your clarity.</strong
                            >
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-section">
        <div class="container">
            <h2 class="faq-title">Frequently asked questions</h2>
            <div class="faq-list">
                <div class="faq-item-static">
                    <h3 class="faq-question-text">
                        Can I switch between monthly and annual plans?
                    </h3>
                    <p class="faq-answer-text">
                        Yes – upgrade, downgrade, or switch billing at any time.
                    </p>
                </div>
                <div class="faq-item-static">
                    <h3 class="faq-question-text">Is my data safe?</h3>
                    <p class="faq-answer-text">
                        Yes. Your plans are private and secure. We never sell or
                        share your data.
                    </p>
                </div>
                <div class="faq-item-static">
                    <h3 class="faq-question-text">Do I need Pro forever?</h3>
                    <p class="faq-answer-text">
                        No. You can cancel anytime. Your account remains
                        accessible under the Free plan.
                    </p>
                </div>
                <div class="faq-item-static">
                    <h3 class="faq-question-text">
                        Is this a replacement for a financial advisor?
                    </h3>
                    <p class="faq-answer-text">
                        OnTarget™ is designed to help you understand and engage
                        with your plan – whether you work with an advisor or
                        not.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section with Image -->
    <section class="pricing-cta-section">
        <div class="pricing-cta-wrapper">
            <div class="pricing-cta-image">
                <img
                    src="/images/landing/pricing/Screenshot 2026-01-19 192629.png"
                    alt="Couple walking together planning their retirement"
                />
            </div>
            <div
                class="pricing-cta-text"
                style="background-image: url('/images/landing/pricing/arrow_background.png');"
            >
                <div class="pricing-cta-logo">
                    <img
                        src="/images/landing/ontargetlogo_white.png"
                        alt="OnTarget"
                        class="ontarget-white-logo"
                    />
                </div>
                <div class="pricing-cta-badge">
                    <span class="cta-arrow-icon">→</span>
                    <span class="cta-badge-text"
                        >Ready to build your plan<br />with confidence?</span
                    >
                </div>
                <h3 class="pricing-cta-heading">
                    If you're serious about understanding your retirement,
                    OnTarget™ Pro gives you the tools to explore everything that
                    matters - no guesswork.
                </h3>
                <a
                    href={`${import.meta.env.PUBLIC_APP_URL}/signup`}
                    class="btn-cta-white"
                    >Get Started <span class="arrow">→</span></a
                >
            </div>
        </div>
    </section>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Billing toggle functionality
            const toggleButtons = document.querySelectorAll(".toggle-pill");
            const priceBadges = document.querySelectorAll(".price-badge");

            function updatePricing(billing) {
                priceBadges.forEach((badge) => {
                    const priceEl = badge.querySelector(".price");
                    const periodEl = badge.querySelector(".period");
                    const isOnetime = badge.dataset.onetime === "true";
                    const monthlyNote = badge.dataset.monthlyNote;

                    const card = badge.closest(".pricing-card-v2");
                    const billingNoteEl = card?.querySelector(".billing-note");

                    const price =
                        billing === "monthly"
                            ? badge.dataset.monthly
                            : badge.dataset.yearly;

                    priceEl.textContent = "$" + price;

                    if (!isOnetime && periodEl) {
                        periodEl.textContent =
                            billing === "monthly" ? "/ mo" : "/ yr";
                    }

                    if (billingNoteEl) {
                        if (billing === "monthly" && monthlyNote) {
                            billingNoteEl.textContent = monthlyNote;
                            billingNoteEl.style.display = "block";
                        } else {
                            billingNoteEl.style.display = "none";
                        }
                    }
                });
            }

            toggleButtons.forEach((button) => {
                button.addEventListener("click", function () {
                    toggleButtons.forEach((btn) =>
                        btn.classList.remove("active"),
                    );
                    this.classList.add("active");
                    updatePricing(this.dataset.billing);
                });
            });

            // Initialize with yearly pricing
            updatePricing("yearly");
        });
    </script>

    <!-- SoftwareApplication Schema for SEO -->
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            "name": "ReadyAimRetire",
            "applicationCategory": "FinanceApplication",
            "operatingSystem": "Web",
            "description": "Retirement planning software with scenario modeling, tax optimization, and Monte Carlo simulations.",
            "offers": {
                "@type": "AggregateOffer",
                "priceCurrency": "USD",
                "lowPrice": "0",
                "highPrice": "1199",
                "offerCount": "4"
            },
            "aggregateRating": {
                "@type": "AggregateRating",
                "ratingValue": "4.8",
                "ratingCount": "150"
            }
        }
    </script>
</BaseLayout>
