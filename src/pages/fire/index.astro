---
import { getEntry } from "astro:content";
import CommonHero from "../../components/CommonHero.astro";
import CTABanner from "../../components/CTABanner.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroDescription from "../../components/HeroDescription.astro";
import DisplayCard from "../../components/DisplayCard.astro";
import AdvisorsCta from "../../components/AdvisorsCta.astro";
import InfoColumns from "../../components/InfoColumns.astro";
import FireCards from "./_component/FireCards.astro";
const pageData = await getEntry("firePage", "fire");
const descriptionData = await getEntry("heroDescription", "fire_description");
const displayData = await getEntry("displayCard", "fire_card");
const infoColumsData = await getEntry("infoColumn", "fire_columns");
---

<BaseLayout
    title="For Advisors – ReadyAimRetire"
    description="Built for Advisors who value clarity and client understanding. A modern planning tool that helps clients see their retirement - and trust the plan."
    solidHeader={true}
>
    <CommonHero title={pageData?.data.title!} />
    <HeroDescription description={descriptionData} />
    <section class="fire-display-card-section">
        <DisplayCard displayData={displayData?.data} />
    </section>
    <section class="fire-cards-section">
        <FireCards cards={pageData?.data.advisorsCards} />
    </section>
    <InfoColumns data={infoColumsData?.data} transparentBg={true} />
    <section class="fire-cta-section">
        <AdvisorsCta ctaData={pageData?.data.ctaInfo} />
    </section>

    <CTABanner />
</BaseLayout>

<style>
    .fire-display-card-section {
        margin-top: clamp(1.25rem, 0.3125rem + 4.6875vw, 5.9375rem);
        padding: 0;
    }
    .fire-cards-section {
        margin-top: clamp(1.25rem, 0.0625rem + 5.9375vw, 7.1875rem);
        padding: 0;
    }
    .fire-cta-section {
        /*margin-top: clamp(1.25rem, 0.375rem + 4.375vw, 5.625rem);*/
        margin-bottom: clamp(1.25rem, -0.225rem + 7.375vw, 8.625rem);
        padding: 0;
    }
</style>
