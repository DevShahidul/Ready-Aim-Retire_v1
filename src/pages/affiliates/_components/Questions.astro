---
import InfoCard from "../../../components/InfoCard.astro";
const { infoCards } = Astro.props;
type QuestionCard = {
    id: string;
    tag?: string;
    title: string;
    subtitle?: string;
    checkList: {
        title: string;
        items: string[];
    };
    bottomText?: string;
};
---

<section class="container questions">
    {infoCards?.data?.map((info: QuestionCard) => <InfoCard info={info} />)}
</section>

<style>
    .questions {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 4.875rem;
        margin-top: 4.3125rem;
        padding-bottom: 6.75rem;
    }

    @media (min-width: 769px) and (max-width: 1024px) {
        .questions {
            gap: 3rem;
            margin-top: 3.5rem;
            padding-bottom: 5rem;
        }
    }

    @media (min-width: 481px) and (max-width: 768px) {
        .questions {
            grid-template-columns: 1fr;
            gap: 2rem;
            margin-top: 2.5rem;
            padding-bottom: 4rem;
        }
    }

    @media (max-width: 480px) {
        .questions {
            grid-template-columns: 1fr;
            gap: 1.5rem;
            margin-top: 2rem;
            padding-bottom: 3rem;
        }
    }
</style>
