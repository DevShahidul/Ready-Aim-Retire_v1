---
const { whyCharge } = Astro.props;
---

<section class="why-charge-section">
    <div class="container">
        <div class="why-charge-inner">
            <img src={whyCharge.onTargetLogo} alt="" />
            <div class="why-charge-content">
                <h2 class="why-charge-title">
                    {whyCharge.title}
                </h2>

                <p class="why-charge-intro">{whyCharge.subtitle}</p>

                <p class="why-charge-description">{whyCharge.description}</p>

                <div class="pro-subscription">
                    <p class="pro-subscription-title">
                        {whyCharge.listTitle}
                    </p>

                    <ul class="pro-features-list">
                        {
                            whyCharge.benefits.map((item: string) => (
                                <li>{item}</li>
                            ))
                        }
                    </ul>
                </div>

                <div class="trust-statements">
                    {
                        whyCharge.trustIndicators.map((item: string) => (
                            <li>{item}</li>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .why-charge-section {
        padding: 7.6875rem 0;
    }
    .why-charge-inner {
        display: flex;
        justify-content: space-between;
        gap: 3rem;
        img {
            height: 5.625rem;
            margin-top: 4rem;
        }
    }

    .why-charge-content {
        background-color: #e8e8e8;
        padding: 4.375rem 3.75rem;
        border-radius: 8px;
        width: 63.4375rem;
        max-width: 100%;
        color: #2e2e2e;
    }

    .why-charge-title {
        font-size: 3rem;
        font-weight: 400;
        margin: 0 0 1.5rem 0;
        line-height: 1.3;
    }

    .why-charge-intro {
        font-size: 1.0625rem;
        margin: 0 0 1rem 0;
        line-height: 1.6;
    }

    .why-charge-description {
        font-size: 1.0625rem;
        margin: 0 0 2rem 0;
        line-height: 1.6;
        max-width: 42.5rem;
    }

    .pro-subscription {
        margin-bottom: 2.5rem;
    }

    .pro-subscription-title {
        font-size: 1.0625rem;
        font-weight: 500;
        color: #2c3e50;
        margin: 0 0 1rem 0;
    }

    .pro-features-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .pro-features-list li {
        font-size: 1.0625rem;
        margin-bottom: 0.5rem;
        padding-left: 1.5rem;
        position: relative;
        line-height: 1.6;
    }

    .pro-features-list li::before {
        content: url("/images/icons/feature-list-check.svg");
        position: absolute;
        left: 0;
        color: #5a6c7d;
        font-weight: 600;
    }

    .trust-statements {
        border-top: 1px solid #707070;
        padding-top: 1.8rem;
    }

    .trust-statements li {
        font-size: 1.5625rem;
        font-weight: 500;
        color: #0e3f4a;
        line-height: 1.1;
        list-style: none;
    }

    @media (max-width: 1024px) {
        .why-charge-inner {
            flex-direction: column;
            align-items: flex-start;
            gap: 2rem;
        }

        .why-charge-content {
            max-width: 100%;
        }
    }

    @media (min-width: 768px) and (max-width: 1024px) {
        .why-charge-section {
            padding: 3.5rem 0;
        }
        .why-charge-inner {
            gap: 1.75rem;
            img {
                height: 5rem;
            }
        }
        .why-charge-content {
            padding: 2.75rem 2.5rem;
        }
        .why-charge-title {
            font-size: 1.625rem;
            margin-bottom: 1.375rem;
        }
        .why-charge-intro,
        .why-charge-description {
            font-size: 0.9375rem;
        }
        .pro-subscription {
            margin-bottom: 2.25rem;
        }
        .pro-subscription-title {
            font-size: 0.9375rem;
            margin-bottom: 0.875rem;
        }
        .pro-features-list li {
            font-size: 0.875rem;
            padding-left: 1.375rem;
        }
        .trust-statements li {
            font-size: 0.9375rem;
        }
        .trust-statements {
            padding-top: 1.375rem;
        }
    }

    @media (max-width: 768px) {
        .why-charge-section {
            padding: 3rem 0;
        }

        .why-charge-content {
            padding: 2rem 1.5rem;
        }

        .why-charge-title {
            font-size: 1.5rem;
            margin-bottom: 1.25rem;
        }

        .why-charge-intro,
        .why-charge-description,
        .trust-statements p {
            font-size: 0.9375rem;
        }

        .pro-features-list li {
            font-size: 0.875rem;
        }

        .trust-statements {
            padding-top: 1.25rem;
        }
    }

    @media (max-width: 480px) {
        .why-charge-section {
            padding: 2rem 0.75rem;
        }

        .why-charge-inner {
            gap: 1.5rem;
        }

        .why-charge-content {
            padding: 1.5rem 1rem;
        }

        .why-charge-title {
            font-size: 1.25rem;
            margin-bottom: 1rem;
        }

        .why-charge-intro,
        .why-charge-description {
            font-size: 0.875rem;
            margin-bottom: 0.75rem;
        }

        .why-charge-description {
            margin-bottom: 1.5rem;
        }

        .pro-subscription {
            margin-bottom: 2rem;
        }

        .pro-subscription-title {
            font-size: 0.875rem;
            margin-bottom: 0.75rem;
        }

        .pro-features-list li {
            font-size: 0.8125rem;
            margin-bottom: 0.375rem;
            padding-left: 1.25rem;
        }

        .trust-statements li {
            font-size: 0.875rem;
            margin-bottom: 0.375rem;
        }

        .trust-statements {
            padding-top: 1rem;
        }
    }

    @media (max-width: 390px) {
        .why-charge-section {
            padding: 1.5rem 0.5rem;
        }

        .why-charge-inner {
            gap: 1rem;
            img {
                height: 4rem;
                margin-top: 0;
            }
        }

        .why-charge-content {
            padding: 1.25rem 0.75rem;
        }

        .why-charge-title {
            font-size: 1.125rem;
            margin-bottom: 0.75rem;
        }

        .why-charge-intro,
        .why-charge-description {
            font-size: 0.75rem;
            margin-bottom: 0.5rem;
        }

        .why-charge-description {
            margin-bottom: 1.25rem;
        }

        .pro-subscription {
            margin-bottom: 1.5rem;
        }

        .pro-subscription-title {
            font-size: 0.75rem;
            margin-bottom: 0.5rem;
        }

        .pro-features-list li {
            font-size: 0.6875rem;
            margin-bottom: 0.25rem;
            padding-left: 1rem;
        }

        .trust-statements li {
            font-size: 0.75rem;
            margin-bottom: 0.25rem;
        }

        .trust-statements {
            padding-top: 0.75rem;
        }
    }

    @media (max-width: 320px) {
        .why-charge-section {
            padding: 1rem 0.25rem;
        }

        .why-charge-inner {
            gap: 0.75rem;
            img {
                height: 3rem;
            }
        }

        .why-charge-content {
            padding: 1rem 0.5rem;
        }

        .why-charge-title {
            font-size: 1rem;
            margin-bottom: 0.5rem;
        }

        .why-charge-intro,
        .why-charge-description {
            font-size: 0.625rem;
            margin-bottom: 0.375rem;
        }

        .why-charge-description {
            margin-bottom: 1rem;
        }

        .pro-subscription {
            margin-bottom: 1rem;
        }

        .pro-subscription-title {
            font-size: 0.625rem;
            margin-bottom: 0.375rem;
        }

        .pro-features-list li {
            font-size: 0.5625rem;
            margin-bottom: 0.1875rem;
            padding-left: 0.75rem;
        }

        .trust-statements li {
            font-size: 0.625rem;
            margin-bottom: 0.1875rem;
        }

        .trust-statements {
            padding-top: 0.5rem;
        }
    }
</style>
