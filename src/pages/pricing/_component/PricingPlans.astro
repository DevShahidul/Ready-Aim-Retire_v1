---
import PricingCard from "./PricingCard.astro";
const { plansData } = Astro.props;
type Plan = {
    id: string;
    name: string;
    price: number;
    period: string;
    description: string;
    buttonText: string;
    popular: boolean;
    icon: string;
    features: [string];
    limitations: [string];
};
---

<section class="container">
    <div class="pricing-plan-description">
        <h4>
            {plansData.description}
        </h4>
        <div
            class="plan-toggler"
            data-savings={plansData.billing.annualSavings}
        >
            <button class="btn price-period">{plansData.billing.monthly}</button
            >
            <button class="btn btn-dark price-period"
                >{plansData.billing.annual}</button
            >
        </div>
    </div>
    <div class="pricing-card-container">
        {plansData.plans.map((plan: Plan) => <PricingCard plan={plan} />)}
    </div>
</section>

<style>
    .pricing-plan-description {
        display: flex;
        justify-content: space-between;
        align-items: center;
        h4 {
            max-width: 54.375rem;
            font-size: 1.25rem;
            font-weight: 300;
        }
        div {
            display: flex;
            gap: 1rem;

            .btn {
                font-size: 1.125rem;
                font-weight: 400;
            }
        }
    }
    .pricing-card-container {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 3.25rem;
        margin-top: 3.875rem;
    }

    @media (max-width: 1200px) {
        .pricing-card-container {
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
        }
    }

    @media (min-width: 768px) and (max-width: 1024px) {
        .pricing-plan-description {
            h4 {
                font-size: 1.125rem;
                max-width: 45rem;
            }
            div {
                gap: 0.875rem;
                .btn {
                    padding: 0.875rem 1.75rem;
                    font-size: 0.9375rem;
                }
            }
        }
        .pricing-card-container {
            grid-template-columns: repeat(3, 1fr);
            gap: 1.75rem;
            margin-top: 3rem;
        }
    }

    @media (max-width: 768px) {
        .pricing-plan-description {
            flex-direction: column;
            align-items: flex-start;
            gap: 2rem;
            h4 {
                max-width: 100%;
                font-size: 1.125rem;
            }
            div {
                width: 100%;
                justify-content: center;
            }
        }
        .pricing-card-container {
            grid-template-columns: repeat(2, 1fr);
            gap: 1.5rem;
            margin-top: 2.5rem;
        }
    }

    @media (max-width: 480px) {
        .pricing-plan-description {
            h4 {
                font-size: 1rem;
            }
            div {
                gap: 0.75rem;
                .btn {
                    padding: 0.75rem 1.5rem;
                    font-size: 0.875rem;
                }
            }
        }
        .pricing-card-container {
            grid-template-columns: 1fr;
            gap: 1.25rem;
            margin-top: 2rem;
        }
    }

    @media (max-width: 390px) {
        .pricing-plan-description {
            h4 {
                font-size: 0.875rem;
            }
            div {
                gap: 0.5rem;
                .btn {
                    padding: 0.625rem 1.25rem;
                    font-size: 0.75rem;
                }
            }
        }
        .pricing-card-container {
            gap: 1rem;
            margin-top: 1.5rem;
        }
    }

    @media (max-width: 320px) {
        .pricing-plan-description {
            h4 {
                font-size: 0.75rem;
            }
            div {
                gap: 0.375rem;
                .btn {
                    padding: 0.5rem 1rem;
                    font-size: 0.625rem;
                }
            }
        }
        .pricing-card-container {
            gap: 0.75rem;
            margin-top: 1rem;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const monthlyBtn = document.querySelector(
            ".price-period:not(.btn-dark)",
        );
        const annualBtn = document.querySelector(".price-period.btn-dark");
        const priceElements = document.querySelectorAll(".price-badge .price");
        const periodElements = document.querySelectorAll(
            ".price-badge .period",
        );
        const planToggler = document.querySelector(".plan-toggler");

        // Store original annual prices (current state)
        const originalPrices = Array.from(priceElements).map(
            (el) => el.textContent,
        );
        const originalPeriods = Array.from(periodElements).map(
            (el) => el.textContent,
        );

        const savings: number =
            Number(planToggler?.getAttribute("data-savings")) ?? 0;

        console.log(savings);

        // Calculate monthly prices (divide by 12)
        const monthlyPrices = originalPrices.map((price, index) => {
            const tier = priceElements[index]?.getAttribute("data-tire");
            const discountRate = savings / 100;
            const numPrice = parseFloat(price.replace("$", ""));
            const originalPrice = numPrice / (1 - discountRate);
            return tier === "pro"
                ? `$${(originalPrice / 12).toFixed(2)}`
                : `$${numPrice}`;
        });

        if (monthlyBtn && annualBtn) {
            monthlyBtn.addEventListener("click", () => {
                monthlyBtn.classList.add("btn-dark");
                annualBtn.classList.remove("btn-dark");

                priceElements.forEach((el, index) => {
                    el.textContent = monthlyPrices[index];
                });

                periodElements.forEach((el, index) => {
                    const tier =
                        priceElements[index]?.getAttribute("data-tire");
                    if (tier === "pro") {
                        el.textContent = "/mo";
                    }
                });
            });

            annualBtn.addEventListener("click", () => {
                annualBtn.classList.add("btn-dark");
                monthlyBtn.classList.remove("btn-dark");

                priceElements.forEach((el, index) => {
                    el.textContent = originalPrices[index];
                });

                periodElements.forEach((el, index) => {
                    el.textContent = originalPeriods[index];
                });
            });
        }
    });
</script>
