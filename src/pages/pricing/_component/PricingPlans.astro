---
import PricingCard from "./PricingCard.astro";
const { plansData } = Astro.props;
import type { Plan } from "../../../types/pricing_types";
---

<section class="container">
    <div class="pricing-plan-description">
        <h4>
            {plansData.description}
        </h4>
        <div>
            <button class="btn">{plansData.billing.monthly}</button>
            <button class="btn btn-dark">{plansData.billing.annual}</button>
        </div>
    </div>
    <div class="pricing-card-container">
        {plansData.plans.map((plan: Plan) => <PricingCard plan={plan} />)}
    </div>
</section>

<style>
    .pricing-plan-description {
        display: flex;
        justify-content: space-between;
        align-items: center;
        h4 {
            max-width: 54.375rem;
            font-size: 1.25rem;
            font-weight: 400;
        }
        div {
            display: flex;
            gap: 1rem;

            .btn {
                font-size: 1.125rem;
                font-weight: 500;
            }
        }
    }
    .pricing-card-container {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 3.25rem;
        margin-top: 3.875rem;
    }

    @media (max-width: 1200px) {
        .pricing-card-container {
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
        }
    }

    @media (min-width: 768px) and (max-width: 1024px) {
        .pricing-plan-description {
            h4 {
                font-size: 1.125rem;
                max-width: 45rem;
            }
            div {
                gap: 0.875rem;
                .btn {
                    padding: 0.875rem 1.75rem;
                    font-size: 0.9375rem;
                }
            }
        }
        .pricing-card-container {
            grid-template-columns: repeat(3, 1fr);
            gap: 1.75rem;
            margin-top: 3rem;
        }
    }

    @media (max-width: 768px) {
        .pricing-plan-description {
            flex-direction: column;
            align-items: flex-start;
            gap: 2rem;
            h4 {
                max-width: 100%;
                font-size: 1.125rem;
            }
            div {
                width: 100%;
                justify-content: center;
            }
        }
        .pricing-card-container {
            grid-template-columns: repeat(2, 1fr);
            gap: 1.5rem;
            margin-top: 2.5rem;
        }
    }

    @media (max-width: 480px) {
        .pricing-plan-description {
            h4 {
                font-size: 1rem;
            }
            div {
                gap: 0.75rem;
                .btn {
                    padding: 0.75rem 1.5rem;
                    font-size: 0.875rem;
                }
            }
        }
        .pricing-card-container {
            grid-template-columns: 1fr;
            gap: 1.25rem;
            margin-top: 2rem;
        }
    }

    @media (max-width: 390px) {
        .pricing-plan-description {
            h4 {
                font-size: 0.875rem;
            }
            div {
                gap: 0.5rem;
                .btn {
                    padding: 0.625rem 1.25rem;
                    font-size: 0.75rem;
                }
            }
        }
        .pricing-card-container {
            gap: 1rem;
            margin-top: 1.5rem;
        }
    }

    @media (max-width: 320px) {
        .pricing-plan-description {
            h4 {
                font-size: 0.75rem;
            }
            div {
                gap: 0.375rem;
                .btn {
                    padding: 0.5rem 1rem;
                    font-size: 0.625rem;
                }
            }
        }
        .pricing-card-container {
            gap: 0.75rem;
            margin-top: 1rem;
        }
    }
</style>

<script></script>
