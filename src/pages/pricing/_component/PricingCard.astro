---
const { plan } = Astro.props;
---

<div
    class={`pricing-card ${plan.buttonText == "Coming Soon" && "coming-soon"}`}
>
    <div class="price-badge">
        <span class="price" data-tire={plan.id}>${plan.price}</span>
        <span class="period">{plan.period}</span>
    </div>
    <div class="pricing-card-body">
        <div class="pricing-card-label" style="--height: 138px">
            <h3>{plan.name}</h3>
            <p>{plan.description}</p>
        </div>
        <button class="btn btn-outline-dark">{plan.buttonText}</button>
        <ul class="pricing-features">
            {
                plan.features.map((item: string) => (
                    <li>
                        <img src={"/images/icons/check-icon.png"} />
                        {item}
                    </li>
                ))
            }
        </ul>
        {
            plan.limitations && (
                <ul class="pricing-limitations">
                    <h4>Limitations</h4>
                    {plan.limitations.map((item: string) => (
                        <li>
                            <img src={"/images/icons/cross-icon.png"} />
                            {item}
                        </li>
                    ))}
                </ul>
            )
        }
    </div>
</div>

<style>
    .pricing-card {
        color: #2e2e2e;
        background-color: #fff;
        border-radius: 0.625rem;
        position: relative;
    }
    .pricing-card.coming-soon {
        color: #fff;
        background-color: #415776;
    }
    .price-badge {
        min-width: 50%;
        text-align: right;
        position: absolute;
        right: 0;
        top: 0;
        border-radius: 50px 0.625rem 0rem 50px;
        color: #fff;
        background-color: #41bab4;
        padding: 0.5rem 2rem;
        .price {
            font-size: 1.875rem;
            font-weight: 500;
        }
        .period {
            font-size: 1.25rem;
            font-weight: 300;
        }
    }

    .pricing-card-label {
        margin-top: 4.5rem;
        height: var(--height);
        h3 {
            font-size: 1.75rem;
            font-weight: 400;
        }
        p {
            font-size: 1.0625rem;
            margin-top: 0.75rem;
            max-width: 16rem;
        }
    }

    .pricing-card-body {
        /*padding: 3.125rem 1.875rem;*/
        padding: 2.5rem 1.875rem 3.125rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;

        .btn {
            font-size: 1.0625rem;
        }
    }

    .pricing-features,
    .pricing-limitations {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .pricing-features li,
    .pricing-limitations li {
        display: flex;
        font-size: 1.0625rem;
        align-items: start;
        gap: 0.75rem;
        img {
            display: block;
            margin-top: 0.375rem;
            height: 100%;
        }
    }

    .pricing-limitations {
        padding-top: 2rem;
        border-top: 1px solid #707070;
        h4 {
            font-size: 1.125rem;
            font-weight: 500;
            margin-bottom: 0.5rem;
        }
    }

    @media (min-width: 768px) and (max-width: 1024px) {
        .price-badge {
            font-size: 1.75rem;
            padding: 0.875rem 1.75rem;
            max-width: 10rem;
        }
        .pricing-card-label {
            margin-top: 4rem;
            h3 {
                font-size: 1.625rem;
            }
            p {
                font-size: 1rem;
            }
        }
        .pricing-card-body {
            padding: 2.25rem 1.625rem 2.875rem;
            gap: 1.875rem;
        }
        .pricing-features li,
        .pricing-limitations li {
            font-size: 0.875rem;
            img {
                width: 18px;
                height: 18px;
            }
        }
        .pricing-limitations {
            padding-top: 1.75rem;
        }
    }

    @media (max-width: 480px) {
        .price-badge {
            font-size: 1.5rem;
            padding: 0.75rem 1.5rem;
            max-width: 9rem;
        }
        .pricing-card-label {
            margin-top: 3.5rem;
            h3 {
                font-size: 1.5rem;
            }
            p {
                font-size: 0.9375rem;
            }
        }
        .pricing-card-body {
            padding: 2rem 1.5rem 2.5rem;
            gap: 1.5rem;
        }
        .pricing-features li,
        .pricing-limitations li {
            font-size: 0.875rem;
            gap: 0.375rem;
            img {
                width: 16px;
                height: 16px;
            }
        }
        .pricing-limitations {
            padding-top: 1.5rem;
        }
    }

    @media (max-width: 390px) {
        .price-badge {
            font-size: 1.25rem;
            padding: 0.625rem 1.25rem;
            max-width: 8rem;
        }
        .pricing-card-label {
            margin-top: 3rem;
            h3 {
                font-size: 1.25rem;
            }
            p {
                font-size: 0.8125rem;
            }
        }
        .pricing-card-body {
            padding: 1.5rem 1.25rem 2rem;
            gap: 1.25rem;
        }
        .pricing-features li,
        .pricing-limitations li {
            font-size: 0.75rem;
            gap: 0.25rem;
            img {
                width: 14px;
                height: 14px;
            }
        }
        .pricing-limitations {
            padding-top: 1.25rem;
        }
    }

    @media (max-width: 320px) {
        .price-badge {
            font-size: 1rem;
            padding: 0.5rem 1rem;
            max-width: 7rem;
        }
        .pricing-card-label {
            margin-top: 2.5rem;
            h3 {
                font-size: 1rem;
            }
            p {
                font-size: 0.75rem;
            }
        }
        .pricing-card-body {
            padding: 1.25rem 1rem 1.5rem;
            gap: 1rem;
        }
        .pricing-features li,
        .pricing-limitations li {
            font-size: 0.6875rem;
            gap: 0.1875rem;
            img {
                width: 12px;
                height: 12px;
            }
        }
        .pricing-limitations {
            padding-top: 1rem;
        }
    }
</style>

<script>
    import { syncHeight } from "../../../lib/utils";

    document.addEventListener("DOMContentLoaded", () =>
        syncHeight("pricing-card-label"),
    );

    window.addEventListener("resize", () => syncHeight("pricing-card-label"));
</script>
