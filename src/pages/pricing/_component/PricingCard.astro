---
const { plan } = Astro.props;
---

<div
    class={`pricing-card ${plan.buttonText == "Coming Soon" && "coming-soon"}`}
>
    <div class="price-badge">${plan.price}{plan.period}</div>
    <div class="pricing-card-body">
        <div class="pricing-card-label">
            <h3>{plan.name}</h3>
            <p>{plan.description}</p>
        </div>
        <button class="btn btn-outline-dark">{plan.buttonText}</button>
        <ul class="pricing-features">
            {
                plan.features.map((item: string) => (
                    <li>
                        <img src={"/images/icons/check-icon.png"} />
                        {item}
                    </li>
                ))
            }
        </ul>
        {
            plan.limitations && (
                <ul class="pricing-limitations">
                    {plan.limitations.map((item: string) => (
                        <li>
                            <img src={"/images/icons/cross-icon.png"} />
                            {item}
                        </li>
                    ))}
                </ul>
            )
        }
    </div>
</div>

<style>
    .pricing-card {
        background-color: #fff;
        border-radius: 0.625rem;
        position: relative;
    }
    .pricing-card.coming-soon {
        color: #fff;
        background-color: #415776;
    }
    .price-badge {
        font-size: 2rem;
        font-weight: 600;
        max-width: 11.25rem;
        position: absolute;
        right: 0;
        top: 0;
        border-radius: 50px 0.625rem 0rem 50px;
        color: #fff;
        background-color: #41bab4;
        padding: 1rem 2rem;
    }

    .pricing-card-label {
        margin-top: 4.5rem;
        h3 {
            font-size: 1.75rem;
            font-weight: 500rem;
        }
        p {
            font-size: 1.0625rem;
            margin-top: 0.75rem;
        }
    }

    .pricing-card-body {
        /*padding: 3.125rem 1.875rem;*/
        padding: 2.5rem 1.875rem 3.125rem;
        display: flex;
        flex-direction: column;
        gap: 2.1875rem;
    }

    .pricing-features,
    .pricing-limitations {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .pricing-features li,
    .pricing-limitations li {
        display: flex;
        align-items: start;
        gap: 0.5rem;
        img {
            display: block;
            margin-top: 0.2rem;
            height: 100%;
        }
    }

    .pricing-limitations {
        padding-top: 2rem;
        border-top: 1px solid #707070;
    }
</style>
