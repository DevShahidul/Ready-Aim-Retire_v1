---
const { faqs } = Astro.props;
---

<section class="faq-section container">
    <h2 class="faq-title">Frequently asked questions</h2>

    <div class="faq-list">
        {
            faqs.map((faq: { question: string; answer: string }) => (
                <div class="faq-item">
                    <h3 class="faq-question">{faq.question}</h3>
                    <p class="faq-answer">{faq.answer}</p>
                </div>
            ))
        }
    </div>
</section>

<style>
    .faq-section {
        padding: 4rem 0;
        border-top: 1px solid #707070;
    }

    .faq-title {
        font-size: 2rem;
        font-weight: 700;
        color: #2c3e50;
        margin: 0 0 2.5rem 0;
    }

    .faq-list {
        max-width: 800px;
    }

    .faq-item {
        margin-bottom: 2rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid #d0d0d0;
    }

    .faq-item:last-child {
        border-bottom: none;
        margin-bottom: 0;
        padding-bottom: 0;
    }

    .faq-question {
        font-size: 1.125rem;
        font-weight: 600;
        color: #2c3e50;
        margin: 0 0 0.75rem 0;
        line-height: 1.4;
    }

    .faq-answer {
        font-size: 0.9375rem;
        color: #5a6c7d;
        margin: 0;
        line-height: 1.6;
    }

    @media (min-width: 768px) and (max-width: 1024px) {
        .faq-section {
            padding: 3.5rem 1.5rem;
        }
        .faq-title {
            font-size: 1.875rem;
            margin-bottom: 2.25rem;
        }
        .faq-item {
            margin-bottom: 1.75rem;
            padding-bottom: 1.75rem;
        }
        .faq-question {
            font-size: 1.0625rem;
            margin-bottom: 0.625rem;
        }
        .faq-answer {
            font-size: 0.90625rem;
        }
    }

    @media (max-width: 768px) {
        .faq-section {
            padding: 3rem 1rem;
        }

        .faq-title {
            font-size: 1.75rem;
            margin-bottom: 2rem;
        }

        .faq-item {
            margin-bottom: 1.5rem;
            padding-bottom: 1.5rem;
        }

        .faq-question {
            font-size: 1rem;
        }

        .faq-answer {
            font-size: 0.875rem;
        }
    }

    @media (max-width: 480px) {
        .faq-section {
            padding: 2rem 1rem;
        }

        .faq-title {
            font-size: 1.5rem;
        }

        .faq-question {
            font-size: 0.9375rem;
        }
    }

    @media (max-width: 390px) {
        .faq-section {
            padding: 1.5rem 0.75rem;
        }

        .faq-title {
            font-size: 1.25rem;
            margin-bottom: 1.5rem;
        }

        .faq-item {
            margin-bottom: 1rem;
            padding-bottom: 1rem;
        }

        .faq-question {
            font-size: 0.8125rem;
            margin-bottom: 0.5rem;
        }

        .faq-answer {
            font-size: 0.75rem;
        }
    }

    @media (max-width: 320px) {
        .faq-section {
            padding: 1rem 0.5rem;
        }

        .faq-title {
            font-size: 1rem;
            margin-bottom: 1rem;
        }

        .faq-item {
            margin-bottom: 0.75rem;
            padding-bottom: 0.75rem;
        }

        .faq-question {
            font-size: 0.6875rem;
            margin-bottom: 0.375rem;
        }

        .faq-answer {
            font-size: 0.625rem;
        }
    }
</style>
