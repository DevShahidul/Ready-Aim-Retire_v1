---
const { faqs } = Astro.props;
---

<section class="faq-section container">
    <h2 class="faq-title">Frequently asked questions</h2>

    <div class="faq-list">
        {
            faqs.map((faq: { question: string; answer: string }) => (
                <div class="faq-item">
                    <h3 class="faq-question">{faq.question}</h3>
                    <p class="faq-answer">{faq.answer}</p>
                </div>
            ))
        }
    </div>
</section>

<style>
    .faq-section {
        padding: 5.875rem 0 8.5rem;
        border-top: 1px solid #707070;
    }

    .faq-title {
        font-size: 3rem;
        font-weight: 400;
        color: #2e2e2e;
        margin: 0 0 3.5625rem 0;
    }

    .faq-list {
        max-width: 59.375rem;
    }

    .faq-item {
        margin-bottom: 3rem;
    }

    .faq-item:last-child {
        border-bottom: none;
        margin-bottom: 0;
    }

    .faq-question {
        font-size: 1.5625rem;
        font-weight: 500;
        color: #2e2e2e;
        margin: 0 0 0.75rem 0;
        line-height: 1;
    }

    .faq-answer {
        font-size: 1.0625rem;
        color: #2e2e2e;
        margin: 0;
        line-height: 1.2;
    }

    @media (min-width: 768px) and (max-width: 1024px) {
        .faq-section {
            padding: 3.5rem 1.5rem;
        }
        .faq-title {
            font-size: 1.875rem;
            margin-bottom: 2.25rem;
        }
        .faq-item {
            margin-bottom: 1.75rem;
            padding-bottom: 1.75rem;
        }
        .faq-question {
            font-size: 1.0625rem;
            margin-bottom: 0.625rem;
        }
        .faq-answer {
            font-size: 0.90625rem;
        }
    }

    @media (max-width: 768px) {
        .faq-section {
            padding: 3rem 1rem;
        }

        .faq-title {
            font-size: 1.75rem;
            margin-bottom: 2rem;
        }

        .faq-item {
            margin-bottom: 1.5rem;
            padding-bottom: 1.5rem;
        }

        .faq-question {
            font-size: 1rem;
        }

        .faq-answer {
            font-size: 0.875rem;
        }
    }

    @media (max-width: 480px) {
        .faq-section {
            padding: 2rem 1rem;
        }

        .faq-title {
            font-size: 1.5rem;
        }

        .faq-question {
            font-size: 0.9375rem;
        }
    }

    @media (max-width: 390px) {
        .faq-section {
            padding: 1.5rem 0.75rem;
        }

        .faq-title {
            font-size: 1.25rem;
            margin-bottom: 1rem;
        }

        .faq-item {
            margin-bottom: 1rem;
            padding-bottom: 1rem;
        }

        .faq-question {
            font-size: 0.8125rem;
            margin-bottom: 0.5rem;
        }

        .faq-answer {
            font-size: 0.75rem;
        }
    }

    @media (max-width: 320px) {
        .faq-section {
            padding: 1rem 0.5rem;
        }

        .faq-title {
            font-size: 1rem;
            margin-bottom: 1rem;
        }

        .faq-item {
            margin-bottom: 0.75rem;
            padding-bottom: 0.75rem;
        }

        .faq-question {
            font-size: 0.6875rem;
            margin-bottom: 0.375rem;
        }

        .faq-answer {
            font-size: 0.625rem;
        }
    }
</style>
