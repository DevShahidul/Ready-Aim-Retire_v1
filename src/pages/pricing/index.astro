---
import CommonHero from "../../components/CommonHero.astro";
import CTABanner from "../../components/CTABanner.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PricingFaq from "./_component/PricingFaq.astro";
import PricingPlans from "./_component/PricingPlans.astro";
import WhyWeCharge from "./_component/WhyWeCharge.astro";
---

<BaseLayout
    title="Pricing – ReadyAimRetire"
    description="Choose the right ReadyAimRetire plan for your retirement planning needs. Free tier available, premium features for serious planners."
    solidHeader={true}
>
    <!-- Pricing Hero -->
    <CommonHero title={"Simple, transparent pricing"} />

    <!-- Pricing Plans -->
    <PricingPlans />

    <!-- Why We Charge Section -->
    <WhyWeCharge />

    <!-- FAQ Section -->
    <PricingFaq />

    <!-- Common Banner -->
    <!-- <CommonBanner /> -->

    <!-- CTA Banner -->
    <CTABanner />

    <!-- SoftwareApplication Schema for SEO -->
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            "name": "ReadyAimRetire",
            "applicationCategory": "FinanceApplication",
            "operatingSystem": "Web",
            "description": "Retirement planning software with scenario modeling, tax optimization, and Monte Carlo simulations.",
            "offers": {
                "@type": "AggregateOffer",
                "priceCurrency": "USD",
                "lowPrice": "0",
                "highPrice": "1199",
                "offerCount": "4"
            },
            "aggregateRating": {
                "@type": "AggregateRating",
                "ratingValue": "4.8",
                "ratingCount": "150"
            }
        }
    </script>
</BaseLayout>
