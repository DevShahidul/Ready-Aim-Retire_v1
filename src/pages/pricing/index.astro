---
import { getEntry } from "astro:content";
import CommonHero from "../../components/CommonHero.astro";
import CTABanner from "../../components/CTABanner.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PricingFaq from "./_component/PricingFaq.astro";
import PricingPlans from "./_component/PricingPlans.astro";
import WhyWeCharge from "./_component/WhyWeCharge.astro";

const { data } = await getEntry("pricingPage", "pricing");
console.log(data);
const plansData = {
    description: data.description,
    billing: data.billingToggle,
    plans: data.plans,
};
---

<BaseLayout
    title="Pricing – ReadyAimRetire"
    description="Choose the right ReadyAimRetire plan for your retirement planning needs. Free tier available, premium features for serious planners."
    solidHeader={true}
>
    <!-- Pricing Hero -->
    <CommonHero title={data.title} />

    <!-- Pricing Plans -->
    <PricingPlans plansData={plansData} />

    <!-- Why We Charge Section -->
    <WhyWeCharge whyCharge={data.whyWorthIt} />

    <!-- FAQ Section -->
    <PricingFaq faqs={data.faqs} />

    <!-- Common Banner -->
    <!-- <CommonBanner /> -->

    <!-- CTA Banner -->
    <CTABanner />

    <!-- SoftwareApplication Schema for SEO -->
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            "name": "ReadyAimRetire",
            "applicationCategory": "FinanceApplication",
            "operatingSystem": "Web",
            "description": "Retirement planning software with scenario modeling, tax optimization, and Monte Carlo simulations.",
            "offers": {
                "@type": "AggregateOffer",
                "priceCurrency": "USD",
                "lowPrice": "0",
                "highPrice": "1199",
                "offerCount": "4"
            },
            "aggregateRating": {
                "@type": "AggregateRating",
                "ratingValue": "4.8",
                "ratingCount": "150"
            }
        }
    </script>
</BaseLayout>
