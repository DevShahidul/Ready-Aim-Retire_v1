---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Page Not Found – ReadyAimRetire"
    description="The page you're looking for doesn't exist. Return to ReadyAimRetire's homepage."
    solidHeader={true}
>
    <section class="error-404">
        <div class="container">
            <div class="error-content">
                <!-- Large 404 Number -->
                <div class="error-number">404</div>

                <!-- Headline -->
                <h1 class="error-title">Page Not Found</h1>

                <!-- Retirement-themed message -->
                <p class="error-message">Looks like this page retired early!</p>

                <!-- Friendly explanation -->
                <p class="error-description">
                    The page you're looking for doesn't exist or may have been
                    moved. Don't worry though – we'll help you get back on
                    track.
                </p>

                <!-- Helpful navigation links -->
                <div class="helpful-links">
                    <h2 class="helpful-title">Here are some helpful links:</h2>
                    <div class="links-grid">
                        <a href="/" class="link-card">
                            <i class="fa-solid fa-home"></i>
                            <span>Home</span>
                        </a>
                        <a href="/pricing" class="link-card">
                            <i class="fa-solid fa-tag"></i>
                            <span>Pricing</span>
                        </a>
                        <a href="/faqs" class="link-card">
                            <i class="fa-solid fa-circle-question"></i>
                            <span>FAQs</span>
                        </a>
                        <a href="/contact" class="link-card">
                            <i class="fa-solid fa-envelope"></i>
                            <span>Contact</span>
                        </a>
                    </div>
                </div>

                <!-- Optional: Back to previous page button -->
                <button onclick="history.back()" class="btn-back">
                    <i class="fa-solid fa-arrow-left"></i>
                    Go Back
                </button>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    /* 404 Error Section */
    .error-404 {
        background: linear-gradient(135deg, #415776 0%, #2a3f5f 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8rem 0 4rem 0;
    }

    .error-content {
        text-align: center;
        max-width: 700px;
        margin: 0 auto;
    }

    /* Large 404 Number */
    .error-number {
        font-family: "Tobias", Georgia, serif;
        font-size: clamp(8rem, 20vw, 12rem);
        font-weight: 700;
        color: var(--color-primary);
        line-height: 1;
        margin-bottom: 1rem;
        text-shadow: 0 4px 20px rgba(65, 186, 180, 0.3);
        animation: fadeInScale 0.6s ease-out;
    }

    /* Headline */
    .error-title {
        font-family: "Tobias", Georgia, serif;
        font-size: clamp(2rem, 5vw, 2.75rem);
        font-weight: 600;
        color: #ffffff;
        margin: 0 0 1rem 0;
        line-height: 1.2;
        animation: fadeInUp 0.8s ease-out 0.2s both;
    }

    /* Retirement-themed message */
    .error-message {
        font-size: clamp(1.1rem, 3vw, 1.35rem);
        font-weight: 500;
        color: var(--color-primary);
        margin: 0 0 1.5rem 0;
        font-style: italic;
        animation: fadeInUp 0.8s ease-out 0.3s both;
    }

    /* Friendly explanation */
    .error-description {
        font-size: 1.05rem;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.85);
        margin: 0 0 3rem 0;
        animation: fadeInUp 0.8s ease-out 0.4s both;
    }

    /* Helpful Links Section */
    .helpful-links {
        margin-bottom: 2.5rem;
        animation: fadeInUp 0.8s ease-out 0.5s both;
    }

    .helpful-title {
        font-family: "Inter", sans-serif;
        font-size: 1.15rem;
        font-weight: 600;
        color: #ffffff;
        margin: 0 0 1.5rem 0;
    }

    .links-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 1rem;
        max-width: 600px;
        margin: 0 auto;
    }

    .link-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
        background: rgba(255, 255, 255, 0.1);
        border: 2px solid rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        padding: 1.5rem 1rem;
        color: #ffffff;
        text-decoration: none;
        transition: all 0.3s ease;
        backdrop-filter: blur(10px);
    }

    .link-card:hover {
        background: rgba(255, 255, 255, 0.15);
        border-color: var(--color-primary);
        transform: translateY(-4px);
        box-shadow: 0 8px 20px rgba(65, 186, 180, 0.2);
    }

    .link-card i {
        font-size: 1.75rem;
        color: var(--color-primary);
    }

    .link-card span {
        font-size: 0.95rem;
        font-weight: 500;
    }

    /* Back Button */
    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        background: rgba(255, 255, 255, 0.1);
        border: 2px solid rgba(255, 255, 255, 0.3);
        color: #ffffff;
        padding: 0.85rem 1.75rem;
        font-size: 1rem;
        font-weight: 500;
        border-radius: 50px;
        cursor: pointer;
        transition: all 0.3s ease;
        backdrop-filter: blur(10px);
        animation: fadeInUp 0.8s ease-out 0.6s both;
    }

    .btn-back:hover {
        background: rgba(255, 255, 255, 0.2);
        border-color: var(--color-primary);
        transform: translateY(-2px);
    }

    .btn-back i {
        transition: transform 0.3s ease;
    }

    .btn-back:hover i {
        transform: translateX(-3px);
    }

    /* Animations */
    @keyframes fadeInScale {
        0% {
            opacity: 0;
            transform: scale(0.8);
        }
        100% {
            opacity: 1;
            transform: scale(1);
        }
    }

    @keyframes fadeInUp {
        0% {
            opacity: 0;
            transform: translateY(20px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Responsive Design */
    @media (max-width: 768px) {
        .error-404 {
            padding: 6rem 0 3rem 0;
        }

        .error-number {
            font-size: 6rem;
        }

        .links-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 480px) {
        .error-number {
            font-size: 5rem;
        }

        .error-title {
            font-size: 1.75rem;
        }

        .error-message {
            font-size: 1.05rem;
        }

        .error-description {
            font-size: 0.95rem;
        }

        .link-card {
            padding: 1.25rem 0.75rem;
        }

        .link-card i {
            font-size: 1.5rem;
        }

        .link-card span {
            font-size: 0.875rem;
        }

        .btn-back {
            padding: 0.75rem 1.5rem;
            font-size: 0.9rem;
        }
    }
</style>
