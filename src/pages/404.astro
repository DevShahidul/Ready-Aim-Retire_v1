---
import CommonHero from "../components/CommonHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Page Not Found – ReadyAimRetire"
    description="The page you're looking for doesn't exist. Return to ReadyAimRetire's homepage."
    solidHeader={true}
>
    <CommonHero title="404 Page not found" />
    <div class="return-home container">
        <a href="/" class="btn btn-dark">
            <i class="fa-solid fa-home"></i>
            <span>Return Home</span>
        </a>
    </div>
</BaseLayout>

<style>
    .return-home {
        .btn-dark {
            margin: 3rem 0;
        }
    }
</style>
