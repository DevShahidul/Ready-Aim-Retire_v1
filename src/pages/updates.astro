---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTABanner from "../components/CTABanner.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
---

<BaseLayout
    title="Latest Updates – ReadyAimRetire"
    description="See what's new at ReadyAimRetire. Latest features, improvements, and updates to our retirement planning tools."
    solidHeader={true}
>
    <!-- Hero Section -->
    <section class="updates-hero">
        <div class="container" data-aos="fade-up">
            <Breadcrumbs items={[{ label: "Latest Updates" }]} />
            <h1>Latest Updates</h1>
            <p>See what's new with ReadyAimRetire and OnTarget™</p>
        </div>
    </section>

    <!-- Updates Timeline Section -->
    <section class="updates-section">
        <div class="container">
            <div class="updates-timeline">
                <!-- Update Item: Additional Charts -->
                <div class="update-item" data-aos="fade-up">
                    <div class="update-date">
                        <span class="month">Jan</span>
                        <span class="day">18</span>
                        <span class="year">2026</span>
                    </div>
                    <div class="update-content">
                        <div class="update-header">
                            <span class="badge badge-feature">Feature</span>
                            <span class="version">v2.8.0</span>
                        </div>
                        <h3>Additional Charts Dropdown</h3>
                        <p>
                            New dropdown menu provides instant access to
                            specialized visualizations including Portfolio
                            Returns vs Benchmark, Part-Time Income, Real Estate
                            Equity, and One-Time Benefits charts. Explore your
                            financial plan from multiple perspectives without
                            cluttering the main interface.
                        </p>
                        <ul class="update-details">
                            <li>4 new specialized chart types</li>
                            <li>Clean dropdown interface design</li>
                            <li>
                                Seamless integration with existing chart system
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Update Item: Retirement Age Comparison -->
                <div class="update-item" data-aos="fade-up">
                    <div class="update-date">
                        <span class="month">Jan</span>
                        <span class="day">12</span>
                        <span class="year">2026</span>
                    </div>
                    <div class="update-content">
                        <div class="update-header">
                            <span class="badge badge-feature">Feature</span>
                            <span class="version">v2.7.0</span>
                        </div>
                        <h3>Test Retirement Ages Tool</h3>
                        <p>
                            Compare multiple retirement ages side-by-side to
                            make informed decisions about when to retire. Visual
                            comparisons show projected portfolio values, total
                            spending, and withdrawal patterns across different
                            retirement age scenarios.
                        </p>
                        <ul class="update-details">
                            <li>
                                Compare up to 4 retirement ages simultaneously
                            </li>
                            <li>Interactive visual comparison charts</li>
                            <li>
                                Instantly see financial impact of retiring
                                earlier or later
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Update Item: Equity Returns Adjuster -->
                <div class="update-item" data-aos="fade-up">
                    <div class="update-date">
                        <span class="month">Dec</span>
                        <span class="day">28</span>
                        <span class="year">2025</span>
                    </div>
                    <div class="update-content">
                        <div class="update-header">
                            <span class="badge badge-feature">Feature</span>
                            <span class="version">v2.6.0</span>
                        </div>
                        <h3>Inline Equity Returns Adjuster</h3>
                        <p>
                            Adjust expected market returns directly on the
                            Portfolio Returns chart with our new inline
                            adjuster. Test different market scenarios instantly
                            with preset options (Conservative, Moderate,
                            Optimistic) or create custom return assumptions.
                        </p>
                        <ul class="update-details">
                            <li>
                                Inline chart interface for quick adjustments
                            </li>
                            <li>Preset return scenarios</li>
                            <li>Custom equity/bond return configuration</li>
                            <li>Real-time portfolio impact visualization</li>
                        </ul>
                    </div>
                </div>

                <!-- Update Item: Chart Tooltips -->
                <div class="update-item" data-aos="fade-up">
                    <div class="update-date">
                        <span class="month">Dec</span>
                        <span class="day">15</span>
                        <span class="year">2025</span>
                    </div>
                    <div class="update-content">
                        <div class="update-header">
                            <span class="badge badge-improvement"
                                >Improvement</span
                            >
                        </div>
                        <h3>Enhanced Chart Tooltips</h3>
                        <p>
                            Completely redesigned chart tooltips with improved
                            formatting, better data organization, and consistent
                            styling across all charts. Tooltips now provide
                            clearer, more actionable information when exploring
                            your financial projections.
                        </p>
                        <ul class="update-details">
                            <li>Unified tooltip builder component</li>
                            <li>Improved number formatting and readability</li>
                            <li>Better positioning and alignment</li>
                        </ul>
                    </div>
                </div>

                <!-- Update Item: Tax Calculator -->
                <div class="update-item" data-aos="fade-up">
                    <div class="update-date">
                        <span class="month">Nov</span>
                        <span class="day">30</span>
                        <span class="year">2025</span>
                    </div>
                    <div class="update-content">
                        <div class="update-header">
                            <span class="badge badge-improvement"
                                >Improvement</span
                            >
                        </div>
                        <h3>Tax Calculation Enhancements</h3>
                        <p>
                            Updated tax calculation engine with improved
                            accuracy for complex scenarios including capital
                            gains, RMDs, and Social Security taxation. New
                            detailed tax breakdown popup helps you understand
                            exactly where your tax liability comes from each
                            year.
                        </p>
                        <ul class="update-details">
                            <li>More accurate tax projections</li>
                            <li>Enhanced capital gains calculations</li>
                            <li>Detailed tax breakdown view</li>
                        </ul>
                    </div>
                </div>

                <!-- Update Item: Allocation Adjuster -->
                <div class="update-item" data-aos="fade-up">
                    <div class="update-date">
                        <span class="month">Nov</span>
                        <span class="day">18</span>
                        <span class="year">2025</span>
                    </div>
                    <div class="update-content">
                        <div class="update-header">
                            <span class="badge badge-feature">Feature</span>
                            <span class="version">v2.5.0</span>
                        </div>
                        <h3>Inline Allocation Adjuster</h3>
                        <p>
                            Adjust your portfolio allocation strategy directly
                            on charts with the new inline allocation adjuster.
                            Choose from preset glide paths or create custom
                            allocation strategies and see the impact on your
                            portfolio immediately.
                        </p>
                        <ul class="update-details">
                            <li>Quick-access allocation presets</li>
                            <li>Custom glide path configuration</li>
                            <li>Visual feedback on portfolio impact</li>
                        </ul>
                    </div>
                </div>

                <!-- Update Item: Performance -->
                <div class="update-item" data-aos="fade-up">
                    <div class="update-date">
                        <span class="month">Nov</span>
                        <span class="day">05</span>
                        <span class="year">2025</span>
                    </div>
                    <div class="update-content">
                        <div class="update-header">
                            <span class="badge badge-improvement"
                                >Improvement</span
                            >
                        </div>
                        <h3>Calculation Performance Boost</h3>
                        <p>
                            Implemented parallel calculation engine for
                            significantly faster scenario modeling. Complex
                            retirement plans now calculate up to 3x faster,
                            making real-time exploration even more responsive.
                        </p>
                        <ul class="update-details">
                            <li>Parallel processing architecture</li>
                            <li>Optimized rendering pipeline</li>
                            <li>Reduced memory usage</li>
                        </ul>
                    </div>
                </div>

                <!-- Update Item: Bug Fix -->
                <div class="update-item" data-aos="fade-up">
                    <div class="update-date">
                        <span class="month">Oct</span>
                        <span class="day">22</span>
                        <span class="year">2025</span>
                    </div>
                    <div class="update-content">
                        <div class="update-header">
                            <span class="badge badge-fix">Bug Fix</span>
                        </div>
                        <h3>Social Security Calculation Fix</h3>
                        <p>
                            Fixed edge case where Social Security benefits were
                            incorrectly calculated for couples with
                            significantly different earning histories. All
                            affected accounts have been automatically
                            recalculated.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Subscribe Section -->
    <section class="subscribe-section">
        <div class="container">
            <div class="subscribe-card" data-aos="fade-up">
                <div class="subscribe-icon">
                    <i class="fas fa-bell"></i>
                </div>
                <h2>Stay Updated</h2>
                <p>
                    Want to be notified about new features, improvements, and
                    updates? Follow us on social media or check back here
                    regularly.
                </p>
                <div class="subscribe-actions">
                    <a
                        href="https://twitter.com/readyaimretire"
                        class="btn-social"
                        target="_blank"
                        rel="noopener"
                    >
                        <i class="fab fa-twitter"></i>
                        Follow on Twitter
                    </a>
                    <a
                        href="https://linkedin.com/company/readyaimretire"
                        class="btn-social"
                        target="_blank"
                        rel="noopener"
                    >
                        <i class="fab fa-linkedin"></i>
                        Follow on LinkedIn
                    </a>
                </div>
            </div>
        </div>
    </section>

    <CTABanner />
</BaseLayout>
