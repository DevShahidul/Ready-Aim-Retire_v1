---
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CommonHero from "../../components/CommonHero.astro";
import HeroDescription from "../../components/HeroDescription.astro";
import DisplayCard from "../../components/DisplayCard.astro";
import CommitmentCta from "./_component/CommitmentCta.astro";
import CTABanner from "../../components/CTABanner.astro";
import CommitmentCards from "./_component/CommitmentCards.astro";

const decriptionCollection = await getEntry(
    "heroDescription",
    "our-commitment_description",
);

const displayData = await getEntry("displayCard", "our-commitment_card");
const pageData = await getEntry("ourCommitmentPage", "our-commitment");
---

<BaseLayout
    title=""
    description="Run your retirement plan through 153 years of market history. See your probability of success across 150+ simulations including every major crash since 1871."
    solidHeader={true}
>
    <CommonHero title="Our Commitment to Financial Literacy" isLarge={true} />
    <HeroDescription description={decriptionCollection} />
    <DisplayCard displayData={displayData?.data} />
    <CommitmentCards cards={pageData?.data.commitmentCards} />
    <CommitmentCta ctaData={pageData?.data.ctaInfo} />

    <CTABanner />
</BaseLayout>
