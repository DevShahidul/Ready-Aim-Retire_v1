---
import { getEntry, render } from "astro:content";
import CTABanner from "../../components/CTABanner.astro";
import Newsletter from "../../components/Newsletter.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "./_component/Sidebar.astro";
const pageData = await getEntry("blogDetailsPage", "blog-details");
const sidebarData = {
    socials: pageData.data.socials,
    relatedArticles: pageData.data.relatedArticles,
};
const { Content } = await render(pageData);
---

<BaseLayout title="Blog Details" solidHeader={true}>
    <section class="blog-details-heading container">
        <ul class="breadcrumb">
            <li>{pageData.data.breadcrumb.step1}</li>
            <li>{">"}</li>
            <li>{pageData.data.breadcrumb.step2}</li>
            <li>{">"}</li>
            <li class="current">{pageData.data.breadcrumb.step3}...</li>
        </ul>
        <h2>{pageData.data.title}</h2>
        <div class="time-stamp">
            <p>{pageData.data.time}</p>
            <p>{pageData.data.date}</p>
        </div>
    </section>

    <section class="blog-content-wrapper container">
        <div class="blog-content">
            <Content />
            <div class="blog-navigation">
                <a>
                    <i class="fa-solid fa-arrow-left"></i>
                    <span>Previous Article</span>
                </a>
                <a>
                    <span>Next Article</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
        <Sidebar sidebarData={sidebarData} />
    </section>
    <Newsletter />
    <CTABanner />
</BaseLayout>

<style>
    .blog-details-heading {
        margin-top: 15.125rem;
        color: #2e2e2e;
        h2 {
            font-size: 2.8125rem;
            line-height: 1;
            font-weight: 400;
            max-width: 36rem;
            margin-top: 4.6875rem;
        }
    }
    .breadcrumb {
        display: flex;
        gap: 1rem;
        align-items: center;
        font-size: 0.75rem;
        .current {
            color: #898d8e;
        }
    }
    .time-stamp {
        display: flex;
        gap: 2rem;
        align-items: center;
        font-size: 0.75rem;
        color: #898d8e;
        margin-top: 1.5rem;
    }
    .blog-content-wrapper {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: clamp(1rem, 0.7rem + 1.5vw, 2.5rem);
        margin-top: 2.1875rem;
        margin-bottom: clamp(1.875rem, 0.75rem + 5.625vw, 7.5rem);
    }
    .blog-content {
        grid-column: 1/9;
    }
    .blog-navigation {
        display: flex;
        align-items: center;
        gap: 2rem;
        justify-content: space-between;
        margin-top: 4.75rem;

        a {
            font-size: 1.0625rem;
            color: #41bab4;
            display: flex;
            align-items: center;
            gap: 0.8rem;

            span {
                text-decoration: underline;
                text-decoration-color: #d1d1d1;
                text-underline-offset: 5px;
            }
        }
    }

    @media (max-width: 1024px) {
        .blog-details-heading {
            margin-top: 10rem;
            
            h2 {
                font-size: 2.25rem;
                margin-top: 3rem;
            }
        }

        .blog-content-wrapper {
            grid-template-columns: 1fr;
            gap: 3rem;
        }

        .blog-content {
            grid-column: 1 / -1;
        }
    }

    @media (max-width: 768px) {
        .blog-details-heading {
            margin-top: 8rem;

            h2 {
                font-size: 1.75rem;
                margin-top: 2rem;
                max-width: 100%;
            }
        }

        .breadcrumb {
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .blog-navigation {
            flex-direction: column;
            gap: 1.5rem;
            align-items: flex-start;

            a {
                font-size: 0.9375rem;
            }
        }
    }

    @media (max-width: 480px) {
        .blog-details-heading {
            margin-top: 6rem;

            h2 {
                font-size: 1.5rem;
            }
        }

        .time-stamp {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }
    }
</style>
