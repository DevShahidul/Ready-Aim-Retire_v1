---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTABanner from "../components/CTABanner.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
---

<BaseLayout
    title="Gift Financial Literacy – ReadyAimRetire"
    description="Give the gift of financial literacy. Help others learn about retirement planning with ReadyAimRetire."
    solidHeader={true}
>
    <!-- Hero Section -->
    <section class="hero-section">
        <div class="container">
            <Breadcrumbs items={[{ label: "Gift Memberships" }]} />
            <h1 class="hero-title" data-aos="fade-up">
                Gift Financial Literacy
            </h1>
            <div class="hero-grid" data-aos="fade-up" data-aos-delay="100">
                <div class="hero-left">
                    <p class="hero-tagline hero-tagline-lg">
                        A meaningful gift that last a lifetime.
                    </p>
                </div>
                <div class="hero-right">
                    <p>
                        If you're looking for a thoughtful way to support
                        someone you care about, consider giving them something
                        more valuable than a gadget:
                    </p>
                    <p class="text-bold text-dark">
                        Clarity. Confidence. Control over their financial
                        future.
                    </p>
                    <p>
                        A OnTarget<sup>™</sup>
                        <strong>Pro Gift</strong> gives someone full access to powerful
                        retirement planning tools - so they can understand their path
                        and make informed decisions.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Two Cards Section -->
    <section class="section-gray section-no-top-padding">
        <div class="container">
            <div class="card-grid-2" data-aos="fade-up">
                <!-- What You're Giving Card -->
                <div class="card">
                    <h2 class="heading-h2">
                        <span class="text-teal">What</span> You're Giving
                    </h2>
                    <h3 class="heading-h3">
                        A full year of OnTarget<sup>™</sup> Pro
                    </h3>
                    <p class="card-subtitle card-subtitle-dark">
                        A gifted Pro account includes:
                    </p>
                    <ul class="checklist">
                        <li>
                            <img
                                src="/images/UI/checkmark.png"
                                alt=""
                                class="checklist-icon"
                            />
                            Unlimited retirement plans and scenarios
                        </li>
                        <li>
                            <img
                                src="/images/UI/checkmark.png"
                                alt=""
                                class="checklist-icon"
                            />
                            Historical stress testing
                        </li>
                        <li>
                            <img
                                src="/images/UI/checkmark.png"
                                alt=""
                                class="checklist-icon"
                            />
                            Advanced withdrawal strategy modeling
                        </li>
                        <li>
                            <img
                                src="/images/UI/checkmark.png"
                                alt=""
                                class="checklist-icon"
                            />
                            Tax-aware planning across all account types
                        </li>
                        <li>
                            <img
                                src="/images/UI/checkmark.png"
                                alt=""
                                class="checklist-icon"
                            />
                            Social Security planning tools
                        </li>
                        <li>
                            <img
                                src="/images/UI/checkmark.png"
                                alt=""
                                class="checklist-icon"
                            />
                            Detailed retirement budgeting
                        </li>
                        <li>
                            <img
                                src="/images/UI/checkmark.png"
                                alt=""
                                class="checklist-icon"
                            />
                            Ongoing updates and improvements
                        </li>
                    </ul>
                    <div class="card-divider"></div>
                    <p class="card-footer">
                        It's not advice - it's understanding.
                    </p>
                </div>

                <!-- A Pro gift is ideal for Card -->
                <div class="card">
                    <h2 class="heading-h2">
                        A Pro gift is <span class="text-teal">ideal</span> for:
                    </h2>
                    <h3 class="heading-h3">A Pro gift is ideal for:</h3>
                    <p class="card-subtitle card-subtitle-dark">
                        A gifted Pro account includes:
                    </p>
                    <ul class="checklist">
                        <li>
                            <img
                                src="/images/UI/checkmark.png"
                                alt=""
                                class="checklist-icon"
                            />
                            A spouse or partner planning together
                        </li>
                        <li>
                            <img
                                src="/images/UI/checkmark.png"
                                alt=""
                                class="checklist-icon"
                            />
                            Parents or grandparents nearing retirement
                        </li>
                        <li>
                            <img
                                src="/images/UI/checkmark.png"
                                alt=""
                                class="checklist-icon"
                            />
                            Adult children starting to think long-term
                        </li>
                        <li>
                            <img
                                src="/images/UI/checkmark.png"
                                alt=""
                                class="checklist-icon"
                            />
                            Friends pursuing FIRE
                        </li>
                        <li>
                            <img
                                src="/images/UI/checkmark.png"
                                alt=""
                                class="checklist-icon"
                            />
                            Anyone who wants to take control of their financial future
                        </li>
                    </ul>
                    <div class="card-divider"></div>
                    <p class="card-footer">
                        It's a gift that meets people where they are.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- How Gifting Works Section -->
    <section class="split-section">
        <div class="split-image">
            <img
                src="/images/landing/stock/yoga_couple.jpg"
                alt="Couple doing yoga together in a park"
            />
        </div>
        <div class="split-content">
            <div class="split-inner" data-aos="fade-left">
                <div class="split-label">
                    <div class="split-icon">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="18"
                            height="18"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </div>
                    <span>How Gifting Works</span>
                </div>
                <h2>Simple and flexible</h2>
                <div class="steps-list">
                    <div class="step">
                        <div class="step-number">1.</div>
                        <div class="step-content">
                            <h4>Purchase a Pro Gift</h4>
                            <p>Choose a one-year Pro gift subscription.</p>
                        </div>
                    </div>
                    <div class="step">
                        <div class="step-number">2.</div>
                        <div class="step-content">
                            <h4>Send it to someone you care about.</h4>
                            <p>
                                We'll email them an invitation to activate their
                                Pro access.
                            </p>
                        </div>
                    </div>
                    <div class="step">
                        <div class="step-number">3.</div>
                        <div class="step-content">
                            <h4>They activate when ready</h4>
                            <p>No credit card required from the recipient.</p>
                        </div>
                    </div>
                </div>
                <a
                    href={`${import.meta.env.PUBLIC_APP_URL}/gift`}
                    class="btn-outline-white"
                >
                    Gift a Pro Account
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <!-- Three Columns Section -->
    <section class="columns-section">
        <div class="container">
            <div class="columns-3" data-aos="fade-up">
                <!-- A Gift With Meaning -->
                <div class="column">
                    <h3>A Gift With Meaning</h3>
                    <p>
                        We believe financial literacy is one of the most
                        empowering gifts you can give.
                    </p>
                    <p>A OnTarget<sup>™</sup> Pro gift helps someone:</p>
                    <ul class="bullet-list">
                        <li>Reduce uncertainty</li>
                        <li>Make better long-term decisions</li>
                        <li>Feel more confident about the future</li>
                        <li>Engage thoughtfully with their finances</li>
                    </ul>
                    <p class="column-footer">
                        That impact lasts far longer than a traditional gift.
                    </p>
                </div>

                <!-- Aligns With Our Mission -->
                <div class="column">
                    <h3>Aligns With Our Mission</h3>
                    <p>
                        This isn't just a product feature - it's part of who we
                        are.
                    </p>
                    <p>Ready Aim Retire exists to:</p>
                    <ul class="bullet-list">
                        <li>Promote financial literacy</li>
                        <li>Encourage understanding over guesswork</li>
                        <li>
                            Give people tools that respect their intelligence
                        </li>
                    </ul>
                    <p class="column-footer">
                        Gifting Pro access is a natural extension of that
                        mission.
                    </p>
                </div>

                <!-- Gift Financial Literacy Today -->
                <div class="column">
                    <h3>Gift Financial Literacy Today</h3>
                    <p>Give someone clarity - not pressure.</p>
                    <p>Understanding - not advice.</p>
                    <a
                        href={`${import.meta.env.PUBLIC_APP_URL}/gift`}
                        class="btn-dark-sm mb-3"
                    >
                        Gift a Pro Account
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                    <p class="text-help">
                        If you have questions about gifting, bulk gifts, or
                        special circumstances, we're happy to help.
                    </p>
                    <p class="email-link">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path
                                d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                            ></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                        support@readyaimretire.com
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Banner -->
    <CTABanner />
</BaseLayout>
