---
const { mailingAddress, stayConnected } = Astro.props;
---

<section class="container address-info">
    <div class="mailing-info">
        <h3>{mailingAddress?.title}</h3>
        <address>{mailingAddress?.address}</address>
    </div>
    <div class="social-info">
        <h3>{stayConnected?.title}</h3>
        <p>{stayConnected?.description}</p>
        <ul>
            {
                stayConnected?.socialLinks.map(
                    (item: { platform: string; url: string }) => (
                        <li>
                            <a href={item.url}>{item.platform}</a>
                        </li>
                    ),
                )
            }
        </ul>
        <a href={stayConnected?.ctaButton.url} class="btn btn-dark"
            >{stayConnected?.ctaButton.text}
            <i class="fa-solid fa-arrow-right"></i>
        </a>
    </div>
</section>

<style>
    .address-info {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        margin: 4.9rem auto 8rem;
    }
    .mailing-info,
    .social-info {
        h3 {
            font-size: 1.5625rem;
            font-weight: 400;
            color: #2e2e2e;
        }
    }
    .mailing-info {
        address {
            max-width: 11rem;
            font-style: normal;
            color: #707070;
        }
    }

    .social-info {
        p,
        a {
            font-size: 1.0625rem;
            color: #707070;
        }
        p {
            max-width: 35.625rem;
        }
        .btn-dark {
            background-color: #3f3c68;
            color: #ffffff;
            margin-top: 1rem;
        }
        ul {
            margin-top: 1rem;
        }
    }

    @media (min-width: 769px) and (max-width: 1024px) {
        .address-info {
            margin: 3.5rem auto 6rem;
        }
    }

    @media (min-width: 481px) and (max-width: 768px) {
        .address-info {
            grid-template-columns: 1fr;
            gap: 2.5rem;
            margin: 2.5rem auto 4rem;
        }
        .mailing-info,
        .social-info {
            h3 {
                font-size: 1.375rem;
            }
        }
        .mailing-info {
            address {
                max-width: 100%;
                font-size: 1rem;
            }
        }
        .social-info {
            p {
                max-width: 100%;
                font-size: 1rem;
            }
            ul {
                margin-top: 0.75rem;
            }
        }
    }

    @media (max-width: 480px) {
        .address-info {
            grid-template-columns: 1fr;
            gap: 2rem;
            margin: 2rem auto 3rem;
        }
        .mailing-info,
        .social-info {
            h3 {
                font-size: 1.25rem;
            }
        }
        .mailing-info {
            address {
                max-width: 100%;
                font-size: 0.9375rem;
            }
        }
        .social-info {
            p,
            a {
                font-size: 0.9375rem;
            }
            p {
                max-width: 100%;
            }
            ul {
                margin-top: 0.75rem;
            }
            .btn-dark {
                margin-top: 0.75rem;
            }
        }
    }
</style>
