---
import { getEntry } from "astro:content";
import CommonHero from "../../components/CommonHero.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroDivider from "../../components/HeroDivider.astro";
import HeroDescription from "../../components/HeroDescription.astro";
import ContactOptions from "./_component/ContactOptions.astro";

const contactCollection = await getEntry("contactPage", "contact");
const data = contactCollection?.data;

const decriptionCollection = await getEntry(
    "heroDescription",
    "contact_description",
);
console.log(data);
---

<BaseLayout
    title="Contact Us – ReadyAimRetire"
    description="Get in touch with the ReadyAimRetire team. We're here to help with your retirement planning questions."
    solidHeader={true}
>
    <CommonHero title={data?.hero.title} />
    <HeroDivider text="We’re here to help" />
    <HeroDescription description={decriptionCollection} />
    <ContactOptions options={data?.contactOptions} />
</BaseLayout>
